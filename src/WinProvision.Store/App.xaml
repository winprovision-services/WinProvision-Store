   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /><ResourceDictionary Source="Styles/Shell.xaml"/><ResourceDictionary Source="Styles/Storefront.xaml"/><ResourceDictionary Source="Styles/OperationsQueue.xaml"/><ResourceDictionary Source="Styles/AppDetails.xaml"/><ResourceDictionary Source="Styles/Updates.xaml"/><ResourceDictionary Source="Styles/InstalledPackages.xaml"/><ResourceDictionary Source="Styles/Office.xaml"/></ResourceDictionary.MergedDictionaries>
