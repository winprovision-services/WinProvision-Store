<Window x:Class="WinProvision.Store.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:WinProvision.Store.Controls" xmlns:vm="using:WinProvision.Store.ViewModels" xmlns:services="using:WinProvision.Store.Services" xmlns:ic="using:FluentIcons.WinUI" x:DataType="vm:OperationsViewModel" Title="WinProvision Store">
 <Grid x:Name="Root" Background="Transparent" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged" KeyDown="Root_KeyDown">
  <Grid x:Name="MainContentLayer" Background="Transparent">
   <Grid.Resources>
  <DataTemplate x:Key="ToastMessageTemplate" x:DataType="services:ToastMessageItem">
   <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="0" PointerEntered="Toast_PointerEntered" PointerExited="Toast_PointerExited">
    <Border.Shadow><ThemeShadow/></Border.Shadow>
    <Grid ColumnSpacing="0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="{Binding AccentBrush}"/>
     <FontIcon Grid.Column="1" Glyph="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding AccentBrush}" FontSize="16" Width="20" Height="20" Margin="12,12,6,0" VerticalAlignment="Top"/>
     <StackPanel Grid.Column="2" Spacing="2" Margin="4,10,4,10" VerticalAlignment="Center">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Message}" FontSize="12" Opacity="0.88" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding PendingSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
     </StackPanel>
     <Button Grid.Column="3" Tag="{Binding}" Click="ToastDismiss_Click" AutomationProperties.Name="Fechar notificação" VerticalAlignment="Top" Margin="2,4,4,0" Padding="6" Background="Transparent" BorderThickness="0" CornerRadius="4">
      <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
     </Button>
    </Grid>
   </Border>
  </DataTemplate>
   </Grid.Resources>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="WinProvision Store" Height="48" Background="Transparent"
             IsPaneToggleButtonVisible="True" PaneToggleRequested="AppTitleBar_PaneToggleRequested">
    <TitleBar.Resources>
     <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
     <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
     </Style>
    </TitleBar.Resources>
    <TitleBar.Content>
     <Grid x:Name="TitleBarSearchContent" HorizontalAlignment="Stretch" SizeChanged="TitleBarSearchContent_SizeChanged">
      <ContentControl x:Name="TitleBarSearchHost" HorizontalAlignment="Center">
       <Grid x:Name="TitleBarSearchVisual" Width="480" Height="36" HorizontalAlignment="Center">
        <AutoSuggestBox x:Name="TitleBarSearchBox" Width="480" Style="{StaticResource ShellTitleBarSearchBoxStyle}"
                        PlaceholderText="Pesquisar nome ou ID" TextChanged="TitleBarSearchBox_TextChanged"
                        QuerySubmitted="TitleBarSearchBox_QuerySubmitted" KeyDown="TitleBarSearchBox_KeyDown"
                        SizeChanged="TitleBarSearchBox_SizeChanged" AutomationProperties.Name="Pesquisar nome ou ID"
                        KeyboardAcceleratorPlacementMode="Hidden"/>
       </Grid>
      </ContentControl>
      <Button x:Name="CompactTitleBarSearchButton" HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="Collapsed" AutomationProperties.Name="Abrir pesquisa" KeyboardAcceleratorPlacementMode="Hidden">
       <ic:FluentIcon Icon="Search" IconVariant="Regular" IconSize="Size20"/>
       <Button.Flyout>
        <Flyout x:Name="CompactTitleBarSearchFlyout" Placement="Bottom"
                Opened="CompactTitleBarSearchFlyout_Opened" Closed="CompactTitleBarSearchFlyout_Closed">
         <Border Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <ContentControl x:Name="CompactTitleBarSearchHost" Width="360"/>
         </Border>
        </Flyout>
       </Button.Flyout>
      </Button>
     </Grid>
    </TitleBar.Content>
   </TitleBar>
   <NavigationView x:Name="RootNavigation" AutomationProperties.Name="Navegação principal" AutomationProperties.AutomationId="RootNavigation" Grid.Row="1" PaneDisplayMode="Left" IsPaneOpen="True" CompactPaneLength="64" IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" SelectionChanged="Navigation_SelectionChanged">
    <NavigationView.Resources>
     <ResourceDictionary>
      <StaticResource x:Key="NavigationViewItemOnLeftIconBoxHeight" ResourceKey="ShellIconSize"/>
      <x:Double x:Key="NavigationViewItemOnLeftIconBoxWidth">48</x:Double>
      <Flyout x:Key="MoreFlyoutResource" x:Name="MoreFlyout" Placement="Right" Closed="MoreFlyout_Closed">
       <Border x:Name="MoreFlyoutSurface" Padding="4" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" MaxWidth="420" MaxHeight="640">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
         <StackPanel x:Name="MoreFlyoutItems" MinWidth="180" MaxWidth="408" KeyDown="MoreFlyoutItems_KeyDown"/>
        </ScrollViewer>
       </Border>
      </Flyout>
     </ResourceDictionary>
    </NavigationView.Resources>
    <Grid x:Name="ContentRoot" Background="Transparent">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ContentControl controls:FluentMotion.Kind="Content" x:Name="PageHost" Grid.Row="0" Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     <Border x:Name="OperationsSplitter" Grid.Row="1" Height="12" Background="Transparent" Visibility="Collapsed"
             PointerEntered="OperationsSplitter_PointerEntered" PointerExited="OperationsSplitter_PointerExited"
             PointerPressed="OperationsSplitter_PointerPressed" PointerMoved="OperationsSplitter_PointerMoved" PointerReleased="OperationsSplitter_PointerReleased"
             AutomationProperties.Name="Redimensionar painel de operações"/>
     <controls:OperationsQueuePanel controls:FluentMotion.Kind="Panel" x:Name="QueuePanel" Grid.Row="2" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
    </Grid>
    <NavigationView.FooterMenuItems>
     <NavigationViewItem x:Name="MoreFlyoutNavigationItem" Content="Mais" AutomationProperties.Name="Mais" AutomationProperties.AutomationId="MoreFlyoutNavigationItem" Tapped="MoreFlyoutNavigationItem_Tapped" KeyDown="MoreFlyoutNavigationItem_KeyDown">
      <NavigationViewItem.Icon><ic:FluentIcon Icon="MoreHorizontal" IconVariant="Regular" IconSize="Size20"/></NavigationViewItem.Icon>
     </NavigationViewItem>
    </NavigationView.FooterMenuItems>
   </NavigationView>
   <ContentControl x:Name="RootContentDialog" Grid.RowSpan="2" Canvas.ZIndex="30" IsHitTestVisible="False"/>
   <ContentControl x:Name="DetailsOverlayHost" Grid.RowSpan="2" Canvas.ZIndex="40" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   <ItemsControl x:Name="ToastHost" Grid.Row="2" Width="420" MaxWidth="420" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,8,20,8" Canvas.ZIndex="50" ItemTemplate="{StaticResource ToastMessageTemplate}" IsTabStop="False" AutomationProperties.LiveSetting="Polite">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   </ItemsControl>
  </Grid>
  <Grid x:Name="StartupSplashOverlay" Canvas.ZIndex="1000" Visibility="Collapsed">
   <Border Background="#D90A1024" CornerRadius="8"><Viewbox Stretch="Uniform" IsHitTestVisible="False"><Canvas Width="960" Height="540">
    <Ellipse Width="660" Height="490" Canvas.Left="150" Canvas.Top="15" Opacity="0.82"><Ellipse.Fill><controls:RadialGradientBrush><GradientStop Color="#783C7BFF" Offset="0"/><GradientStop Color="#38315AE8" Offset="0.42"/><GradientStop Color="#00315AE8" Offset="1"/></controls:RadialGradientBrush></Ellipse.Fill></Ellipse>
    <Ellipse Width="560" Height="420" Canvas.Left="345" Canvas.Top="85" Opacity="0.72"><Ellipse.Fill><controls:RadialGradientBrush><GradientStop Color="#604F36FF" Offset="0"/><GradientStop Color="#302D38D8" Offset="0.46"/><GradientStop Color="#002D38D8" Offset="1"/></controls:RadialGradientBrush></Ellipse.Fill></Ellipse>
    <Ellipse Width="245" Height="190" Canvas.Left="357" Canvas.Top="105" Opacity="0.72"><Ellipse.Fill><controls:RadialGradientBrush><GradientStop Color="#A81ACBFF" Offset="0"/><GradientStop Color="#4C087BFF" Offset="0.4"/><GradientStop Color="#00087BFF" Offset="1"/></controls:RadialGradientBrush></Ellipse.Fill></Ellipse>
    <Image x:Name="StartupSplashIcon" Source="{StaticResource AppIconImage}" Width="160" Height="170" Canvas.Left="400" Canvas.Top="128" Stretch="Uniform"/>
    <TextBlock Text="WinProvision" Width="960" Canvas.Top="288" Foreground="White" FontFamily="{StaticResource StoreDisplayFontFamily}" FontSize="32" FontWeight="SemiBold" TextAlignment="Center"/>
    <ProgressRing IsActive="True" Width="40" Height="40" Canvas.Left="460" Canvas.Top="342" Foreground="#FF00A2ED"/>
    <TextBlock Text="Carregando o catálogo..." Width="960" Canvas.Top="394" Foreground="#FFD3D9F2" FontFamily="{StaticResource StoreFontFamily}" FontSize="13" TextAlignment="Center"/>
   </Canvas></Viewbox></Border>
  </Grid>
 </Grid>
</Window>
