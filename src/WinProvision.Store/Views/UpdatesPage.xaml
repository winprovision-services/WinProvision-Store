                        </ToggleButton>
                        <ToggleButton x:Name="ViewModeIconsRadio" AutomationProperties.AutomationId="ViewModeIconsRadio" Style="{StaticResource UpdatesViewModeToggleStyle}" Click="ViewModeIcons_Click" ToolTipService.ToolTip="Modo Ícones" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="{StaticResource UpdatesViewModeCornerRadius}">
                            <ic:FluentIcon Icon="Apps" IconVariant="Color" IconSize="Size16" />
                            
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="IgnoredUpdatesOverlay" Grid.Row="0" Grid.RowSpan="4" Background="{ThemeResource StoreBrush_99000000}" Visibility="Collapsed" Tapped="DismissModalOverlay_Click" TabFocusNavigation="Cycle">
            <Border Width="560" MaxHeight="{Binding ActualHeight, ElementName=UpdatesRoot}" Background="{ThemeResource DetailsBackgroundBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource StoreCardCornerRadius}" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="ModalCard_Click" MaxWidth="{Binding ActualWidth, ElementName=UpdatesRoot}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Gerenciar atualizações ignoradas" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Versões que você marcou para não atualizar:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Width="36" Height="36" Padding="0" HorizontalAlignment="Right" Click="CloseIgnoredOverlay_Click" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="Fechar diálogo">
                            <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size16" FontSize="16" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="IgnoredUpdatesEmptyModalText" Visibility="{Binding HasIgnored, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" Text="Nenhuma versão ignorada registrada." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,16,0,16" HorizontalAlignment="Center" />
                            <ItemsControl x:Name="IgnoredUpdatesModalList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AppId}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Text="{Binding Version, Converter={StaticResource FormatConverter}, ConverterParameter='Versão {0}'}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" FontSize="11" Padding="8,4" Click="RestoreIgnoredUpdate_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ic:FluentIcon Icon="ArrowUndo" IconVariant="Regular" IconSize="Size16" FontSize="16" Margin="0,0,6,0" />
                                                        <TextBlock Text="Restaurar" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Margin="0,0,8,0" Click="RestoreAllIgnored_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ic:FluentIcon Icon="ArrowUndo" IconVariant="Regular" IconSize="Size16" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="Restaurar todas" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="Fechar" Click="CloseIgnoredOverlay_Click" Background="{ThemeResource AccentFillColorDefaultBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="ManualUpdateOverlay" Grid.Row="0" Grid.RowSpan="4" Background="{ThemeResource StoreBrush_99000000}" Visibility="Collapsed" Tapped="DismissModalOverlay_Click" TabFocusNavigation="Cycle">
            <Border Width="480" Background="{ThemeResource DetailsBackgroundBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource StoreCardCornerRadius}" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="ModalCard_Click" MaxHeight="{Binding ActualHeight, ElementName=UpdatesRoot}" MaxWidth="{Binding ActualWidth, ElementName=UpdatesRoot}">
                <StackPanel>
                    <TextBlock Text="Atualização manual" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="Informe o ID do pacote ou parâmetros do WinGet para atualizar manualmente:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap" />
                    <TextBox x:Name="ManualPackageIdBox" AutomationProperties.AutomationId="ManualPackageIdBox" PlaceholderText="Ex: Microsoft.VisualStudioCode" Height="36" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Margin="0,0,8,0" Click="CloseManualOverlay_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        <Button Content="Executar atualização" Click="ExecuteManualUpdate_Click" Background="{ThemeResource AccentFillColorDefaultBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="OptionsOverlay" Grid.Row="0" Grid.RowSpan="4" Background="{ThemeResource StoreBrush_99000000}" Visibility="Collapsed" Tapped="DismissModalOverlay_Click" TabFocusNavigation="Cycle">
            <Border Width="500" Background="{ThemeResource DetailsBackgroundBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource StoreCardCornerRadius}" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="ModalCard_Click" MaxHeight="{Binding ActualHeight, ElementName=UpdatesRoot}" MaxWidth="{Binding ActualWidth, ElementName=UpdatesRoot}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Opções de atualização" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Atualizações automáticas" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Executa a política e a agenda abaixo sem abrir a interface." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoUpdateSwitch" AutomationProperties.AutomationId="AutoUpdateSwitch" IsEnabled="{Binding CanToggleAutoUpdate}" Grid.Column="1" VerticalAlignment="Center" IsOn="{Binding AutoUpdateEnabled, Mode=OneWay}" Toggled="AutoUpdateSwitch_Toggled" OnContent="" OffContent="" MinWidth="40">
                                    
                                </ToggleSwitch>
                            </Grid>
                        </Border>
                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Agenda" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                                <ComboBox x:Name="UpdateScheduleComboBox" AutomationProperties.AutomationId="UpdateScheduleComboBox" Height="32" SelectedValuePath="Tag" SelectionChanged="UpdateScheduleComboBox_SelectionChanged" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Ao entrar no Windows" Tag="AtLogon" />
                                    <ComboBoxItem Content="Em um intervalo fixo (Configurações)" Tag="Interval" />
                                    <ComboBoxItem Content="Diariamente" Tag="Daily" />
                                    <ComboBoxItem Content="Semanalmente" Tag="Weekly" />
                                </ComboBox>
                                <TextBlock x:Name="UpdateScheduleIntervalText" Text="Intervalo definido em Configurações → Manutenção agendada." Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <controls:WrapPanel x:Name="UpdateScheduleDetailsPanel" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBox x:Name="UpdateScheduleTimeBox" AutomationProperties.AutomationId="UpdateScheduleTimeBox" Width="96" Height="32" PlaceholderText="HH:mm" ToolTipService.ToolTip="Horário local, formato 24 horas" />
                                    <ComboBox x:Name="UpdateScheduleDayComboBox" AutomationProperties.AutomationId="UpdateScheduleDayComboBox" Width="150" Height="32" Margin="8,0,0,0" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="Domingo" Tag="Sunday" />
                                        <ComboBoxItem Content="Segunda-feira" Tag="Monday" />
                                        <ComboBoxItem Content="Terça-feira" Tag="Tuesday" />
                                        <ComboBoxItem Content="Quarta-feira" Tag="Wednesday" />
                                        <ComboBoxItem Content="Quinta-feira" Tag="Thursday" />
                                        <ComboBoxItem Content="Sexta-feira" Tag="Friday" />
                                        <ComboBoxItem Content="Sábado" Tag="Saturday" />
                                    </ComboBox>
                                </controls:WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Ação e aplicativos" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                                <ComboBox x:Name="UpdateAutomationModeComboBox" AutomationProperties.AutomationId="UpdateAutomationModeComboBox" Height="32" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Instalar atualizações automaticamente" Tag="InstallAutomatically" />
                                    <ComboBoxItem Content="Verificar e apenas avisar" Tag="NotifyOnly" />
                                </ComboBox>
                                <ComboBox x:Name="UpdateAutomationScopeComboBox" AutomationProperties.AutomationId="UpdateAutomationScopeComboBox" Height="32" Margin="0,8,0,0" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Todos os apps compatíveis" Tag="AllSupportedPackages" />
                                    <ComboBoxItem Content="Somente apps selecionados" Tag="SelectedPackagesOnly" />
                                </ComboBox>
                                <TextBlock x:Name="AutoUpdatePackageSelectionText" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Marcar todos por padrão" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Seleciona todas as atualizações encontradas automaticamente" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="SelectAllByDefaultSwitch" AutomationProperties.AutomationId="SelectAllByDefaultSwitch" Grid.Column="1" VerticalAlignment="Center" IsOn="True" Toggled="SelectAllByDefaultSwitch_Toggled" OnContent="" OffContent="" MinWidth="40">
                                    
                                </ToggleSwitch>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Fechar" Margin="0,0,8,0" Click="CloseOptionsOverlay_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            <Button Content="Aplicar" Click="ApplyAutomationOptions_Click" Background="{ThemeResource AccentFillColorDefaultBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
