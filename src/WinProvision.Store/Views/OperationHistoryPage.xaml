<Page x:Class="WinProvision.Store.Views.OperationHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:WinProvision.Store.ViewModels"
      xmlns:ic="using:FluentIcons.WinUI"
      xmlns:services="using:WinProvision.Store.Services"
      xmlns:controls="using:WinProvision.Store.Controls"
      Background="Transparent" FontFamily="{StaticResource StoreFontFamily}"
      Loaded="Page_Loaded">
  <Page.Resources>
    <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <Style x:Key="HistoryItemContainerStyle" TargetType="ListViewItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="HistoryFlatIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
      <Setter Property="MinWidth" Value="30"/><Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
  </Page.Resources>
  <Grid RowDefinitions="*" Padding="24,0,24,16">
    <TabView x:Name="HistoryTabs" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" SelectionChanged="HistoryTabs_SelectionChanged">
      <TabViewItem IsClosable="False">
        <TabViewItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
            <TextBlock Text="Histórico" VerticalAlignment="Center"/>
          </StackPanel>
        </TabViewItem.Header>
        <Grid RowSpacing="8" Padding="0,10,0,0">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <ListView x:Name="HistoryList" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" ItemContainerStyle="{StaticResource HistoryItemContainerStyle}" SelectionMode="None" IsItemClickEnabled="False" Background="{ThemeResource LayerFillColorDefaultBrush}" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListView.Header>
                <Grid Width="{Binding ActualWidth, ElementName=HistoryList}" Padding="8,7" ColumnSpacing="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="88"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Operação"/><TextBlock Grid.Column="1" Text="Pacote" Margin="4,0"/><TextBlock Grid.Column="2" Text="Versão" Margin="4,0"/><TextBlock Grid.Column="3" Text="Origem" Margin="4,0"/><TextBlock Grid.Column="4" Text="Status"/><TextBlock Grid.Column="5" Text="Data" Margin="4,0"/><TextBlock Grid.Column="6" Text="Ações"/>
                </Grid>
              </ListView.Header>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:OperationHistoryRowViewModel">
                  <Grid Height="40" Padding="8,0" ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="88"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center" ColumnDefinitions="20,*" ColumnSpacing="6"><FontIcon Glyph="{x:Bind TypeGlyph, Mode=OneWay}" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{x:Bind TypeLabel, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Left"/></Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0" Margin="4,0">
                      <TextBlock Text="{x:Bind PackageNameLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind PackageNameTooltip, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{x:Bind PackageIdLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind PackageIdTooltip, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasPackageId, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind VersionLabel, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind VersionLabel, Mode=OneWay}" Margin="4,0"/>
                    <TextBlock Grid.Column="3" Text="{x:Bind SourceLabel, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind SourceLabel, Mode=OneWay}" Margin="4,0"/>
                    <Border Grid.Column="4" CornerRadius="10" Padding="8,2" MinWidth="112" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Bind StatusBackground, Mode=OneWay}">
                      <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{x:Bind StatusForeground, Mode=OneWay}" Visibility="{x:Bind HasStatusGlyph, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" Foreground="{x:Bind StatusForeground, Mode=OneWay}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="5" Text="{x:Bind TimestampLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind TimestampTooltip, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0"/>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="0">
                      <Button Style="{StaticResource HistoryFlatIconButtonStyle}" ToolTipService.ToolTip="{x:Bind UndoTooltip, Mode=OneWay}" AutomationProperties.Name="Desfazer operação" IsEnabled="{x:Bind CanUndo, Mode=OneWay}" Tag="{x:Bind Record, Mode=OneWay}" Click="Undo_Click"><FontIcon Glyph="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                      <Button Style="{StaticResource HistoryFlatIconButtonStyle}" ToolTipService.ToolTip="{x:Bind RepeatTooltip, Mode=OneWay}" AutomationProperties.Name="Repetir operação" IsEnabled="{x:Bind CanRepeat, Mode=OneWay}" Tag="{x:Bind Record, Mode=OneWay}" Click="Repeat_Click"><FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                      <Button Style="{StaticResource HistoryFlatIconButtonStyle}" ToolTipService.ToolTip="Ver saída completa" AutomationProperties.Name="Ver saída" IsEnabled="{x:Bind HasOutput, Mode=OneWay}" Tag="{x:Bind Record, Mode=OneWay}" Click="ViewOutput_Click"><FontIcon Glyph="&#xF0E3;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                      <Button Style="{StaticResource HistoryFlatIconButtonStyle}" ToolTipService.ToolTip="Remover do histórico" AutomationProperties.Name="Remover do histórico" Tag="{x:Bind Record, Mode=OneWay}" Click="Remove_Click"><FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
              <ic:FluentIcon Icon="History" IconSize="Size32" IconVariant="Regular" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
            <Button Grid.Column="0" Click="ClearHistory_Click" Height="36" Padding="10,4" AutomationProperties.Name="Limpar histórico">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15"/><TextBlock Text="Limpar histórico" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <ComboBox Width="145" ItemsSource="{x:Bind ViewModel.StatusOptions, Mode=OneWay}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}" AutomationProperties.Name="Filtrar por status"/>
              <ComboBox Width="145" ItemsSource="{x:Bind ViewModel.TypeOptions, Mode=OneWay}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{x:Bind ViewModel.SelectedType, Mode=TwoWay}" AutomationProperties.Name="Filtrar por tipo"/>
              <ComboBox Width="210" ItemsSource="{x:Bind ViewModel.ManagerOptions, Mode=OneWay}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{x:Bind ViewModel.SelectedManager, Mode=TwoWay}" AutomationProperties.Name="Filtrar por gerenciador"/>
            </StackPanel>
          </Grid>
        </Grid>
      </TabViewItem>
      <TabViewItem IsClosable="False">
        <TabViewItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xF0E3;" FontFamily="Segoe MDL2 Assets" FontSize="16"/><TextBlock Text="Registro" VerticalAlignment="Center"/></StackPanel>
        </TabViewItem.Header>
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <controls:ManagerLogViewer x:Name="HistoryLogViewer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>
      </TabViewItem>
    </TabView>
  </Grid>
</Page>
