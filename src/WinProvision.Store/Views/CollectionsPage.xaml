        <conv:UpdatePackageIconUrlConverter x:Key="CollectionIconUrl" />
        <CornerRadius x:Key="CollectionBadgeRadius">4</CornerRadius>
        <Style x:Key="CollectionToolbarStyle" TargetType="Button" BasedOn="{StaticResource PageToolbarButtonStyle}">
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </Page.Resources>
    <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="{StaticResource PageContentMaxWidth}">
