                                <MenuFlyoutItem Text="Renomear perfil" Click="RenameProfile_Click" IsEnabled="{Binding CanEditProfile}" />
                                <MenuFlyoutItem Text="Excluir perfil" Command="{Binding DeleteCommand}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Abrir coleção JSON" Command="{Binding ImportCommand}" />
                                <MenuFlyoutItem x:Name="ImportCloudMenuItem" AutomationProperties.AutomationId="ImportCloudMenuItem" Text="Importar da nuvem" Command="{x:Bind Account.RestoreFromCloudCommand}" IsEnabled="{x:Bind Account.CanImportCloudBackup, Mode=OneWay}" ToolTipService.ToolTip="Importar coleções da conta GitHub conectada em Conta" />
                                <MenuFlyoutItem Text="Salvar coleção como JSON" Command="{Binding ExportCommand}" />
                                <MenuFlyoutItem Text="Criar script PowerShell" Command="{Binding ExportScriptCommand}" />
                                <MenuFlyoutItem Text="Criar ZIP dos aplicativos selecionados" Command="{Binding ExportOfflineCommand}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Limpar coleção" Command="{Binding ClearCommand}" />
