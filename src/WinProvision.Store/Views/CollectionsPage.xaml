                    </Button>
                    <Button x:Name="OptionsButton" AutomationProperties.AutomationId="OptionsButton" Style="{StaticResource CollectionToolbarStyle}" Width="34" Padding="0" ToolTipService.ToolTip="Mais ações da coleção" AutomationProperties.Name="Mais ações da coleção">
