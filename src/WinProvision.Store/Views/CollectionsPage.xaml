<Page
    x:Class="WinProvision.Store.Views.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinProvision.Store.Controls"
    xmlns:services="using:WinProvision.Store.Services"
    x:Name="CollectionsRoot"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    FontFamily="{StaticResource StoreFontFamily}"
    FontSize="13">
    <Page.Resources>
        <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <services:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <services:OfflineReportStageVisibilityConverter x:Key="OfflineReportStageVisibilityConverter" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:PackageScreen x:Name="Screen" Grid.Row="0" Provider="{x:Bind ScreenProvider, Mode=OneWay}" />
        <Border
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.HasOfflineReport, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            HorizontalAlignment="Center"
            MaxWidth="1200"
            Margin="16,4,16,8"
            Padding="12"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.OfflineSummaryText, Mode=OneWay}"
                        FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Tentar novamente os que falharam"
                            Command="{x:Bind ViewModel.RetryOfflineFailuresCommand}"
                            Visibility="{x:Bind ViewModel.CanRetryOfflineFailures, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTipService.ToolTip="A retentativa fica indisponível enquanto outra operação está em andamento." />
                        <Button Content="Abrir pasta do ZIP"
                            Command="{x:Bind ViewModel.OpenOfflineZipFolderCommand}"
                            IsEnabled="{x:Bind ViewModel.HasOfflineZip, Mode=OneWay}" />
                        <Button Content="Copiar relatório"
                            Command="{x:Bind ViewModel.CopyOfflineReportCommand}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.OfflineReportItems, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,4" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Version}"
                                                    Visibility="{Binding Version, Converter={StaticResource NullToVisibilityConverter}}"
                                                    Opacity="0.8" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold" />
                                        </Grid>
                                        <TextBlock Text="{Binding Stage}" FontSize="12" Opacity="0.8"
                                            Visibility="{Binding Status, Converter={StaticResource OfflineReportStageVisibilityConverter}}" />
                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12"
                                            Visibility="{Binding Reason, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
