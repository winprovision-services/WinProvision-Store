                    <Border Grid.Column="5" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CollectionBadgeRadius}" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTipService.ToolTip="{Binding SourceLabel}">
