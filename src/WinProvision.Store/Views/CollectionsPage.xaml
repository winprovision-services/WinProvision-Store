                    </StackPanel>
                    <Button Grid.Row="2" HorizontalAlignment="Center" Tag="{Binding}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="14,4" FontSize="11" ToolTipService.ToolTip="Remover da coleção" Command="{Binding RemoveCommand}" AutomationProperties.Name="Remover da coleção">
