                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource InstalledSourceSelectionButtonStyle}" Margin="4,0,0,0" Padding="6,0" Click="ClearSources_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon FontSize="14" Margin="0,0,4,0" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="Limpar" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <CheckBox x:Name="SourceAllCheckBox" AutomationProperties.AutomationId="SourceAllCheckBox" IsChecked="{Binding AllSources, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Todas as fontes" Click="SourceAll_Click" Margin="2,3">
                                        <CheckBox.Resources>
                                            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
                                        </CheckBox.Resources>
                                    </CheckBox>
                                    <CheckBox x:Name="SourceWingetCheckBox" AutomationProperties.AutomationId="SourceWingetCheckBox" IsChecked="{Binding SourceWinget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="SourceFilter_Click" Margin="2,3">
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon FontSize="16" Margin="0,0,8,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            <TextBlock Text="WinGet" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <CheckBox.Resources>
                                            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
                                        </CheckBox.Resources>
                                    </CheckBox>
                                    <CheckBox x:Name="SourceStoreCheckBox" AutomationProperties.AutomationId="SourceStoreCheckBox" IsChecked="{Binding SourceMsStore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="SourceFilter_Click" Margin="2,3">
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon FontSize="16" Margin="0,0,8,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            <TextBlock Text="Microsoft Store" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <CheckBox.Resources>
                                            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
                                        </CheckBox.Resources>
                                    </CheckBox>
                                    <CheckBox x:Name="SourceOfficeCheckBox" AutomationProperties.AutomationId="SourceOfficeCheckBox" IsChecked="{Binding SourceOffice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="SourceFilter_Click" Margin="2,3">
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon FontSize="16" Margin="0,0,8,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            <TextBlock Text="Office (ODT)" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <CheckBox.Resources>
                                            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
                                        </CheckBox.Resources>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </Expander>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,8" />
                        <Expander IsExpanded="False" Background="Transparent" BorderThickness="0" Padding="4,2" Margin="0,0,0,8" Style="{StaticResource UpdatesExpanderStyle}" x:Name="AdditionalFiltersExpander" AutomationProperties.AutomationId="AdditionalFiltersExpander">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    <TextBlock Text="Filtros" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Perfil" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="2,0,0,4" />
                                    <StackPanel x:Name="ViewProfilePanel" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="ProfileSelector" AutomationProperties.AutomationId="ProfileSelector" Height="32" HorizontalAlignment="Stretch" Width="205" DisplayMemberPath="Title" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" AutomationProperties.Name="Perfil da coleção" />
                                    </StackPanel>
                                    <StackPanel x:Name="RenamePanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                                        <TextBox x:Name="RenameTextBox" AutomationProperties.AutomationId="RenameTextBox" Width="140" Height="32" Margin="0,0,6,0" KeyDown="RenameTextBox_KeyDown" />
                                        <Button Height="32" Padding="8,0" Margin="0,0,4,0" Click="SaveProfileName_Click" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" ToolTipService.ToolTip="Salvar nome">
                                            <FontIcon FontSize="15" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        </Button>
                                        <Button Height="32" Padding="8,0" Click="CancelProfileName_Click" ToolTipService.ToolTip="Cancelar">
                                            <FontIcon FontSize="15" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        </Button>
                                    </StackPanel>
                                    <CheckBox x:Name="FilterOnlySelectedCheckBox" AutomationProperties.AutomationId="FilterOnlySelectedCheckBox" IsChecked="{Binding OnlySelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Apenas selecionados" Margin="2,8,2,3">
                                        <CheckBox.Resources>
                                            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
                                        </CheckBox.Resources>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </Expander>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,8" />
                        <Expander IsExpanded="True" Background="Transparent" BorderThickness="0" Padding="4,2" Style="{StaticResource UpdatesExpanderStyle}" x:Name="SearchExpander" AutomationProperties.AutomationId="SearchExpander">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    <TextBlock Text="Modo de pesquisa" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <AutoSuggestBox QueryIcon="Find" Style="{StaticResource PageFilterSearchBoxStyle}" x:Name="SearchBox" AutomationProperties.AutomationId="SearchBox" Text="{Binding SearchText, Mode=OneWay}" PlaceholderText="Pesquisar nome, fornecedor ou ID..." TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted" AutomationProperties.Name="Pesquisar aplicativos na coleção" ToolTipService.ToolTip="Pesquise pelo nome ou ID do pacote" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Thumb x:Name="FilterSplitter" Grid.Column="1" Width="8" DragDelta="FilterSplitter_DragDelta" Background="Transparent" AutomationProperties.Name="Redimensionar filtros">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Rectangle Grid.Column="1" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" HorizontalAlignment="Center" />
            <Border Grid.Column="2" Padding="8,8,8,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource StoreCardCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="TableHeaderBar" Height="34" Margin="0,0,0,4" Padding="8,0" BorderThickness="1" BorderBrush="Transparent" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                        <Grid Margin="5,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="MasterSelectionCheckBox" AutomationProperties.AutomationId="MasterSelectionCheckBox" Grid.Column="0" Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding MasterSelection, Mode=OneWay}" Click="MasterSelection_Click" AutomationProperties.Name="Selecionar todos os aplicativos visíveis">
                                <CheckBox.Resources>
                                    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
                                </CheckBox.Resources>
                            </CheckBox>
                            <Button Grid.Column="2" Margin="6,0,12,0" Padding="0" MinWidth="0" MinHeight="32" FontSize="12" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Click="SortName_Click">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Nome do aplicativo" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="11" x:Name="SortNameIcon" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Padding="0" MinWidth="0" MinHeight="32" FontSize="12" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Click="SortId_Click">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="ID do Pacote" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="11" x:Name="SortIdIcon" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Padding="0" MinWidth="0" MinHeight="32" FontSize="12" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Click="SortVersion_Click">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Versão" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="11" x:Name="SortVersionIcon" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="5" Padding="0" MinWidth="0" MinHeight="32" FontSize="12" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Click="SortSource_Click">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Origem" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="11" x:Name="SortSourceIcon" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="6" Text="Tamanho" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="7" Text="Ações" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ListView controls:FluentMotion.Kind="Items" x:Name="CollectionListView" AutomationProperties.AutomationId="CollectionListView" Grid.Row="1" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CollectionRowTemplate}" SelectionMode="None" Padding="0" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" KeyDown="PackagesView_KeyDown">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                    </ListView>
                    <GridView controls:FluentMotion.Kind="Items" x:Name="CollectionGridView" AutomationProperties.AutomationId="CollectionGridView" Grid.Row="1" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CollectionCardTemplate}" SelectionMode="None" Padding="0" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" KeyDown="PackagesView_KeyDown" Visibility="Collapsed">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GridViewItem">
                                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                    </GridView>
                    <GridView controls:FluentMotion.Kind="Items" x:Name="CollectionIconsView" AutomationProperties.AutomationId="CollectionIconsView" Grid.Row="1" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CollectionIconTemplate}" SelectionMode="None" Padding="0" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" KeyDown="PackagesView_KeyDown" Visibility="Collapsed">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GridViewItem">
                                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                    </GridView>
                    <StackPanel controls:FluentMotion.Kind="Entrance" x:Name="LoadingState" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                        <ProgressRing IsActive="{Binding IsExportingOffline}" Width="36" Height="36" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding OfflineStatusText}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                        <ProgressBar x:Name="OfflineProgressBar" Width="280" Minimum="0" Maximum="100" />
                        <Button Content="Cancelar exportação" Command="{Binding CancelOfflineExportCommand}" />
                    </StackPanel>
                    <StackPanel controls:FluentMotion.Kind="Entrance" x:Name="EmptyState" Grid.RowSpan="2" Style="{StaticResource PageEmptyStatePanelStyle}" Spacing="8" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource PageEmptyStateIconTileStyle}">
                            <Image Source="ms-appx:///Assets/app_icon_256.png" Width="40" Height="40" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{Binding EmptyStateTitle}" Style="{StaticResource PageEmptyStateTitleStyle}" />
                        <TextBlock Text="{Binding EmptyStateMessage}" Style="{StaticResource PageEmptyStateMessageStyle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <Button Content="Abrir arquivo de coleção" Command="{Binding ImportCommand}" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <Button Content="Nova coleção" Command="{Binding NewCommand}" Style="{StaticResource StoreActionButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel controls:FluentMotion.Kind="Entrance" x:Name="NoResultsState" Grid.RowSpan="2" Style="{StaticResource PageEmptyStatePanelStyle}" Spacing="8" MaxWidth="380" Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="30" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyStateTitle}" Style="{StaticResource PageEmptyStateTitleStyle}" />
                        <TextBlock Text="{Binding EmptyStateMessage}" Style="{StaticResource PageEmptyStateMessageStyle}" />
                        <Button Content="Limpar pesquisa e filtros" Click="ClearFilters_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                    <InfoBar x:Name="CollectionErrorInfoBar" Grid.RowSpan="2" IsOpen="{Binding HasError, Mode=TwoWay}" Title="{Binding ErrorTitle}" Message="{Binding ErrorMessage}" Severity="Error" IsClosable="True" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="720" />
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource PageStatusBarStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource PageStatusIconStyle}" Grid.Column="0" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    <TextBlock Text="{Binding SelectionSummaryText}" Style="{StaticResource PageStatusPrimaryTextStyle}" Grid.Column="1" />
                    <TextBlock Text=" · " Foreground="{ThemeResource TextFillColorTertiaryBrush}" Grid.Column="2" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource PageStatusTextStyle}" Grid.Column="3" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Classificar por:" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                    <ComboBox x:Name="SortModeComboBox" AutomationProperties.AutomationId="SortModeComboBox" Width="150" Height="32" Margin="0,0,12,0" SelectedIndex="0" SelectionChanged="SortMode_SelectionChanged">
                        <ComboBoxItem Content="Nome" />
                        <ComboBoxItem Content="ID" />
                        <ComboBoxItem Content="Versão" />
                        <ComboBoxItem Content="Origem" />
                    </ComboBox>
                    <ToggleButton x:Name="ListViewToggleButton" AutomationProperties.AutomationId="ListViewToggleButton" Style="{StaticResource CollectionModeButtonStyle}" ToolTipService.ToolTip="Visualização em lista" AutomationProperties.Name="Visualização em lista" Click="ListViewMode_Click">
                        <FontIcon Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
                    </ToggleButton>
                    <ToggleButton x:Name="GridViewToggleButton" AutomationProperties.AutomationId="GridViewToggleButton" Style="{StaticResource CollectionModeButtonStyle}" ToolTipService.ToolTip="Visualização em cartões" AutomationProperties.Name="Visualização em cartões" Click="GridViewMode_Click">
                        <FontIcon Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
                    </ToggleButton>
                    <ToggleButton x:Name="IconsViewToggleButton" AutomationProperties.AutomationId="IconsViewToggleButton" Style="{StaticResource CollectionModeButtonStyle}" ToolTipService.ToolTip="Visualização em ícones" AutomationProperties.Name="Visualização em ícones" Click="IconsViewMode_Click">
                        <FontIcon Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
