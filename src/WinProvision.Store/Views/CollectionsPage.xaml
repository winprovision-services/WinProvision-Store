                            <Image x:Name="CollectionIconImage" Stretch="Uniform" Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=CollectionIconImage, Converter={StaticResource BoolToVisibilityConverter}}" conv:AsyncImage.SourceUrl="{Binding IconUrl, Converter={StaticResource CollectionIconUrl}}" conv:AsyncImage.DecodePixelWidth="64" HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40" />
                        </Grid>
