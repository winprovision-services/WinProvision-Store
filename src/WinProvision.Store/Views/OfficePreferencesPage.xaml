<Page
    x:Class="WinProvision.Store.Views.OfficePreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinProvision.Store.ViewModels"
    xmlns:core="using:WinProvision.Core.Models.Office"
    xmlns:services="using:WinProvision.Store.Services"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <DataTemplate x:Key="OfficeCategoryTemplate" x:DataType="vm:OfficeCategoryOption">
            <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
        </DataTemplate>
        <DataTemplate x:Key="OfficePlanTemplate" x:DataType="core:OfficePlan">
            <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}" />
        </DataTemplate>
        <DataTemplate x:Key="OfficeChannelTemplate" x:DataType="vm:OfficeChannelOption">
            <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
        </DataTemplate>
        <DataTemplate x:Key="OfficeSelectorTemplate" x:DataType="vm:OfficeSelectorOption">
            <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
        </DataTemplate>
        <DataTemplate x:Key="OfficeToggleTemplate" x:DataType="vm:OfficeAppToggleViewModel">
            <CheckBox Content="{x:Bind DisplayName, Mode=OneTime}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" />
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource PackageManagerControlSpacing}"
                    Margin="{StaticResource PageHeaderMargin}">
            <Button x:Name="OfficePreferencesBackButton" Style="{StaticResource PackageManagerIconButtonStyle}"
                    AutomationProperties.Name="Voltar para Office" Click="Back_Click" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <TextBlock Text="Configurações do Office" Style="{StaticResource FluentPageTitleStyle}"
                       VerticalAlignment="Center" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource PackageManagerScrollContentMargin}" Spacing="12">
                <Border Style="{StaticResource PackageManagerSettingsCardStyle}" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Produto" FontSize="18" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ComboBox Header="Categoria" ItemsSource="{Binding Categories}"
                                      ItemTemplate="{StaticResource OfficeCategoryTemplate}"
                                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
                            <ComboBox Grid.Column="1" Header="Produto" ItemsSource="{Binding Plans}"
                                      ItemTemplate="{StaticResource OfficePlanTemplate}"
                                      SelectedItem="{Binding SelectedPlan, Mode=TwoWay}" />
                            <ComboBox Grid.Row="1" Header="Canal" ItemsSource="{Binding Channels}"
                                      ItemTemplate="{StaticResource OfficeChannelTemplate}"
                                      SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                                      IsEnabled="{Binding IsChannelEnabled}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Header="Arquitetura" ItemsSource="{Binding ArchitectureOptions}"
                                      ItemTemplate="{StaticResource OfficeSelectorTemplate}"
                                      SelectedValuePath="Id" SelectedValue="{Binding Architecture, Mode=TwoWay}" />
                            <ComboBox Grid.Row="2" Header="Idioma" ItemsSource="{Binding LanguageOptions}"
                                      ItemTemplate="{StaticResource OfficeSelectorTemplate}"
                                      SelectedValuePath="Id" SelectedValue="{Binding LanguageId, Mode=TwoWay}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Header="Interface" ItemsSource="{Binding DisplayOptions}"
                                      ItemTemplate="{StaticResource OfficeSelectorTemplate}"
                                      SelectedValuePath="Id" SelectedValue="{Binding DisplayMode, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PackageManagerSettingsCardStyle}" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Instalação e atualizações" FontSize="18" FontWeight="SemiBold" />
                        <CheckBox Content="Baixar antes de instalar" IsChecked="{Binding DownloadBeforeInstall, Mode=TwoWay}" />
                        <CheckBox Content="Atualizações automáticas" IsChecked="{Binding RequestedAutoUpdatesEnabled, Mode=TwoWay}"
                                  Checked="AutoUpdates_Changed" Unchecked="AutoUpdates_Changed" />
                        <TextBlock Text="A alteração da política é aplicada ao Office instalado."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="{StaticResource PackageManagerDescriptionFontSize}" />
                        <Button Content="Aplicar configuração de atualização" Command="{Binding ApplyAutoUpdatesCommand}"
                                IsEnabled="{Binding CanEditUpdatePreference}"
                                Style="{StaticResource PackageManagerActionButtonStyle}"
                                Visibility="{Binding HasInstalledProducts, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PackageManagerSettingsCardStyle}" Padding="20">
                    <Expander Header="Opções avançadas" IsExpanded="False">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <TextBlock Text="Idiomas adicionais" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding AdditionalLanguages}" ItemTemplate="{StaticResource OfficeToggleTemplate}" />
                            <TextBlock Text="Componentes a excluir" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <ItemsControl ItemsSource="{Binding ExcludedComponents}" ItemTemplate="{StaticResource OfficeToggleTemplate}" />
                        </StackPanel>
                    </Expander>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
