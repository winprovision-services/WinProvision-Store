<Page xmlns:vm="using:WinProvision.Store.ViewModels" xmlns:ic="using:FluentIcons.WinUI" x:Class="WinProvision.Store.Views.ProvisioningPage"
      xmlns:ui="using:CommunityToolkit.WinUI"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:WinProvision.Store.Services"
      xmlns:controls="using:WinProvision.Store.Controls"
      xmlns:settings="using:CommunityToolkit.WinUI.Controls"
      Background="Transparent" FontFamily="{StaticResource StoreFontFamily}" FontSize="13" x:DataType="vm:ProvisioningViewModel">
    <Page.Resources>
<ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.SettingsControls/SettingsExpander/SettingsExpander.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <x:Double x:Key="ProvisioningSettingsCardSpacing">4</x:Double>
      <Style x:Key="ProvisioningSettingsSectionHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Margin" Value="1,30,0,6" />
      </Style>
    </ResourceDictionary>
  </Page.Resources>
  <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource PageHeaderIconTileStyle}">
        <ic:FluentIcon Icon="Settings" IconVariant="Color" IconSize="Size24" Style="{StaticResource PageHeaderSymbolIconStyle}" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="Provisionamento" Style="{StaticResource FluentPageTitleStyle}" />
        <TextBlock Text="Prepare configurações opcionais do Windows para importar e aplicar em outra máquina." Style="{StaticResource FluentPageSubtitleStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource PageToolbarContainerStyle}">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button x:Name="SaveProvisioningButton" Content="Salvar perfil" Command="{Binding SaveCommand}" Style="{StaticResource PagePrimaryActionButtonStyle}" />
          <Button Content="Importar" Command="{Binding ImportCommand}" Style="{StaticResource PageToolbarButtonStyle}" />
          <Button Content="Exportar" Command="{Binding ExportCommand}" Style="{StaticResource PageToolbarButtonStyle}" />
        </StackPanel>
      </ScrollViewer>
    </Border>
    <ScrollViewer x:Name="ProvisioningScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="{StaticResource ProvisioningSettingsCardSpacing}">
      <StackPanel.ChildrenTransitions>
        <EntranceThemeTransition FromVerticalOffset="50" />
        <RepositionThemeTransition IsStaggeringEnabled="False" />
      </StackPanel.ChildrenTransitions>
      <TextBlock Text="Perfil" Style="{StaticResource ProvisioningSettingsSectionHeaderStyle}" />
      <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Identificação" IsExpanded="True">
        <StackPanel Spacing="4">
          <settings:SettingsCard Header="Nome do perfil"><TextBox Text="{Binding ProfileName, Mode=TwoWay}" PlaceholderText="Estação de trabalho padrão" /></settings:SettingsCard>
          <settings:SettingsCard Header="Responsável ou organização"><TextBox Text="{Binding Creator, Mode=TwoWay}" PlaceholderText="Opcional" /></settings:SettingsCard>
          <settings:SettingsCard Header="Nome do computador"><TextBox Text="{Binding MachineName, Mode=TwoWay}" PlaceholderText="Nome do computador" /></settings:SettingsCard>
        </StackPanel>
      </Expander>
      <TextBlock Text="Personalização" Style="{StaticResource ProvisioningSettingsSectionHeaderStyle}" />
      <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Name="AppearanceSettingsExpander" Header="Aparência">
        <StackPanel Spacing="4">
          <settings:SettingsCard Header="Tema do Windows"><ComboBox ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSystemTheme, Mode=TwoWay}" /></settings:SettingsCard>
          <settings:SettingsCard Header="Tema dos aplicativos"><ComboBox ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedAppsTheme, Mode=TwoWay}" /></settings:SettingsCard>
          <settings:SettingsCard Header="Cor de destaque"><ComboBox ItemsSource="{Binding AccentOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedAccentMode, Mode=TwoWay}" /></settings:SettingsCard>
          <settings:SettingsCard Header="Cor personalizada" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" Visibility="{Binding IsCustomAccentSelected, Converter={StaticResource BoolToVisibilityConverter}}">
            <settings:ColorPicker x:Name="ProvisioningAccentColorPicker" HorizontalAlignment="Center" MaxWidth="460" Color="{Binding AccentColorValue, Mode=TwoWay}" ColorChanged="ProvisioningAccentColorPicker_ColorChanged" IsAlphaEnabled="False" IsColorPreviewVisible="True" IsHexInputVisible="True" IsColorSpectrumVisible="True" IsColorSliderVisible="True" IsColorChannelTextInputVisible="True" IsColorPaletteVisible="True" ShowAccentColors="True" AutomationProperties.Name="Cor de destaque personalizada" />
          </settings:SettingsCard>
          <settings:SettingsCard Header="Alinhamento da barra de tarefas"><ComboBox ItemsSource="{Binding AlignmentOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTaskbarAlignment, Mode=TwoWay}" /></settings:SettingsCard>
          <settings:SettingsCard Header="Pesquisa na barra de tarefas"><ComboBox ItemsSource="{Binding SearchOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTaskbarSearch, Mode=TwoWay}" /></settings:SettingsCard>
          <settings:SettingsCard Header="Ocultar barra automaticamente"><ComboBox ItemsSource="{Binding BooleanOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTaskbarAutoHide, Mode=TwoWay}" /></settings:SettingsCard>
          <settings:SettingsCard Header="Papel de parede" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
          <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Papel de parede" IsExpanded="{Binding IsWallpaperPickerExpanded, Mode=TwoWay}">
            <StackPanel Spacing="4">
              <settings:SettingsCard Header="Imagens disponíveis" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                <StackPanel Spacing="10">
                  <ProgressRing IsActive="{Binding IsLoadingWallpaperCatalog}" Width="20" Height="20" HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding WallpaperCatalogStatusText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                  <ItemsControl x:Name="WallpaperGalleryItems" ItemsSource="{Binding WallpaperOptions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><controls:WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Click="WallpaperOption_Click" Padding="0" Margin="0,0,12,12" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding FileName}">
                          <settings:SettingsCard Width="220" Header="{Binding FileName}" ContentAlignment="Vertical" HorizontalContentAlignment="Left" IsClickEnabled="True">
                            <Grid Width="190" Height="112" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                              <Image Stretch="UniformToFill" conv:AsyncImage.SourceUrl="{Binding Url}" conv:AsyncImage.DecodePixelWidth="400" Visibility="{Binding IsLocalChoice, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{Binding IsLocalChoice, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource AccentFillColorDefaultBrush}"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Text="Escolher imagem local" FontWeight="SemiBold" HorizontalAlignment="Center" />
                              </StackPanel>
                              <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="26" Height="26" CornerRadius="13" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" Margin="8"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                              <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" IsHitTestVisible="False" />
                            </Grid>
                          </settings:SettingsCard>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </settings:SettingsCard>
            </StackPanel>
          </Expander>
          </settings:SettingsCard>
        </StackPanel>
      </Expander>

      <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Sistema e Explorador de Arquivos">
        <StackPanel Spacing="4">
          <settings:SettingsCard Header="Plano de energia"><ComboBox ItemsSource="{Binding PowerOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedPowerPlan, Mode=TwoWay}" /></settings:SettingsCard>
          <settings:SettingsCard Header="Mostrar extensões de arquivo"><ComboBox ItemsSource="{Binding BooleanOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedShowFileExtensions, Mode=TwoWay}" /></settings:SettingsCard>
          <settings:SettingsCard Header="Mostrar arquivos ocultos"><ComboBox ItemsSource="{Binding BooleanOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedShowHiddenFiles, Mode=TwoWay}" /></settings:SettingsCard>
          <settings:SettingsCard Header="Abrir Explorador em Este Computador"><ComboBox ItemsSource="{Binding BooleanOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedOpenExplorerToThisPc, Mode=TwoWay}" /></settings:SettingsCard>
        </StackPanel>
      </Expander>
      <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Prévia da área de trabalho">
        <StackPanel Spacing="4">
          <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="14">
              <Border x:Name="DesktopPreviewFrame" Height="500" CornerRadius="12" Background="#FF101820" SizeChanged="DesktopPreviewFrame_SizeChanged" AutomationProperties.Name="Prévia interativa da área de trabalho em proporção 16 por 9">
            <Grid>
              <Image x:Name="DesktopPreviewWallpaper" Stretch="UniformToFill" />
              <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,16,0,0" Spacing="15" IsHitTestVisible="False">
                <StackPanel Width="75" Spacing="4"><Image Source="ms-appx:///Assets/Windows11Preview/computer.png" Width="32" Height="32"/><TextBlock Text="Este Computador" Foreground="White" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                <StackPanel Width="75" Spacing="4"><Image Source="ms-appx:///Assets/Windows11Preview/recycle-bin.png" Width="32" Height="32"/><TextBlock Text="Lixeira" Foreground="White" FontSize="10" TextAlignment="Center" /></StackPanel>
                <StackPanel Width="75" Spacing="4"><Image Source="ms-appx:///Assets/Windows11Preview/folder.png" Width="32" Height="32"/><TextBlock Text="Arquivos" Foreground="White" FontSize="10" TextAlignment="Center" /></StackPanel>
              </StackPanel>
              <Border x:Name="PreviewStartPanel" Width="440" Height="474" Margin="0,0,0,46" HorizontalAlignment="Center" VerticalAlignment="Bottom" CornerRadius="8" Padding="24,18" BorderThickness="1" Visibility="{Binding IsPreviewStartOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid RowSpacing="12">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Button Content="⌕   Digite aqui para pesquisar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding PreviewSearchCommand}" />
                  <StackPanel Grid.Row="1" Spacing="10">
                    <Grid><TextBlock Text="Fixado" FontWeight="SemiBold"/><Button Content="Todos os aplicativos  ›" HorizontalAlignment="Right" Padding="6,2"/></Grid>
                    <Grid ColumnSpacing="5" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/edge.png" Width="28" Height="28"/><TextBlock Text="Edge" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/mail.png" Width="28" Height="28"/><TextBlock Text="Email" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/photos.png" Width="28" Height="28"/><TextBlock Text="Fotos" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/settings.png" Width="28" Height="28"/><TextBlock Text="Config." FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/explorer.png" Width="28" Height="28"/><TextBlock Text="Explorador" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="5" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/calendar.png" Width="28" Height="28"/><TextBlock Text="Calendário" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/word.png" Width="28" Height="28"/><TextBlock Text="Word" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/excel.png" Width="28" Height="28"/><TextBlock Text="Excel" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/powerpoint.png" Width="28" Height="28"/><TextBlock Text="PowerPoint" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/onenote.png" Width="28" Height="28"/><TextBlock Text="OneNote" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="4" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/teams.png" Width="28" Height="28"/><TextBlock Text="Teams" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="5" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/security.png" Width="28" Height="28"/><TextBlock Text="Segurança" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                      <StackPanel Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/onedrive.png" Width="28" Height="28"/><TextBlock Text="OneDrive" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                      <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/widgets.png" Width="28" Height="28"/><TextBlock Text="Widgets" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                      <StackPanel Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center"><Image Source="ms-appx:///Assets/Windows11Preview/photoshop.png" Width="28" Height="28"/><TextBlock Text="Photoshop" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Spacing="12">
                    <Grid><TextBlock Text="Recomendado" FontWeight="SemiBold"/><Button Content="Mais  ›" HorizontalAlignment="Right" Padding="8,2"/></Grid>
                    <Grid ColumnSpacing="12" RowSpacing="11"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="7"><Image Source="ms-appx:///Assets/Windows11Preview/word.png" Width="23" Height="23"/><StackPanel><TextBlock Text="Documento recente" FontSize="11"/><TextBlock Text="Recente" FontSize="9" Opacity="0.7"/></StackPanel></StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="7"><Image Source="ms-appx:///Assets/Windows11Preview/explorer.png" Width="23" Height="23"/><StackPanel><TextBlock Text="Explorador de Arquivos" FontSize="11"/><TextBlock Text="Aplicativo" FontSize="9" Opacity="0.7"/></StackPanel></StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="7"><Image Source="ms-appx:///Assets/Windows11Preview/folder.png" Width="23" Height="23"/><StackPanel><TextBlock Text="Downloads" FontSize="11"/><TextBlock Text="Recente" FontSize="9" Opacity="0.7"/></StackPanel></StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="7"><Image Source="ms-appx:///Assets/Windows11Preview/settings.png" Width="23" Height="23"/><StackPanel><TextBlock Text="Configurações" FontSize="11"/><TextBlock Text="Aplicativo" FontSize="9" Opacity="0.7"/></StackPanel></StackPanel>
                      <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="7"><Image Source="ms-appx:///Assets/Windows11Preview/excel.png" Width="23" Height="23"/><StackPanel><TextBlock Text="Planilha recente" FontSize="11"/><TextBlock Text="Recente" FontSize="9" Opacity="0.7"/></StackPanel></StackPanel>
                      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="7"><Image Source="ms-appx:///Assets/Windows11Preview/edge.png" Width="23" Height="23"/><StackPanel><TextBlock Text="Microsoft Edge" FontSize="11"/><TextBlock Text="Aplicativo" FontSize="9" Opacity="0.7"/></StackPanel></StackPanel>
                    </Grid>
                  </StackPanel>
                  <Grid Grid.Row="3"><TextBlock Text="◉  Usuário" VerticalAlignment="Center"/><TextBlock Text="⏻" FontSize="17" HorizontalAlignment="Right"/></Grid>
                </Grid>
              </Border>
              <Border x:Name="PreviewSearchPanel" Width="356" Height="310" Margin="0,0,0,46" HorizontalAlignment="Center" VerticalAlignment="Bottom" CornerRadius="8" Padding="18,14" BorderThickness="1" Visibility="{Binding IsPreviewSearchOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12"><TextBox PlaceholderText="Pesquisar aplicativos, configurações e documentos"/><TextBlock Text="Principal     Aplicativos     Documentos     Web" FontSize="11"/><TextBlock Text="Principais aplicativos" FontWeight="SemiBold"/><TextBlock Text="🌐  Microsoft Edge"/><TextBlock Text="📁  Explorador de Arquivos"/><TextBlock Text="⚙  Configurações"/></StackPanel>
              </Border>
              <Border x:Name="PreviewQuickSettingsPanel" Width="280" Height="245" Margin="0,0,12,46" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="8" Padding="16" BorderThickness="1" Visibility="{Binding IsPreviewQuickSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12"><TextBlock Text="Configurações rápidas" FontWeight="SemiBold"/><TextBlock Text="📶     Bluetooth       ✈" FontSize="17"/><TextBlock Text="Wi-Fi       Bluetooth       Avião" FontSize="10"/><TextBlock Text="☀  Brilho"/><Slider Value="70"/><TextBlock Text="◖  Volume"/><Slider Value="60"/><TextBlock Text="🔋  Energia                 ⚙"/></StackPanel>
              </Border>
              <Border x:Name="PreviewNotificationsPanel" Width="280" Height="326" Margin="0,0,12,46" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="8" Padding="16" BorderThickness="1" Visibility="{Binding IsPreviewNotificationsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="10"><TextBlock Text="Centro de notificações" FontWeight="SemiBold"/><TextBlock Text="Nenhuma nova notificação" HorizontalAlignment="Center" Margin="0,8"/><TextBlock Text="quinta-feira, 22 de outubro" FontWeight="SemiBold"/><TextBlock Text="D   S   T   Q   Q   S   S"/><TextBlock Text="18   19   20   21   22   23   24"/><TextBlock Text="25   26   27   28   29   30   31"/></StackPanel>
              </Border>
              <Border x:Name="PreviewWidgetsPanel" Width="300" Height="340" Margin="12,0,0,46" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="8" Padding="16" BorderThickness="1" Visibility="{Binding IsPreviewWidgetsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12"><TextBlock Text="Widgets" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="☀  23°  Ensolarado"/><TextBlock Text="São Paulo"/><TextBlock Text="──────────────"/><TextBlock Text="📅  Agenda"/><TextBlock Text="Nenhum evento para hoje"/><TextBlock Text="──────────────"/><TextBlock Text="Notícias e interesses"/></StackPanel>
              </Border>
              <Border x:Name="DesktopPreviewTaskbar" Height="48" VerticalAlignment="Bottom" Padding="0" BorderThickness="0,1,0,0">
                <Grid>
                <Grid x:Name="NormalTaskbarContent" Margin="12,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                  <StackPanel x:Name="DesktopPreviewTaskbarIcons" Grid.Column="0" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                    <Button Command="{Binding PreviewStartCommand}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Abrir menu Iniciar"><Image x:Name="PreviewStartIcon" Width="24" Height="24"/></Button>
                    <Button x:Name="PreviewSearchIcon" Command="{Binding PreviewSearchCommand}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Abrir Pesquisa"><Image x:Name="PreviewSearchIconGlyph" Width="20" Height="20"/></Button>
                    <Button x:Name="PreviewSearchBox" Command="{Binding PreviewSearchCommand}" Width="218" Height="30" Padding="11,0,2,0" CornerRadius="15" BorderThickness="1" HorizontalContentAlignment="Stretch" Visibility="Collapsed" AutomationProperties.Name="Abrir Pesquisa"><Grid><Image x:Name="PreviewSearchBoxGlyph" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center"/><Image x:Name="PreviewSearchGleam" Width="66" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock x:Name="PreviewSearchLabel" Text="Pesquisar" FontSize="13" Margin="25,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></Button>
                    <Button Command="{Binding PreviewStartCommand}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Abrir Visão de Tarefas"><Grid Width="24" Height="24"><Rectangle Width="18" Height="16" Fill="#FF353534" HorizontalAlignment="Left" VerticalAlignment="Bottom"/><Rectangle Width="18" Height="16" Fill="#FFF0F0F0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid></Button>
                    <Button Command="{Binding PreviewStartCommand}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Abrir Copilot"><Image Source="ms-appx:///Assets/FigmaTaskbar/app1-light.png" Width="24" Height="24"/></Button>
                    <Button Command="{Binding PreviewStartCommand}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Abrir Explorador"><Image Source="ms-appx:///Assets/FigmaTaskbar/app2-light.png" Width="24" Height="24"/></Button>
                    <Button Command="{Binding PreviewStartCommand}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Abrir Edge"><Image Source="ms-appx:///Assets/FigmaTaskbar/app3-light.png" Width="24" Height="24"/></Button>
                    <Button Command="{Binding PreviewStartCommand}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Abrir Microsoft Store"><Image x:Name="PreviewStoreIcon" Source="ms-appx:///Assets/FigmaTaskbar/app4-light.png" Width="24" Height="24"/></Button>
                    <Button Command="{Binding PreviewStartCommand}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Abrir Teams"><Image Source="ms-appx:///Assets/FigmaTaskbar/app5-light.png" Width="24" Height="24"/></Button>
                    <Button Command="{Binding PreviewStartCommand}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Abrir Outlook"><Image Source="ms-appx:///Assets/FigmaTaskbar/app6-light.png" Width="24" Height="24"/></Button>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="0">
                    <Button Command="{Binding PreviewQuickSettingsCommand}" Width="32" Height="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Abrir ícones ocultos"><Image x:Name="PreviewOverflowIcon" Width="32" Height="40" Stretch="Fill"/></Button>
                    <Button Command="{Binding PreviewQuickSettingsCommand}" Width="80" Height="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Abrir Configurações Rápidas"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="&#xE15D;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="&#xEBA9;" FontFamily="Segoe Fluent Icons" FontSize="16"/></StackPanel></Button>
                    <Button Command="{Binding PreviewNotificationsCommand}" Width="68" Height="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Abrir Central de Notificações"><StackPanel><TextBlock x:Name="PreviewClock" FontSize="10" HorizontalAlignment="Right"/><TextBlock x:Name="PreviewDate" FontSize="9" HorizontalAlignment="Right"/></StackPanel></Button>
                  </StackPanel>
                </Grid>
                <Grid x:Name="HiddenTaskbarContent" Visibility="Collapsed" AutomationProperties.Name="Prévia da barra de tarefas oculta">
                  <Border>
                    <Border.Background>
                      <AcrylicBrush TintColor="#FF202020" TintOpacity="0.96" FallbackColor="#FF202020" />
                    </Border.Background>
                  </Border>
                  <Image Source="ms-appx:///Assets/FigmaTaskbar/hidden-taskbar-background.png" Stretch="Fill" Opacity="0.02" IsHitTestVisible="False" />
