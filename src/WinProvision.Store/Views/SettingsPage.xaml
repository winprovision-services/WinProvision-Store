<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="using:WinProvision.Store.Controls" xmlns:services="using:WinProvision.Store.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WinProvision.Store.Views.SettingsPage" Background="Transparent" UseLayoutRounding="True" FontFamily="{StaticResource StoreFontFamily}" FontSize="14">
  <Page.Resources>
    <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </Page.Resources>
  <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource PageHeaderIconTileStyle}">
        <FontIcon Style="{StaticResource PageHeaderSymbolIconStyle}" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="SettingsTitleTextBlock" Text="Configurações" Style="{StaticResource FluentPageTitleStyle}" />
        <TextBlock Text="Controle as preferências do aplicativo, da interface e das operações." Style="{StaticResource FluentPageSubtitleStyle}" Margin="0,4,0,0" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="BackButton" AutomationProperties.AutomationId="BackButton" Grid.Row="0" Grid.Column="0" Visibility="Collapsed" Style="{StaticResource StoreActionButtonStyle}" Margin="0,0,8,0" Click="BackButton_Click" ToolTipService.ToolTip="Voltar às categorias de configurações">
        <StackPanel Orientation="Horizontal">
          <FontIcon FontSize="16" Margin="0,0,8,0" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
          <TextBlock Text="Voltar" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <AutoSuggestBox x:Name="SettingsSearchBox" AutomationProperties.AutomationId="SettingsSearchBox" CornerRadius="18" QueryIcon="Find" Grid.Row="0" Grid.Column="2" PlaceholderText="Pesquisar configurações" Width="320" MinHeight="36" VerticalAlignment="Center" AutomationProperties.Name="Pesquisar configurações" TextChanged="SettingsSearchBox_TextChanged" QuerySubmitted="SettingsSearchBox_QuerySubmitted" />
      <TextBlock x:Name="SettingsSearchResultText" Text="{Binding SearchResultSummary}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
    <Grid Grid.Row="2" MaxWidth="760" HorizontalAlignment="Stretch">
      <ScrollViewer x:Name="HomepageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,8">
          <StackPanel x:Name="SettingsCategoryListPanel" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBlock Text="Categorias" Margin="0,0,0,12" FontSize="18" FontWeight="SemiBold" />
            <Button x:Name="CardGeneral" AutomationProperties.AutomationId="CardGeneral" AutomationProperties.Name="Preferências gerais" Tag="General" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Click="CategoryButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                  <FontIcon FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="Preferências gerais" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="Método de instalação, atualizador e gerenciamento das configurações." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <FontIcon Grid.Column="3" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
              </Grid>
            </Button>
            <Button x:Name="CardElevator" AutomationProperties.AutomationId="CardElevator" AutomationProperties.Name="WinProvision Elevator" Tag="Elevator" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Click="CategoryButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                  <FontIcon FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="WinProvision Elevator" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="Pedidos de administrador, autorização da sessão e integridade do helper." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <FontIcon Grid.Column="3" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
              </Grid>
            </Button>
            <Button x:Name="CardMaintenance" AutomationProperties.AutomationId="CardMaintenance" AutomationProperties.Name="Manutenção agendada" Tag="Maintenance" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Click="CategoryButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                  <FontIcon FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="Manutenção agendada" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="Verificações periódicas, atualizações automáticas e notificações." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <FontIcon Grid.Column="3" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
              </Grid>
            </Button>
            <Button x:Name="CardInterface" AutomationProperties.AutomationId="CardInterface" AutomationProperties.Name="Interface e inicialização" Tag="Interface" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Click="CategoryButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                  <FontIcon FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="Interface e inicialização" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="Tema do aplicativo e inicialização com o Windows." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <FontIcon Grid.Column="3" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
              </Grid>
            </Button>
            <Button x:Name="CardNotifications" AutomationProperties.AutomationId="CardNotifications" AutomationProperties.Name="Notificações" Tag="Notifications" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Click="CategoryButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                  <FontIcon FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="Notificações" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="Escolha avisos de atualizações, erros, sucessos e resumos de lotes." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <FontIcon Grid.Column="3" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
              </Grid>
            </Button>
            <Button x:Name="CardExecution" AutomationProperties.AutomationId="CardExecution" AutomationProperties.Name="Operações e downloads" Tag="Execution" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Click="CategoryButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                  <FontIcon FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="Operações e downloads" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="Limites simultâneos, pasta padrão e nomes dos instaladores baixados." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <FontIcon Grid.Column="3" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
              </Grid>
            </Button>
            <Button x:Name="CardOperations" AutomationProperties.AutomationId="CardOperations" AutomationProperties.Name="Armazenamento e cache" Tag="Operations" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Click="CategoryButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                  <FontIcon FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="Armazenamento e cache" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="Gerencie arquivos temporários das operações de pacotes." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <FontIcon Grid.Column="3" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
              </Grid>
            </Button>
          </StackPanel>
          <StackPanel x:Name="SettingsSearchResultsPanel" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Opções encontradas" Margin="0,0,0,12" FontSize="18" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding SearchResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Padding="18" CornerRadius="12" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding Description}" Click="SearchResult_Click" ToolTipService.ToolTip="{Binding Description}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <FontIcon FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="4" Text="{Binding Category}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="180" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="SettingsSearchEmptyText" Text="Nenhuma configuração corresponde à pesquisa. Tente outro termo." Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="SubCategoryScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,8">
          <StackPanel x:Name="PanelGeneral" Visibility="Collapsed">
            <TextBlock Text="Método de instalação" Margin="0,0,0,8" FontSize="18" FontWeight="SemiBold" />
            <Border x:Name="InstallMethodCard" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Método de instalação preferencial" FontWeight="SemiBold" />
                  <TextBlock x:Name="InstallMethodDescriptionText" Text="{Binding InstallMethodDescription}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <ComboBox x:Name="InstallMethodComboBox" AutomationProperties.AutomationId="InstallMethodComboBox" Grid.Column="1" Width="240" SelectedValuePath="Tag" SelectedValue="{Binding SelectedMethodName, Mode=TwoWay}">
                  <ComboBoxItem Content="Automático (recomendado)" Tag="Automatic" />
                  <ComboBoxItem Content="API COM do WinGet" Tag="ComApi" />
                  <ComboBoxItem Content="WinProvision API" Tag="WinProvisionApi" />
                  <ComboBoxItem Content="WinGet CLI" Tag="WingetCli" />
                </ComboBox>
              </Grid>
            </Border>
            <TextBlock Text="Atualizações do aplicativo" Margin="0,8,0,8" FontSize="18" FontWeight="SemiBold" />
            <Border x:Name="AppUpdateCard" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Verificar atualizações" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateSubtitleText" Text="{Binding UpdateSubtitle}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Cancelar verificação" Style="{StaticResource StoreActionButtonStyle}" Command="{Binding CheckUpdateCancelCommand}" Visibility="{Binding CheckUpdateCommand.CanBeCanceled, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="Cancelar download" Style="{StaticResource StoreActionButtonStyle}" Command="{Binding InstallUpdateCancelCommand}" Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button x:Name="CheckUpdateButton" AutomationProperties.AutomationId="CheckUpdateButton" IsEnabled="{Binding CanCheckUpdate}" Visibility="{Binding CheckUpdateCommand.CanBeCanceled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" Content="Verificar agora" Style="{StaticResource StoreActionButtonStyle}" Command="{Binding CheckUpdateCommand}" />
                    <Button Content="Baixar atualização" IsEnabled="{Binding CanInstallUpdate}" Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource StoreActionButtonStyle}" Command="{Binding InstallUpdateCommand}" />
                  </StackPanel>
                </Grid>
                <HyperlinkButton Content="Abrir página da release" Command="{Binding OpenReleaseCommand}" Visibility="{Binding HasPendingUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Text="{Binding UpdateAvailableText}"
                    FontSize="13"
                    Foreground="{ThemeResource SystemAccentColorPrimaryBrush}"
                    TextWrapping="Wrap"
                    Margin="0,8,0,0"
                    Visibility="{Binding HasPendingUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ProgressBar
                    Value="{Binding UpdateProgress}"
                    Maximum="1"
                    Height="4"
                    Margin="0,8,0,0"
                    Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
              </StackPanel>
            </Border>
            <TextBlock Text="Privacidade e gerenciamento" Margin="0,8,0,8" FontSize="18" FontWeight="SemiBold" />
            <Border x:Name="PrivacyCard" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <controls:WrapPanel>
                <Button Content="Abrir pasta de logs" Style="{StaticResource StoreActionButtonStyle}" Margin="0,0,8,8" Command="{Binding OpenLogsCommand}">
                                    </Button>
                <Button Content="Restaurar padrões" Style="{StaticResource StoreActionButtonStyle}" Margin="0,0,0,8" Command="{Binding ResetPreferencesCommand}">
                                    </Button>
              </controls:WrapPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="PanelInterface" Visibility="Collapsed">
            <TextBlock Text="Aparência" Margin="0,0,0,8" FontSize="18" FontWeight="SemiBold" />
            <Border x:Name="ThemeCard" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Tema do aplicativo" FontWeight="SemiBold" />
                  <TextBlock Text="Escolha o esquema de cores da interface." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <controls:WrapPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button x:Name="LightThemeButton" AutomationProperties.AutomationId="LightThemeButton" Content="Claro" Style="{StaticResource StoreActionButtonStyle}" Margin="0,0,8,0" Command="{Binding LightThemeCommand}" />
                  <Button x:Name="DarkThemeButton" AutomationProperties.AutomationId="DarkThemeButton" Content="Escuro" Style="{StaticResource StoreActionButtonStyle}" Margin="0,0,8,0" Command="{Binding DarkThemeCommand}" />
                  <Button x:Name="SystemThemeButton" AutomationProperties.AutomationId="SystemThemeButton" Content="Sistema" Style="{StaticResource StoreActionButtonStyle}" Command="{Binding SystemThemeCommand}" />
                </controls:WrapPanel>
              </Grid>
            </Border>
            <TextBlock Text="Inicialização" Margin="0,8,0,8" FontSize="18" FontWeight="SemiBold" />
            <Border x:Name="StartupCard" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Iniciar com o Windows" FontWeight="SemiBold" />
                  <TextBlock Text="Executa atualizações automáticas pela CLI ao entrar nesta conta do Windows, sem abrir a interface." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <ToggleSwitch x:Name="LaunchAtStartupSwitch" AutomationProperties.AutomationId="LaunchAtStartupSwitch" IsOn="{Binding LaunchAtStartup, Mode=OneWay}" Grid.Column="1" OnContent="Ativado" OffContent="Desativado" Toggled="LaunchAtStartupSwitch_Toggled" AutomationProperties.Name="Iniciar com o Windows" />
              </Grid>
            </Border>
          </StackPanel>
          <StackPanel x:Name="PanelElevator" Visibility="Collapsed">
            <Border x:Name="ElevationCacheCard" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="12">
                <ToggleSwitch Header="Permitir pedidos de administrador pelo Elevator" IsEnabled="{Binding CanEditElevator}" IsOn="{Binding AllowElevator, Mode=TwoWay}" OnContent="Permitidos" OffContent="Bloqueados" AutomationProperties.Name="Permitir elevação pelo WinProvision Elevator" />
                <TextBlock Text="Bloquear impede novos pedidos feitos pelo helper na interface e na CLI, inclusive na atualização de uma instalação de máquina do próprio app. Instaladores e serviços do Windows podem solicitar sua própria autorização." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Button x:Name="SaveElevatorOptionsButton" Content="Salvar opção" Command="{Binding SaveElevatorOptionsCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <Border Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="Autorização desta sessão" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="A autorização é reutilizada automaticamente por 5 minutos de inatividade e encerrada ao fechar o aplicativo. A interface permanece sem privilégios de administrador. Esta sessão não compartilha autorização com outras execuções da CLI." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <controls:WrapPanel>
                  <Button x:Name="AuthorizeElevationButton" Content="Autorizar nesta sessão" Command="{Binding AuthorizeElevationCommand}" Style="{StaticResource StoreActionButtonStyle}" AutomationProperties.AutomationId="AuthorizeElevationButton" Margin="0,0,8,8" />
                  <Button x:Name="RevokeElevationButton" Content="Encerrar autorização" Command="{Binding RevokeElevationCommand}" Style="{StaticResource StoreActionButtonStyle}" Margin="0,0,0,8" />
                </controls:WrapPanel>
                <TextBlock Text="{Binding ElevationCacheMessage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="Estado e integridade" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ElevatorIntegrityMessage}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="A verificação e a consulta de estado não pedem autorização administrativa." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Button x:Name="RefreshElevatorButton" Content="Verificar e atualizar estado" Command="{Binding RefreshElevatorCommand}" Style="{StaticResource StoreActionButtonStyle}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="PanelMaintenance" Visibility="Collapsed">
            <TextBlock Text="Manutenção agendada" Margin="0,0,0,8" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Verifique e atualize seus aplicativos mesmo com esta janela fechada. As tarefas executam enquanto esta conta estiver conectada ao Windows." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />
            <Border x:Name="ScheduledMaintenanceCard" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="12">
                <ToggleSwitch IsEnabled="{Binding CanEditMaintenance}" Header="Verificar atualizações de aplicativos" AutomationProperties.AutomationId="ScheduledUpdatesEnabledSwitch" AutomationProperties.Name="Ativar manutenção agendada" IsOn="{Binding ScheduledUpdatesEnabled, Mode=TwoWay}" OnContent="Ativada" OffContent="Desativada" />
                <ComboBox IsEnabled="{Binding CanEditMaintenance}" Header="Ao encontrar atualizações" SelectedValuePath="Tag" SelectedValue="{Binding ScheduledUpdateMode, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Ação da manutenção agendada">
                  <ComboBoxItem Content="Verificar e apenas avisar" Tag="NotifyOnly" />
                  <ComboBoxItem Content="Instalar as atualizações disponíveis" Tag="InstallAutomatically" />
                </ComboBox>
                <ComboBox IsEnabled="{Binding CanEditMaintenance}" Header="Aplicativos para atualizar" SelectedValuePath="Tag" SelectedValue="{Binding ScheduledUpdateScope, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Aplicativos da manutenção agendada">
                  <ComboBoxItem Content="Todos os aplicativos compatíveis" Tag="AllSupportedPackages" />
                  <ComboBoxItem Content="Somente aplicativos selecionados" Tag="SelectedPackagesOnly" />
                </ComboBox>
                <TextBlock Text="A seleção pode ser alterada no menu do aplicativo em Aplicativos instalados. Versões ignoradas continuam sendo respeitadas. O Windows pode solicitar autorização administrativa." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="12">
                <ComboBox IsEnabled="{Binding CanEditMaintenance}" Header="Repetição" x:Name="MaintenanceFrequencyComboBox" AutomationProperties.AutomationId="MaintenanceFrequencyComboBox" SelectedValuePath="Tag" SelectedValue="{Binding ScheduledUpdateFrequency, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Repetição da manutenção">
                  <ComboBoxItem Content="Ao entrar no Windows" Tag="AtLogon" />
                  <ComboBoxItem Content="Em um intervalo fixo" Tag="Interval" />
                  <ComboBoxItem Content="Diariamente" Tag="Daily" />
                  <ComboBoxItem Content="Semanalmente" Tag="Weekly" />
                </ComboBox>
                <ComboBox IsEnabled="{Binding CanEditMaintenance}" Header="Verificar a cada" x:Name="MaintenanceIntervalComboBox" AutomationProperties.AutomationId="MaintenanceIntervalComboBox" Visibility="{Binding IsIntervalSchedule, Converter={StaticResource BoolToVisibilityConverter}}" SelectedValuePath="Tag" SelectedValue="{Binding ScheduledUpdateInterval, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Intervalo entre verificações">
                  <ComboBoxItem Content="15 minutos" Tag="15" />
                  <ComboBoxItem Content="30 minutos" Tag="30" />
                  <ComboBoxItem Content="1 hora" Tag="60" />
                  <ComboBoxItem Content="2 horas" Tag="120" />
                  <ComboBoxItem Content="4 horas" Tag="240" />
                  <ComboBoxItem Content="12 horas" Tag="720" />
                  <ComboBoxItem Content="24 horas" Tag="1440" />
                </ComboBox>
                <TextBox IsEnabled="{Binding CanEditMaintenance}" Header="Horário local (HH:mm)" Text="{Binding ScheduledUpdateTime, Mode=TwoWay}" Visibility="{Binding IsCalendarSchedule, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.Name="Horário da manutenção" />
                <ComboBox IsEnabled="{Binding CanEditMaintenance}" Header="Dia da semana" SelectedValuePath="Tag" SelectedValue="{Binding ScheduledUpdateDay, Mode=TwoWay}" Visibility="{Binding IsWeeklySchedule, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Stretch" AutomationProperties.Name="Dia da manutenção">
                  <ComboBoxItem Content="Domingo" Tag="Sunday" /><ComboBoxItem Content="Segunda-feira" Tag="Monday" />
                  <ComboBoxItem Content="Terça-feira" Tag="Tuesday" /><ComboBoxItem Content="Quarta-feira" Tag="Wednesday" />
                  <ComboBoxItem Content="Quinta-feira" Tag="Thursday" /><ComboBoxItem Content="Sexta-feira" Tag="Friday" /><ComboBoxItem Content="Sábado" Tag="Saturday" />
                </ComboBox>
                <ToggleSwitch IsEnabled="{Binding CanEditMaintenance}" Header="Notificações do Windows" IsOn="{Binding ScheduledUpdateNotifications, Mode=TwoWay}" OnContent="Ativadas" OffContent="Desativadas" AutomationProperties.Name="Notificações da manutenção" />
                <TextBlock Text="Receba avisos sobre atualizações disponíveis, conclusões e falhas. Verificações sem atualizações não enviam notificações." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock Text="Execução" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ScheduledUpdateHistory}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding ScheduledUpdateNext}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Salve as alterações antes de executar agora." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <controls:WrapPanel>
                  <Button IsEnabled="{Binding CanEditMaintenance}" Content="Salvar agenda" x:Name="SaveMaintenanceButton" AutomationProperties.AutomationId="SaveMaintenanceButton" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveScheduledMaintenanceCommand}" Margin="0,0,8,8" />
                  <Button IsEnabled="{Binding CanEditMaintenance}" Content="Executar agora" x:Name="RunMaintenanceNowButton" AutomationProperties.AutomationId="RunMaintenanceNowButton" Style="{StaticResource StoreActionButtonStyle}" Command="{Binding RunScheduledMaintenanceCommand}" Margin="0,0,0,8" />
                </controls:WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="PanelNotifications" Visibility="Collapsed" Spacing="12">
          <Border x:Name="NotificationCategoriesCard" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="18">
            <StackPanel Spacing="16">
              <TextBlock Text="Categorias de notificação" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Escolha quais avisos o Windows pode mostrar. As permissões e o modo Não incomodar do sistema continuam valendo." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <ToggleSwitch Header="Atualizações disponíveis" IsOn="{Binding NotifyUpdates, Mode=TwoWay}" OnContent="Ativadas" OffContent="Desativadas" />
              <ToggleSwitch Header="Erros nas operações" IsOn="{Binding NotifyErrors, Mode=TwoWay}" OnContent="Ativados" OffContent="Desativados" />
              <ToggleSwitch Header="Operações concluídas com sucesso" IsOn="{Binding NotifySuccess, Mode=TwoWay}" OnContent="Ativadas" OffContent="Desativadas" />
              <ToggleSwitch Header="Resumos de lotes" IsOn="{Binding NotifyBatchSummary, Mode=TwoWay}" OnContent="Ativados" OffContent="Desativados" />
              <TextBlock Text="Lotes com falhas usam a categoria Erros. A manutenção agendada também respeita seu próprio controle de notificações." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <Button x:Name="SaveNotificationCategoriesButton" Content="Salvar notificações" Command="{Binding SaveNotificationsCommand}" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="PanelExecution" Visibility="Collapsed" Spacing="12">
          <Border x:Name="ConcurrencyCard" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Text="Operações simultâneas" FontSize="18" FontWeight="SemiBold" />
              <ComboBox Header="Instalações, atualizações e remoções na interface" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{Binding ParallelOperations, Mode=TwoWay}">
                <ComboBoxItem Content="1 (padrão)" Tag="1" />
                <ComboBoxItem Content="2" Tag="2" />
                <ComboBoxItem Content="3" Tag="3" />
                <ComboBoxItem Content="4" Tag="4" />
              </ComboBox>
              <ComboBox Header="Downloads avulsos de instaladores" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{Binding ParallelDownloads, Mode=TwoWay}">
                <ComboBoxItem Content="1" Tag="1" />
                <ComboBoxItem Content="2" Tag="2" />
                <ComboBoxItem Content="3 (padrão)" Tag="3" />
                <ComboBoxItem Content="4" Tag="4" />
                <ComboBoxItem Content="6" Tag="6" />
                <ComboBoxItem Content="8" Tag="8" />
              </ComboBox>
              <TextBlock Text="Uma operação por vez é o padrão recomendado. Alguns instaladores e o Office possuem bloqueios próprios. Reduzir o limite não interrompe tarefas iniciadas. Os limites valem por processo; lotes da CLI mantêm a execução sequencial." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Border>
          <Border x:Name="InstallerDownloadsCard" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Text="Instaladores baixados" FontSize="18" FontWeight="SemiBold" />
              <TextBox Header="Pasta padrão" Text="{Binding DownloadDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Usar Downloads; na interface, perguntar a cada lote" TextWrapping="Wrap" />
              <controls:WrapPanel>
                <Button Content="Escolher pasta" Command="{Binding PickDownloadDirectoryCommand}" />
                <Button Content="Usar padrão" Command="{Binding DefaultDownloadDirectoryCommand}" />
              </controls:WrapPanel>
              <ComboBox Header="Nome dos instaladores" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{Binding InstallerNames, Mode=TwoWay}">
                <ComboBoxItem Content="Nome original" Tag="Original" />
                <ComboBoxItem Content="ID e versão (padrão)" Tag="PackageVersion" />
                <ComboBoxItem Content="ID, versão e arquitetura" Tag="PackageVersionArchitecture" />
              </ComboBox>
              <TextBlock Text="Exemplo: Fabricante.App-2.4-x64.exe. Quando o WinGet não informa a versão ou arquitetura, o nome fornecido por ele é preservado com o ID. Arquivos existentes nunca são sobrescritos; nomes repetidos recebem um número." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Text="A pasta se aplica aos downloads avulsos de instaladores. Destinos explícitos têm prioridade. Mídia offline, arquivos temporários de instalação e a atualização do próprio app mantêm seus destinos próprios." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Border>
          <Button x:Name="SaveExecutionOptionsButton" Content="Salvar operações e downloads" Command="{Binding SaveExecutionOptionsCommand}" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
        <StackPanel x:Name="PanelOperations" Visibility="Collapsed">
            <TextBlock Text="Catálogo de aplicativos" Margin="0,0,0,8" FontSize="18" FontWeight="SemiBold" />
            <Border x:Name="CatalogRefreshCard" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Atualizar catálogo" FontWeight="SemiBold" />
                  <TextBlock Text="Busca os aplicativos e versões mais recentes sem limpar os instaladores e imagens em cache." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="RefreshCatalogButton" Grid.Column="1" Content="Atualizar catálogo" AutomationProperties.AutomationId="RefreshCatalogButton"
                        Style="{StaticResource StoreActionButtonStyle}" Command="{Binding RefreshCatalogCommand}" />
              </Grid>
            </Border>
            <TextBlock Text="Espaço ocupado" Margin="0,8,0,8" FontSize="18" FontWeight="SemiBold" />
            <Border x:Name="CacheCard" Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock Text="Ícones e imagens" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ImagesCacheUsage}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding ImagesMemoryUsage}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <controls:WrapPanel>
                  <Button x:Name="MeasureCacheButton" Content="Atualizar medição" Command="{Binding MeasureCacheCommand}" Style="{StaticResource StoreActionButtonStyle}" Margin="0,0,8,0" />
                  <Button Content="Liberar memória" Command="{Binding ReleaseImageMemoryCommand}" Style="{StaticResource StoreActionButtonStyle}" Margin="0,0,8,0" />
                  <Button x:Name="ClearImagesCacheButton" Content="Limpar somente imagens" Command="{Binding ClearImagesCacheCommand}" Style="{StaticResource StoreActionButtonStyle}" />
                </controls:WrapPanel>
                <TextBlock Text="A limpeza libera o cache de imagens da memória e do disco. Imagens visíveis podem permanecer até recarregar a página. Coleções, preferências e instaladores são preservados." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="Cache de imagens no disco" FontSize="15" FontWeight="SemiBold" />
                <ComboBox x:Name="ImageCacheLimitComboBox" Header="Limite de espaço para imagens baixadas" IsEnabled="{Binding CanEditCache}" SelectedValuePath="Tag" SelectedValue="{Binding ImageCacheLimit, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Limite do cache de imagens">
                  <ComboBoxItem Content="64 MB" Tag="64" /><ComboBoxItem Content="128 MB" Tag="128" /><ComboBoxItem Content="256 MB" Tag="256" />
                  <ComboBoxItem Content="512 MB (padrão)" Tag="512" /><ComboBoxItem Content="1 GB" Tag="1024" /><ComboBoxItem Content="2 GB" Tag="2048" />
                </ComboBox>
                <ComboBox x:Name="ImageCacheDaysComboBox" Header="Verificar se uma imagem mudou após" IsEnabled="{Binding CanEditCache}" SelectedValuePath="Tag" SelectedValue="{Binding ImageCacheDays, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Prazo para revalidar imagens">
                  <ComboBoxItem Content="1 dia" Tag="1" /><ComboBoxItem Content="3 dias" Tag="3" /><ComboBoxItem Content="7 dias" Tag="7" />
                  <ComboBoxItem Content="14 dias (padrão)" Tag="14" /><ComboBoxItem Content="30 dias" Tag="30" />
                </ComboBox>
                <TextBlock Text="A verificação ocorre quando a imagem é carregada novamente do disco. Se a rede falhar, uma cópia válida com até 60 dias pode ser reutilizada. A limpeza automática remove arquivos antigos e os menos usados para respeitar o limite; o cache em memória é ajustado ao computador." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="SaveImageCacheOptionsButton" Content="Salvar opções de imagens" Command="{Binding SaveImageCacheOptionsCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <Border Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock Text="Catálogo e metadados" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CatalogCacheUsage}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Remove índices, detalhes e métricas locais. A próxima consulta poderá precisar de internet. Para apenas buscar dados recentes, use Atualizar catálogo; imagens e instaladores não são apagados." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="ClearCatalogCacheButton" Content="Limpar catálogo e metadados" Command="{Binding ClearCatalogCacheCommand}" Style="{StaticResource StoreActionButtonStyle}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <Border Padding="18" Margin="0,0,0,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock Text="Instaladores reutilizáveis" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding InstallerCacheUsage}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Gerenciados automaticamente pelas operações de instalação. A limpeza remove os instaladores já baixados desse cache local sem afetar imagens, catálogo, coleções ou preferências." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="ClearInstallerCacheButton" Content="Limpar instaladores reutilizáveis" Command="{Binding ClearInstallerCacheCommand}" Style="{StaticResource StoreActionButtonStyle}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="3" Style="{StaticResource PageStatusBarStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <FontIcon Style="{StaticResource PageStatusIconStyle}" Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
          <TextBlock x:Name="StatusText" Text="{Binding StatusText}" Style="{StaticResource PageStatusTextStyle}" />
        </StackPanel>
        <TextBlock x:Name="VersionText" Text="{Binding VersionText}" Grid.Column="1" Margin="16,0,0,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Page>
