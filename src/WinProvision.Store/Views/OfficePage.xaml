<Page xmlns:vm="using:WinProvision.Store.ViewModels"
    xmlns:ic="using:FluentIcons.WinUI" x:Class="WinProvision.Store.Views.OfficePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:WinProvision.Store.Services"
    xmlns:controls="using:WinProvision.Store.Controls"
    x:Name="OfficeRoot"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    SizeChanged="Page_SizeChanged"
    KeyDown="Page_KeyDown"
    FontFamily="{StaticResource StoreFontFamily}"
    FontSize="13" x:DataType="vm:OfficeViewModel">
    <Page.Resources>
<conv:OfficeStatusBrushConverter x:Key="OfficeStatusBrush" />
<DataTemplate x:Key="OfficeToggleTemplate">
            <Border Style="{StaticResource OfficeAppTileSurfaceStyle}" controls:InstalledSelection.IsSelected="{Binding IsOn}" controls:FluentMotion.Kind="Entrance">
                <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                          AutomationProperties.Name="{Binding DisplayName}" AutomationProperties.AutomationId="{Binding Id}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Padding="10,0">
                    <Grid ColumnSpacing="8" Height="40" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="28" Height="28">
                            <ic:FluentIcon Icon="Document" IconVariant="Regular" IconSize="Size20" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=OfficeAppImage, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" />
                            <Image x:Name="OfficeAppImage" conv:AsyncImage.SourceUrl="{Binding IconUrl}" conv:AsyncImage.DecodePixelWidth="64" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform><ScaleTransform ScaleX="{Binding IconScale}" ScaleY="{Binding IconScale}" /></Image.RenderTransform>
                            </Image>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding CardDisplayName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding DisplayName}" />
                    </Grid>
                </CheckBox>
            </Border>
        </DataTemplate>
<DataTemplate x:Key="OfficeListTemplate">
            <Border Style="{StaticResource OfficeAppListSurfaceStyle}" controls:InstalledSelection.IsSelected="{Binding IsOn}" controls:FluentMotion.Kind="Entrance">
                <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                          AutomationProperties.Name="{Binding DisplayName}" AutomationProperties.AutomationId="{Binding Id}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Padding="10,0">
                    <Grid ColumnSpacing="8" Height="40" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="28" Height="28">
                            <ic:FluentIcon Icon="Document" IconVariant="Regular" IconSize="Size20" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=OfficeAppImage, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" />
                            <Image x:Name="OfficeAppImage" conv:AsyncImage.SourceUrl="{Binding IconUrl}" conv:AsyncImage.DecodePixelWidth="64" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform><ScaleTransform ScaleX="{Binding IconScale}" ScaleY="{Binding IconScale}" /></Image.RenderTransform>
                            </Image>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </CheckBox>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="OfficeWrapPanel"><controls:WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="OfficeListPanel"><StackPanel /></ItemsPanelTemplate>
        <DataTemplate x:Key="OfficeIconsTemplate">
            <Border Style="{StaticResource OfficeAppIconSurfaceStyle}" controls:InstalledSelection.IsSelected="{Binding IsOn}" controls:FluentMotion.Kind="Entrance">
                <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                    AutomationProperties.Name="{Binding DisplayName}" AutomationProperties.AutomationId="{Binding Id}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Padding="4,0">
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <Grid Width="40" Height="40" HorizontalAlignment="Center">
                            <ic:FluentIcon Icon="Document" IconVariant="Regular" IconSize="Size28" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=OfficeIconImage, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" />
                            <Image x:Name="OfficeIconImage" conv:AsyncImage.SourceUrl="{Binding IconUrl}" conv:AsyncImage.DecodePixelWidth="80" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform><ScaleTransform ScaleX="{Binding IconScale}" ScaleY="{Binding IconScale}" /></Image.RenderTransform>
                            </Image>
                        </Grid>
                        <TextBlock Text="{Binding DisplayName}" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center" ToolTipService.ToolTip="{Binding DisplayName}" />
                    </StackPanel>
                </CheckBox>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="OfficeStatusTemplate">
            <Border
                Padding="12,10"
                Margin="0,0,0,8"
                Background="Transparent"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="28" Height="28" VerticalAlignment="Center">
                        <ic:FluentIcon Icon="Apps" IconVariant="Regular" IconSize="Size20"
                            FontSize="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=OfficeStatusImage, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" />
                        <Image
                            x:Name="OfficeStatusImage"
                            conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                            conv:AsyncImage.DecodePixelWidth="64"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5"
                            Stretch="Uniform"
                            Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=OfficeStatusImage, Converter={StaticResource BoolVisibility}}">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="{Binding IconScale}" ScaleY="{Binding IconScale}" />
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding DisplayName}"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding DisplayName}" />
                    <Border
                        x:Name="StatusBadge"
                        Grid.Column="2"
                        Padding="9,4"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="{Binding StatusKind, Converter={StaticResource OfficeStatusBrush}}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Tag="{Binding StatusKind}">
                        <TextBlock
                            Text="{Binding StatusText}"
                            Foreground="{Binding StatusKind, Converter={StaticResource OfficeStatusBrush}}"
                            FontSize="12"
                            FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="OfficeLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="OfficeComboBoxStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>
    </Page.Resources>
    <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="{StaticResource PageContentMaxWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PageHeaderIconTileStyle}">
                <ic:FluentIcon Icon="Document" IconSize="Size24" IconVariant="Color" Style="{StaticResource PageHeaderSymbolIconStyle}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="OfficePageTitle" Text="Microsoft Office" Style="{StaticResource FluentPageTitleStyle}" />
                <TextBlock x:Name="OfficePageSubtitle"
                    Text="Instale, personalize, atualize ou remova o Microsoft Office."
                    Style="{StaticResource FluentPageSubtitleStyle}"
                    Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource PageToolbarContainerStyle}">
            <ScrollViewer x:Name="OfficeToolbarScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="InstallButton" AutomationProperties.AutomationId="OfficeInstallButton" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstallSelectedProducts}" Style="{StaticResource OfficePrimaryActionButtonStyle}" Height="34" Padding="10,0" Margin="0,0,6,0" FontSize="12" ToolTipService.ToolTip="Instalar os produtos do Office selecionados que ainda não estão presentes">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="ArrowSquareDown" IconVariant="Color" IconSize="Size20" />
                            <TextBlock Text="Instalar" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddToCollectionButton" AutomationProperties.AutomationId="AddToCollectionButton" Style="{StaticResource PageToolbarButtonStyle}" Command="{Binding AddToCatalogCommand}" ToolTipService.ToolTip="Adicionar este plano do Office à coleção de pacotes">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="AddCircle" IconVariant="Color" IconSize="Size16" />
                            <TextBlock Text="Coleção" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PreviewXmlButton" AutomationProperties.AutomationId="PreviewXmlButton" Style="{StaticResource PageToolbarButtonStyle}" Command="{Binding PreviewConfigurationCommand}" ToolTipService.ToolTip="Conferir o XML que será enviado ao ODT">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="DocumentText" IconVariant="Color" IconSize="Size16" />
                            <TextBlock Text="Prévia XML" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="3,0,4,0" VerticalAlignment="Center" />
                    <Button x:Name="UninstallButton" AutomationProperties.AutomationId="OfficeUninstallButton" AutomationProperties.Name="Desinstalar produtos do Office" Style="{StaticResource PageToolbarButtonStyle}" Command="{Binding RemoveCommand}" IsEnabled="{Binding HasInstalledProducts}" ToolTipService.ToolTip="{Binding UninstallToolTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="Delete" IconVariant="Regular" IconSize="Size16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="Desinstalar" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenWorkFolderButton" AutomationProperties.AutomationId="OpenWorkFolderButton" AutomationProperties.Name="Abrir pasta de trabalho do Office Deployment Tool" Style="{StaticResource PageToolbarButtonStyle}" Command="{Binding OpenWorkFolderCommand}" ToolTipService.ToolTip="Abrir a pasta de trabalho do Office Deployment Tool">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="DocumentFolder" IconVariant="Color" IconSize="Size16" />
                            <TextBlock Text="Abrir pasta" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <ScrollViewer
            x:Name="OfficeContentScrollViewer"
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" controls:FluentMotion.Kind="Entrance">
                <Grid x:Name="OfficeColumns" ColumnSpacing="0" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="OfficeMainColumn" Width="7.25*" />
                        <ColumnDefinition x:Name="OfficeColumnGap" Width="8" />
                        <ColumnDefinition x:Name="OfficeInstalledColumn" Width="2.75*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="OfficeFirstRow" Height="Auto" />
                        <RowDefinition x:Name="OfficeSecondRow" Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="ConfigurationColumn" Grid.Column="0" Spacing="16" controls:FluentMotion.Kind="Panel">
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Aplicativos da suíte" Style="{StaticResource FluentCardTitleStyle}" />
                                        <TextBlock
                                            Text="Escolha os aplicativos da suíte e inclua Visio ou Project se precisar."
                                            Style="{StaticResource Description}"
                                            Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SelectionSummary}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="SelectAppsButton" AutomationProperties.AutomationId="SelectAppsButton" Command="{Binding SelectAllAppsCommand}" Style="{StaticResource StoreActionButtonStyle}" VerticalAlignment="Top" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ic:FluentIcon Icon="Checkmark" IconVariant="Regular" IconSize="Size16" FontSize="16" />
                                            <TextBlock Text="{Binding SelectAppsActionText}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ItemsControl x:Name="OfficeAppsItemsControl" ItemsSource="{Binding AppToggleItems}" ItemTemplate="{StaticResource OfficeToggleTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel>
                                    <TextBlock Text="Configuração da instalação" Style="{StaticResource FluentCardTitleStyle}" />
                                    <TextBlock
                                        Text="Defina a edição, o canal de atualização, arquitetura e opções do instalador."
                                        Style="{StaticResource Description}"
                                        Margin="0,4,0,0" />
                                </StackPanel>
                                <Grid ColumnSpacing="18" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Categoria" Style="{StaticResource OfficeLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" DisplayMemberPath="Label" Style="{StaticResource OfficeComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="Edição" Style="{StaticResource OfficeLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan, Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource OfficeComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="Canal de atualização" Style="{StaticResource OfficeLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel, Mode=TwoWay}" DisplayMemberPath="Label" IsEnabled="{Binding IsChannelEnabled}" ToolTipService.ToolTip="{Binding ChannelToolTip}" Style="{StaticResource OfficeComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Arquitetura" Style="{StaticResource OfficeLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding ArchitectureOptions}" SelectedValuePath="Id" SelectedValue="{Binding Architecture, Mode=TwoWay}" DisplayMemberPath="Label" Style="{StaticResource OfficeComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Idioma principal" Style="{StaticResource OfficeLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Id" SelectedValue="{Binding LanguageId, Mode=TwoWay}" DisplayMemberPath="Label" Style="{StaticResource OfficeComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBlock Text="Interface do instalador" Style="{StaticResource OfficeLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding DisplayOptions}" SelectedValuePath="Id" SelectedValue="{Binding DisplayMode, Mode=TwoWay}" DisplayMemberPath="Label" Style="{StaticResource OfficeComboBoxStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="Atualizações automáticas" FontWeight="SemiBold" />
                                            <TextBlock Text="Preferência para a instalação e para o Office já instalado. Políticas da organização têm precedência." Style="{StaticResource Description}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" x:Name="AutoUpdatesToggle" AutomationProperties.AutomationId="AutoUpdatesToggle" AutomationProperties.Name="Atualizações automáticas do Office"
                                            VerticalAlignment="Center" IsOn="{Binding RequestedAutoUpdatesEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEditUpdatePreference}" Toggled="AutoUpdatesToggle_Toggled" OnContent="Ativadas" OffContent="Desativadas" />
                                    </Grid>
                                </Border>
                                <StackPanel
                                    x:Name="AdditionalProductsPanel"
                                    Spacing="10"
                                    Visibility="{Binding HasAdditionalProductSelected, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="Edições adicionais para instalar junto ao Office" Style="{StaticResource OfficeLabelStyle}" />
                                    <controls:WrapPanel Orientation="Horizontal">
                                        <StackPanel x:Name="VisioProductSelector" Width="240" Spacing="6" Margin="0,0,12,8" Visibility="{Binding HasVisioSelected, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Text="Edição do Visio" Style="{StaticResource OfficeLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding VisioProductOptions}" SelectedItem="{Binding SelectedVisioProduct, Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource OfficeComboBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel x:Name="ProjectProductSelector" Width="240" Spacing="6" Margin="0,0,12,8" Visibility="{Binding HasProjectSelected, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Text="Edição do Project" Style="{StaticResource OfficeLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding ProjectProductOptions}" SelectedItem="{Binding SelectedProjectProduct, Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource OfficeComboBoxStyle}" />
                                        </StackPanel>
                                    </controls:WrapPanel>
                                </StackPanel>
                                <Expander x:Name="AdvancedOptionsExpander" AutomationProperties.AutomationId="AdvancedOptionsExpander" Header="Opções avançadas" IsExpanded="{Binding IsAdvancedExpanded, Mode=TwoWay}">
                                    <StackPanel Spacing="12" Margin="0,12,0,0">
                                        <ToggleSwitch x:Name="OfficeOfflineToggle" AutomationProperties.AutomationId="OfficeOfflineToggle" Header="Modo de instalação" IsOn="{Binding DownloadBeforeInstall, Mode=TwoWay}" OnContent="Offline — baixar antes" OffContent="Online — baixar durante" AutomationProperties.Name="Baixar o Office antes de instalar e incluir os arquivos locais no ZIP" />
                                        <TextBlock Text="Offline prepara os arquivos locais. Escolha o mecanismo de download em Configurações → Operações e downloads. O setup.exe entrega a configuração ao C2R, que instala o Office." Style="{StaticResource Description}" />
                                        <StackPanel>
                                            <TextBlock Text="Idiomas adicionais no mesmo produto" Style="{StaticResource OfficeLabelStyle}" />
                                            <ItemsControl ItemsSource="{Binding AdditionalLanguages}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><controls:WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Id}" IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,0,16,6" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Excluir ferramentas legadas" Style="{StaticResource OfficeLabelStyle}" />
                                            <ItemsControl ItemsSource="{Binding ExcludedComponents}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><controls:WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,0,16,6" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <CheckBox x:Name="CleanStoreEditionCheckBox" AutomationProperties.AutomationId="CleanStoreEditionCheckBox" Content="Ao remover, excluir edições UWP/AppX da Microsoft Store" IsChecked="{Binding CleanStoreEdition, Mode=TwoWay}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border
                        x:Name="InstalledProductsPanel" controls:FluentMotion.Kind="Panel"
                        Grid.Column="2"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource StoreCardCornerRadius}"
                        VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Neste computador" Style="{StaticResource FluentCardTitleStyle}" />
                                    <TextBlock Text="{Binding InstalledSummary}" Style="{StaticResource Description}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Width="36" Height="36" Padding="0" Command="{Binding RefreshInstalledCommand}" ToolTipService.ToolTip="Recarregar status de instalações" AutomationProperties.Name="Recarregar produtos instalados">
                                    <ic:FluentIcon Icon="ArrowSync" IconVariant="Color" IconSize="Size16" />
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding InstalledApps}" ItemTemplate="{StaticResource OfficeStatusTemplate}" />
                            <TextBlock
                                Text="Nenhuma instalação do Office foi encontrada no computador."
                                Style="{StaticResource Description}"
                                Visibility="{Binding HasNoInstalledProducts, Converter={StaticResource BoolVisibility}}"
                                Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border
                    x:Name="PreviewPanel" controls:FluentMotion.Kind="Panel"
                    Style="{StaticResource FluentCardStyle}"
                    Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Prévia da configuração XML" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,44,0" />
                            <Button x:Name="ClosePreviewButton" AutomationProperties.AutomationId="ClosePreviewButton" HorizontalAlignment="Right" Width="32" Height="32" Padding="0" Command="{Binding ClosePreviewCommand}" AutomationProperties.Name="Fechar prévia XML" ToolTipService.ToolTip="Fechar prévia XML (Esc)">
                                <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size16" />
                            </Button>
                        </Grid>
                        <TextBlock
                            Text="Confira a diretiva gerada antes de instalar. O XML reflete as opções selecionadas."
                            Style="{StaticResource Description}" />
                        <TextBox
                            x:Name="PreviewXmlTextBox" AutomationProperties.AutomationId="PreviewXmlTextBox"
                            Text="{Binding PreviewXml, Mode=OneWay}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            Height="280"
                            FontFamily="Cascadia Code, Consolas, Courier New"
                            FontSize="12"
                            TextWrapping="NoWrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            AutomationProperties.Name="XML da configuração Office" />
                        <controls:WrapPanel Orientation="Horizontal">
                            <Button Content="Copiar XML" Command="{Binding CopyPreviewCommand}" />
                            <Button Content="Exportar XML" Command="{Binding ExportPreviewCommand}" />
                            <Button Content="Fechar prévia" Command="{Binding ClosePreviewCommand}" />
                        </controls:WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Style="{StaticResource PageStatusBarStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <controls:StatusInfoBar Grid.Column="0" StatusMessage="{Binding StatusText}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleSplitButton x:Name="OfficeViewModeButton" AutomationProperties.AutomationId="OfficeViewModeButton" AutomationProperties.Name="Visualização em cartões" ToolTipService.ToolTip="Visualização em cartões" Click="ViewModeMain_Click" IsChecked="True">
                        <ic:FluentIcon x:Name="OfficeViewModeButtonIcon" Icon="Grid" IconVariant="Regular" IconSize="Size16" />
                        <ToggleSplitButton.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel>
                                    <Button AutomationProperties.AutomationId="OfficeListViewMode" Content="Lista" Tag="list" Click="OfficeViewMode_Click" HorizontalAlignment="Stretch" />
