<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="using:WinProvision.Store.Controls" xmlns:conv="using:WinProvision.Store.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WinProvision.Store.Views.HomePage" Background="Transparent" x:Name="HomeRoot" Loaded="Page_Loaded" Unloaded="Page_Unloaded" SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <CornerRadius x:Key="DiscoverSearchCornerRadius">18</CornerRadius>
        <Style x:Key="DiscoverSearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="CornerRadius" Value="{StaticResource DiscoverSearchCornerRadius}" />
        </Style>
        <conv:UpdatePackageIconUrlConverter x:Key="NativeAppIconUrl" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style TargetType="Button" BasedOn="{StaticResource StoreActionButtonStyle}" />
        <Style x:Key="DiscoverItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource FluentPageTitleStyle}" />
        <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource FluentCardTitleStyle}" />
        <Style x:Key="DashboardCardStyle" TargetType="Border" BasedOn="{StaticResource FluentCardStyle}" />
        <DataTemplate x:Key="AppIconTileTemplate">
            <Button Width="112" Height="112" Padding="10" Margin="0,0,8,8"
                    Style="{StaticResource DiscoverItemButtonStyle}"
                    AutomationProperties.Name="{Binding Name}"
                    AutomationProperties.AutomationId="{Binding Id}"
                    Click="StorefrontApp_Click">
                <StackPanel VerticalAlignment="Center">
                    <Grid Width="40" Height="40" HorizontalAlignment="Center">
                        <FontIcon FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=TileAppImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                        <Image x:Name="TileAppImage" Stretch="Uniform" conv:AsyncImage.SourceUrl="{Binding IconUrl, Converter={StaticResource NativeAppIconUrl}}" conv:AsyncImage.DecodePixelWidth="64" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" ToolTipService.ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="30" Margin="0,6,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="StoreBannerTileTemplate">
            <Button Click="StorefrontApp_Click" Margin="0,0,8,0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}" Background="Transparent" BorderThickness="0">
                <Grid Background="{ThemeResource AppSurfaceElevatedBrush}">
                    <Image Stretch="UniformToFill" conv:AsyncImage.SourceUrl="{Binding StoreBannerUrl}" conv:AsyncImage.DecodePixelWidth="384" />
                    <Border Background="{ThemeResource StorefrontImageScrimBrush}" />
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" ToolTipService.ToolTip="{Binding Name}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="16" />
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="StorefrontRowTemplate">
            <Button Click="StorefrontApp_Click" HorizontalAlignment="Stretch" Height="{StaticResource StorefrontRowCardHeight}" HorizontalContentAlignment="Stretch" Padding="8" Margin="0,4,8,4" AutomationProperties.Name="{Binding Name}" Background="Transparent" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="56" Height="56">
                        <FontIcon Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=DiscoverAppIcon1, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                        <Image Stretch="Uniform" x:Name="DiscoverAppIcon1" conv:AsyncImage.SourceUrl="{Binding IconUrl, Converter={StaticResource NativeAppIconUrl}}" conv:AsyncImage.DecodePixelWidth="112" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" ToolTipService.ToolTip="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Publisher}" FontSize="12" Margin="0,5,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding Source, Converter={StaticResource SourceLabel}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="· Instalado" FontSize="10" Margin="6,0,0,0" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <Grid Margin="0,4,0,0" Visibility="{Binding StoreRating, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="★" Margin="0,0,4,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding StoreRating, Converter={StaticResource FormatConverter}, ConverterParameter={StaticResource FormatPattern0}}" Margin="0,0,4,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" />
                            <TextBlock Grid.Column="2" Text="{Binding StoreRatingCount, Converter={StaticResource FormatConverter}, ConverterParameter={StaticResource FormatPattern1}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock Text="{Binding FeaturedInstallCount30d, Converter={StaticResource FormatConverter}, ConverterParameter={StaticResource FormatPattern2}}" FontSize="10" Margin="0,3,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding FeaturedInstallCount30d, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="FeaturedCategoryTemplate">
            <Border Style="{StaticResource StoreCardSurfaceStyle}" Margin="{StaticResource Spacing8}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource FluentCardTitleStyle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource StorefrontRowTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PopularAppTileTemplate">
            <Button Height="54" Margin="2" Padding="5" CornerRadius="{StaticResource ControlCornerRadius}"
                    Style="{StaticResource DiscoverItemButtonStyle}"
                    AutomationProperties.Name="{Binding Name}"
                    AutomationProperties.AutomationId="{Binding Id}"
                    Click="StorefrontApp_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="{StaticResource CompactCornerRadius}" VerticalAlignment="Center">
                        <Grid>
                            <FontIcon Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=DiscoverAppIcon2, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            <Image Stretch="Uniform" x:Name="DiscoverAppIcon2" conv:AsyncImage.SourceUrl="{Binding IconUrl, Converter={StaticResource NativeAppIconUrl}}" conv:AsyncImage.DecodePixelWidth="64" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="30" VerticalAlignment="Center" Margin="4,0,0,0" />
                </Grid>
            </Button>
        </DataTemplate>
        <Style x:Key="DashboardSideCardStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <DataTemplate x:Key="AppListTemplate">
            <Grid Margin="0,0,0,8" Height="90">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Style="{StaticResource DiscoverItemButtonStyle}"
                        AutomationProperties.Name="{Binding Name}"
                        AutomationProperties.AutomationId="{Binding Id}"
                        Click="StorefrontApp_Click">
                    <Border x:Name="SearchResultRow" Padding="12" Style="{StaticResource DashboardCardStyle}">
                        <Grid MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,12,0" CornerRadius="{StaticResource ControlCornerRadius}" VerticalAlignment="Center" Width="{Binding Source, Converter={StaticResource SourceIconSize}}" Height="{Binding Source, Converter={StaticResource SourceIconSize}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Width" Value="40" />
                                        <Setter Property="Height" Value="40" />
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <FontIcon FontSize="18" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=ListIconImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    <Image x:Name="ListIconImage" Stretch="UniformToFill" conv:AsyncImage.SourceUrl="{Binding IconUrl, Converter={StaticResource NativeAppIconUrl}}" conv:AsyncImage.DecodePixelWidth="80" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding StoreRating, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="★" FontSize="12" Foreground="#D6A644" Margin="0,0,3,0" />
                                        <TextBlock Text="{Binding StoreRating, Converter={StaticResource FormatConverter}, ConverterParameter={StaticResource FormatPattern3}}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding StoreRatingCount, Converter={StaticResource FormatConverter}, ConverterParameter={StaticResource FormatPattern4}}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="3,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" ToolTipService.ToolTip="Estrelas no GitHub" Visibility="{Binding GitHubStars, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="★" FontSize="12" Foreground="#D6A644" Margin="0,0,3,0" />
                                        <TextBlock Text="{Binding GitHubStars, Converter={StaticResource FormatConverter}, ConverterParameter={StaticResource FormatPattern5}}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Button>
                <Button Grid.Column="1" Visibility="Collapsed" Padding="14,6" Margin="12,0,0,0"
                        VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        IsHitTestVisible="{Binding IsInstalled, Converter={StaticResource InverseBooleanConverter}}"
                        Click="InstallButton_Click" Tag="{Binding}" controls:InstallAction.App="{Binding}" />
            </Grid>
        </DataTemplate>
        <conv:FormatConverter x:Key="FormatConverter" />
        <conv:EmptyVisibilityConverter x:Key="EmptyVisibility" />
        <conv:SourceLabelConverter x:Key="SourceLabel" />
        <x:String x:Key="FormatPattern0">{0:F1}</x:String>
        <x:String x:Key="FormatPattern1">· {0:N0} avaliações</x:String>
        <x:String x:Key="FormatPattern2">{0:N0} instalações nos últimos 30 dias</x:String>
        <x:String x:Key="FormatPattern3">{0:F1}</x:String>
        <x:String x:Key="FormatPattern4"> · {0:N0}</x:String>
        <x:String x:Key="FormatPattern5">{0:N0}</x:String>
        <conv:SourceIconSizeConverter x:Key="SourceIconSize" />
    </Page.Resources>
    <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PageHeaderIconTileStyle}">
                        <FontIcon Style="{StaticResource PageHeaderSymbolIconStyle}" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Descobrir" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Pesquise e instale aplicativos." Style="{StaticResource FluentPageSubtitleStyle}" Margin="0,4,0,0" />
                        <TextBlock x:Name="CatalogSyncText" Text="{Binding CatalogSyncText}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <AutoSuggestBox x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=Explicit}" Style="{StaticResource StoreSearchBoxStyle}" Grid.Column="2" VerticalAlignment="Center" Width="260" MinWidth="180" MaxWidth="340" PlaceholderText="Pesquisar aplicativos..." AutomationProperties.Name="Pesquisar aplicativos" AutomationProperties.AutomationId="DiscoverSearchBox" TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted" Padding="0" QueryIcon="Find" CornerRadius="{StaticResource DiscoverSearchCornerRadius}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" TextBoxStyle="{StaticResource DiscoverSearchTextBoxStyle}" Height="36">
                        </AutoSuggestBox>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl Grid.Column="0" x:Name="CategoryList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="CategoryFilter" Style="{StaticResource StoreCategoryFilterStyle}" IsChecked="{Binding IsSelected, Mode=OneWay}" Checked="CategoryChip_Checked" Tag="{Binding Tag}" Margin="0,0,8,8" AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Tag}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Grid Grid.Row="2">
            <ScrollViewer x:Name="BrowseScrollViewer" Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <Grid x:Name="StorefrontHeroGrid" Visibility="{Binding ShowHero, Converter={StaticResource BoolToVisibilityConverter}}" Height="440" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*" />
                            <ColumnDefinition x:Name="HeroGapColumn" Width="12" />
                            <ColumnDefinition x:Name="HeroPromotionsColumn" Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="HeroBanner" Grid.Column="0" CornerRadius="{StaticResource StoreCardCornerRadius}" Background="{ThemeResource AppSurfaceElevatedBrush}" Tapped="AppCard_Click" KeyDown="HeroBanner_KeyDown" PointerEntered="HeroBanner_PointerEntered" PointerExited="HeroBanner_PointerExited" IsTabStop="True" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="Pressione Enter ou Espaço para abrir os detalhes do aplicativo." AutomationProperties.AutomationId="DiscoverHeroBanner">
                            <Grid CornerRadius="{StaticResource StoreCardCornerRadius}">
                                <Image x:Name="HeroBannerImage" Stretch="UniformToFill" Opacity="0.86" conv:AsyncImage.SourceUrl="{Binding StoreBannerUrl}" conv:AsyncImage.DecodePixelWidth="1440" />
                                <Border Background="{ThemeResource StorefrontHeroScrimBrush}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="36,24,36,64" MaxWidth="340">
                                    <TextBlock Text="{Binding Name, FallbackValue=Descubra seu próximo aplicativo}" FontSize="32" TextWrapping="Wrap" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="{Binding Publisher, FallbackValue=Aplicativos para o seu dia a dia}" FontSize="12" Foreground="#E6EDF7" Margin="0,2,0,12" TextWrapping="Wrap" />
                                    <Button x:Name="HeroDetailsButton" Content="Ver detalhes" Click="HeroBannerDetails_Click" IsEnabled="True" HorizontalAlignment="Left" MinHeight="40" Padding="14,4" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" AutomationProperties.AutomationId="DiscoverHeroDetailsButton" />
                                </StackPanel>
                                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,12" Padding="4" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="HeroBannerPreviousButton" Padding="4" MinWidth="40" MinHeight="40" CornerRadius="{StaticResource CompactCornerRadius}" Click="HeroBannerPrevious_Click" ToolTipService.ToolTip="Banner anterior" AutomationProperties.Name="Banner anterior" AutomationProperties.AutomationId="DiscoverHeroPreviousButton" Background="Transparent" BorderThickness="0">
                                        <FontIcon FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" />
                                    </Button>
                                    <Button x:Name="HeroBannerDot0" Tag="0" Padding="4" MinWidth="40" MinHeight="40" CornerRadius="{StaticResource CompactCornerRadius}" Click="HeroBannerDot_Click" ToolTipService.ToolTip="Primeiro banner" AutomationProperties.Name="Mostrar banner 1" AutomationProperties.AutomationId="DiscoverHeroBannerDot1" Background="Transparent" BorderThickness="0">
                                        <Rectangle x:Name="HeroBannerIndicator0" Width="14" Height="4" RadiusX="2" RadiusY="2" Fill="{ThemeResource SystemAccentColorPrimaryBrush}" />
                                    </Button>
                                    <Button x:Name="HeroBannerDot1" Tag="1" Padding="4" MinWidth="40" MinHeight="40" CornerRadius="{StaticResource CompactCornerRadius}" Click="HeroBannerDot_Click" ToolTipService.ToolTip="Segundo banner" AutomationProperties.Name="Mostrar banner 2" AutomationProperties.AutomationId="DiscoverHeroBannerDot2" Background="Transparent" BorderThickness="0">
                                        <Rectangle x:Name="HeroBannerIndicator1" Width="14" Height="4" RadiusX="2" RadiusY="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                    <Button x:Name="HeroBannerDot2" Tag="2" Padding="4" MinWidth="40" MinHeight="40" CornerRadius="{StaticResource CompactCornerRadius}" Click="HeroBannerDot_Click" ToolTipService.ToolTip="Terceiro banner" AutomationProperties.Name="Mostrar banner 3" AutomationProperties.AutomationId="DiscoverHeroBannerDot3" Background="Transparent" BorderThickness="0">
                                        <Rectangle x:Name="HeroBannerIndicator2" Width="14" Height="4" RadiusX="2" RadiusY="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                    <Button x:Name="HeroBannerNextButton" Padding="4" MinWidth="40" MinHeight="40" CornerRadius="{StaticResource CompactCornerRadius}" Click="HeroBannerNext_Click" ToolTipService.ToolTip="Próximo banner" AutomationProperties.Name="Próximo banner" AutomationProperties.AutomationId="DiscoverHeroNextButton" Background="Transparent" BorderThickness="0">
                                        <FontIcon FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" />
                                    </Button>
                                    <ToggleButton x:Name="HeroRotationToggleButton" Width="40" Height="40" Padding="4"
                                                  IsChecked="True" Checked="HeroRotationToggleButton_Toggled"
                                                  Unchecked="HeroRotationToggleButton_Toggled"
                                                  ToolTipService.ToolTip="Pausar rotação automática"
                                                  AutomationProperties.Name="Pausar rotação automática"
                                                  AutomationProperties.AutomationId="DiscoverHeroRotationToggleButton">
                                        <FontIcon x:Name="HeroRotationIcon" Glyph="&#xE769;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </ToggleButton>
                                </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid x:Name="HeroPromotions" Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.7*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>
                            <Button x:Name="RightStorePromo" AutomationProperties.AutomationId="RightStorePromo" Click="StorefrontApp_Click" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}" Visibility="Collapsed" Background="Transparent" BorderThickness="0">
                                <Grid Background="{ThemeResource AppSurfaceElevatedBrush}">
                                    <Image Stretch="UniformToFill" conv:AsyncImage.SourceUrl="{Binding StoreBannerUrl}" conv:AsyncImage.DecodePixelWidth="640" />
                                    <Border Background="{ThemeResource StorefrontImageScrimBrush}" />
                                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="24" />
                                </Grid>
                            </Button>
                            <ItemsControl x:Name="SideStoreBannerList" Grid.Row="2" ItemsSource="{Binding SideStoreBannerApps}" ItemTemplate="{StaticResource StoreBannerTileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                    <controls:UniformGrid x:Name="StorefrontShelves" Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibilityConverter}}" Columns="2" Margin="0,0,0,16">
                        <Border x:Name="PopularShelfCard" Style="{StaticResource StoreCardSurfaceStyle}" Margin="0,0,8,8">
                            <StackPanel>
                                <controls:DockPanel Margin="0,0,0,16">
                                    <Button x:Name="PopularMoreButton" AutomationProperties.AutomationId="PopularMoreButton" Width="32" Height="32" Padding="0" Click="PopularMoreButton_Click" ToolTipService.ToolTip="Ver mais aplicativos populares" AutomationProperties.Name="Ver mais aplicativos populares" controls:DockPanel.Dock="Right" Background="Transparent" BorderThickness="0">
                                        <FontIcon x:Name="PopularMoreIcon" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" />
                                    </Button>
                                    <TextBlock Text="Em alta na WinProvision Store" Style="{StaticResource FluentCardTitleStyle}" VerticalAlignment="Center" />
                                </controls:DockPanel>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding PopularApps}" ItemTemplate="{StaticResource StorefrontRowTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:UniformGrid Columns="{Binding ShelfColumns, ElementName=HomeRoot}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Text="Sincronize o catálogo para identificar os aplicativos com suporte a pt-BR." Visibility="{Binding PopularApps.Count, Converter={StaticResource EmptyVisibility}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StoreCardSubtitleStyle}">
                                            </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border x:Name="StoreShelfCard" Style="{StaticResource StoreCardSurfaceStyle}" Margin="8,0,0,8">
                            <StackPanel>
                                <controls:DockPanel Margin="0,0,0,16">
                                    <Button x:Name="StoreMoreButton" AutomationProperties.AutomationId="StoreMoreButton" Width="32" Height="32" Padding="0" Click="StoreMoreButton_Click" ToolTipService.ToolTip="Ver mais aplicativos da Microsoft Store" AutomationProperties.Name="Ver mais aplicativos da Microsoft Store" controls:DockPanel.Dock="Right" Background="Transparent" BorderThickness="0">
                                        <FontIcon x:Name="StoreMoreIcon" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" />
                                    </Button>
                                    <TextBlock Text="Mais populares na Microsoft Store" Style="{StaticResource FluentCardTitleStyle}" VerticalAlignment="Center" />
                                </controls:DockPanel>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding StoreHighlights}" ItemTemplate="{StaticResource StorefrontRowTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:UniformGrid Columns="{Binding ShelfColumns, ElementName=HomeRoot}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Text="Ainda não há aplicativos com suporte a pt-BR, boas avaliações e dados suficientes no catálogo. Sincronize a Store para atualizar os dados." Visibility="{Binding StoreHighlights.Count, Converter={StaticResource EmptyVisibility}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StoreCardSubtitleStyle}">
                                            </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </controls:UniformGrid>
                    <StackPanel x:Name="StorefrontCategoriesPanel" Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding FeaturedCategories}" ItemTemplate="{StaticResource FeaturedCategoryTemplate}" Margin="{StaticResource PageSectionGap}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="FeaturedRankingInfo" Text="{Binding FeaturedRankingInfo}" Style="{StaticResource StoreCardSubtitleStyle}" Margin="{StaticResource Spacing8}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="ResultsPanel" Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ResultsTitle" Text="{Binding ResultsTitle}" Style="{StaticResource CardTitleStyle}" FontSize="18" Margin="0,0,0,12" />
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="AppsGridScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsRepeater x:Name="AppsList" ItemsSource="{Binding Apps}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout Orientation="Horizontal" x:Name="SearchCardsLayout" MinItemWidth="1" MinItemHeight="156" MaximumRowsOrColumns="3" ItemsStretch="Fill" ItemsJustification="Start" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="144" Margin="0,0,12,12">
                                        <Button Style="{StaticResource DiscoverItemButtonStyle}"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Name}"
                                                AutomationProperties.AutomationId="{Binding Id}"
                                                Click="StorefrontApp_Click">
                                            <Border x:Name="SearchResultCard" Padding="14" Style="{StaticResource DashboardCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" CornerRadius="{StaticResource ControlCornerRadius}">
                                                            <Grid>
                                                                <FontIcon FontSize="18" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=CategoryIconImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                                <Image x:Name="CategoryIconImage" Stretch="Uniform" conv:AsyncImage.SourceUrl="{Binding IconUrl, Converter={StaticResource NativeAppIconUrl}}" conv:AsyncImage.DecodePixelWidth="80" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" ToolTipService.ToolTip="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                                                            <TextBlock Text="{Binding Publisher}" ToolTipService.ToolTip="{Binding Publisher}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,0" />
                                                            <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding Source, Converter={StaticResource SourceLabel}}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="36" MaxLines="2" LineHeight="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" VerticalAlignment="Top" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"
                                                Padding="16,6" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                IsHitTestVisible="{Binding IsInstalled, Converter={StaticResource InverseBooleanConverter}}"
                                                Click="InstallButton_Click" Tag="{Binding}" controls:InstallAction.App="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <ScrollViewer x:Name="AppsListScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsRepeater ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppListTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                            </ScrollViewer>
                    <ScrollViewer x:Name="AppsIconsScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsRepeater x:Name="AppsIconsList" ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppIconTileTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout Orientation="Horizontal" MinItemWidth="120" MinItemHeight="120" ItemsStretch="Fill" ItemsJustification="Start" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <Border x:Name="EmptySearchResultPanel" Visibility="{Binding HasEmptyResults, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PageEmptyStateCardStyle}" Margin="0,8,12,12" IsHitTestVisible="False">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                                    <Border Style="{StaticResource PageEmptyStateIconTileStyle}" Width="48" Height="48">
                                        <FontIcon FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" />
                                    </Border>
                                    <TextBlock Text="Nenhum aplicativo encontrado" Style="{StaticResource PageEmptyStateTitleStyle}" />
                                    <TextBlock Text="Tente pesquisar pelo nome do aplicativo, pelo publicador ou pelo ID do pacote." Style="{StaticResource PageEmptyStateMessageStyle}" />
                                </StackPanel>
                            </Border>
                </Grid>
            </Grid>
            </Grid>
            <Border x:Name="ResultsStatusBar" Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibilityConverter}}" Grid.Row="3" Style="{StaticResource PageStatusBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="{Binding StatusText}" Style="{StaticResource PageStatusTextStyle}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Classificar por:" Style="{StaticResource PageStatusTextStyle}" Margin="0,0,8,0" />
                        <ComboBox x:Name="CatalogSortComboBox" Width="150" Height="32" SelectedIndex="0" SelectionChanged="CatalogSortComboBox_SelectionChanged" Margin="0,0,12,0" AutomationProperties.Name="Classificar aplicativos" AutomationProperties.AutomationId="DiscoverSortComboBox">
                            <ComboBoxItem Content="Popularidade" />
                            <ComboBoxItem Content="Nome" />
                            <ComboBoxItem Content="ID" />
                            <ComboBoxItem Content="Microsoft Store" />
                            <ComboBoxItem Content="WinGet" />
                        </ComboBox>
                        <ToggleButton x:Name="ListViewToggleButton" AutomationProperties.Name="Visualização em lista" AutomationProperties.AutomationId="DiscoverListViewModeButton" Style="{StaticResource UpdatesViewModeToggleStyle}" CornerRadius="{StaticResource UpdatesViewModeCornerRadius}" Click="ListViewToggleButton_Click" ToolTipService.ToolTip="Visualização em lista">
                            <FontIcon FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" />
                        </ToggleButton>
                        <ToggleButton x:Name="GridViewToggleButton" AutomationProperties.Name="Visualização em cartões" AutomationProperties.AutomationId="DiscoverGridViewModeButton" Style="{StaticResource UpdatesViewModeToggleStyle}" CornerRadius="{StaticResource UpdatesViewModeCornerRadius}" IsChecked="True" Click="GridViewToggleButton_Click" ToolTipService.ToolTip="Visualização em cartões">
                            <FontIcon FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" />
                        </ToggleButton>
                        <ToggleButton x:Name="IconsViewToggleButton" AutomationProperties.Name="Visualização em ícones" AutomationProperties.AutomationId="DiscoverIconsViewModeButton" Style="{StaticResource UpdatesViewModeToggleStyle}" CornerRadius="{StaticResource UpdatesViewModeCornerRadius}" Click="IconsViewToggleButton_Click" ToolTipService.ToolTip="Visualização em ícones">
                            <FontIcon FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
