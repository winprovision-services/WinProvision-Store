<Page xmlns:vm="using:WinProvision.Store.ViewModels" xmlns:ic="using:FluentIcons.WinUI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="using:WinProvision.Store.Controls" xmlns:services="using:WinProvision.Store.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WinProvision.Store.Views.AccountSyncPage" Background="Transparent" UseLayoutRounding="True" FontFamily="{StaticResource StoreFontFamily}" FontSize="14" Loaded="Page_Loaded" Unloaded="Page_Unloaded" x:DataType="vm:AccountSyncViewModel">
    <Page.Resources>
<services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <x:Double x:Key="AccountFormMaxWidth">900</x:Double>
  </Page.Resources>
  <Border Background="Transparent" Margin="{StaticResource PageContentMargin}" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource PageHeaderIconTileStyle}">
          <ic:FluentIcon Icon="Person" IconSize="Size24" IconVariant="Color" Style="{StaticResource PageHeaderSymbolIconStyle}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Conta &amp; Sincronização" Style="{StaticResource FluentPageTitleStyle}" x:Name="AccountPageTitle" />
          <TextBlock Text="Gerencie sua conta GitHub e seus backups." Style="{StaticResource FluentPageSubtitleStyle}" Margin="0,4,0,0" x:Name="AccountPageSubtitle" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="AccountContentScrollViewer" Grid.Row="1" MaxWidth="{StaticResource AccountFormMaxWidth}" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource StoreCardSurfaceStyle}" x:Name="AccountCard" AutomationProperties.Name="Conta GitHub">
            <StackPanel>
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                  <ic:FluentIcon Icon="Person" IconVariant="Color" IconSize="Size20" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="Conta GitHub" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="Use sua conta para sincronizar o perfil e acessar o backup na nuvem." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
              </Grid>
              <StackPanel x:Name="GitHubDisconnectedPanel" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel x:Name="OAuthInitialPanel" Visibility="{Binding IsWaitingForAuthorization, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                  <TextBlock Text="Sua conta ainda não está conectada." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                  <Button x:Name="ConnectButton" AutomationProperties.AutomationId="ConnectButton" HorizontalAlignment="Left" IsEnabled="{Binding CanStartAuthentication}" Style="{StaticResource PagePrimaryActionButtonStyle}" Command="{Binding ConnectCommand}">
                    <StackPanel Orientation="Horizontal">
                      <ic:FluentIcon Icon="LinkMultiple" IconVariant="Color" IconSize="Size16" FontSize="16" Margin="0,0,8,0" />
                      <TextBlock Text="Conectar ao GitHub" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <StackPanel x:Name="OAuthWaitingPanel" Visibility="{Binding IsWaitingForAuthorization, Converter={StaticResource BoolToVisibilityConverter}}">
                  <TextBlock Text="Abra o endereço abaixo e informe o código para autorizar o acesso." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                  <HyperlinkButton x:Name="OAuthVerificationLink" AutomationProperties.AutomationId="OAuthVerificationLink" Content="github.com/login/device" Tag="https://github.com/login/device" HorizontalAlignment="Left" Margin="0,0,0,12" Click="VerificationLink_Click" />
                  <Border CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,10" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="OAuthUserCodeText" Text="{Binding UserCode}" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColorPrimaryBrush}" Margin="0,0,12,0" />
                      <Button Style="{StaticResource StoreActionButtonStyle}" MinHeight="32" Padding="10,0" Click="CopyOAuthCodeButton_Click" ToolTipService.ToolTip="Copiar código" x:Name="CopyOAuthCodeButton" AutomationProperties.AutomationId="CopyOAuthCodeButton" AutomationProperties.Name="Copiar código de autorização">
                        <ic:FluentIcon Icon="Clipboard" IconVariant="Color" IconSize="Size16" FontSize="16" />
                      </Button>
                    </StackPanel>
                  </Border>
                  <ProgressRing Width="18" Height="18" Margin="0,0,0,10" HorizontalAlignment="Left" Foreground="{ThemeResource SystemAccentColorPrimaryBrush}" IsActive="{Binding IsAuthenticating}" />
                  <Button x:Name="CancelOAuthButton" AutomationProperties.AutomationId="CancelOAuthButton" HorizontalAlignment="Left" Style="{StaticResource StoreActionButtonStyle}" Command="{Binding CancelAuthenticationCommand}">
                    <StackPanel Orientation="Horizontal">
                      <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size16" FontSize="16" Margin="0,0,8,0" />
                      <TextBlock Text="Cancelar" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="GitHubConnectedPanel" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource SystemAccentColorPrimaryBrush}" controls:RoundedClip.IsEnabled="True">
                    <Grid>
                      <ic:FluentIcon Icon="Person" IconVariant="Color" IconSize="Size28" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding (services:AsyncImage.HasContent), ElementName=AvatarImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                      <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="{Binding (services:AsyncImage.HasContent), ElementName=AvatarImage, Converter={StaticResource BoolToVisibilityConverter}}" services:AsyncImage.SourceUrl="{Binding AvatarUrl}" services:AsyncImage.DecodePixelWidth="112" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectedLoginText" Text="{Binding ConnectedLogin}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Conta GitHub conectada" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,3,0,0" />
                  </StackPanel>
                  <Button x:Name="DisconnectButton" AutomationProperties.AutomationId="DisconnectButton" Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource StoreActionButtonStyle}" Command="{Binding DisconnectCommand}" ToolTipService.ToolTip="Desvincular conta">
                    <StackPanel Orientation="Horizontal">
                      <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size16" FontSize="16" Margin="0,0,8,0" />
                      <TextBlock Text="Desvincular" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,16" />
                <Grid x:Name="SyncDetailsGrid">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ic:FluentIcon Icon="ArrowSync" IconVariant="Color" IconSize="Size16" FontSize="16" Margin="0,0,8,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Sincronização" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SyncActiveText" Text="Ativa ●" Margin="8,0,0,0" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" x:Name="LastSyncPanel">
                    <ic:FluentIcon Icon="History" IconVariant="Color" IconSize="Size16" FontSize="16" Margin="0,0,8,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Última sincronização:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="LastSyncText" Text="{Binding LastSyncText}" Margin="6,0,0,0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StoreCardSurfaceStyle}" x:Name="BackupCard" AutomationProperties.Name="Backup e restauração">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                  <ic:FluentIcon Icon="Cloud" IconVariant="Color" IconSize="Size20" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="Backup e restauração" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="Sincronize suas coleções com a conta conectada. Para importar ou exportar JSON e importar da nuvem, use Pacotes." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
              </Grid>
              <ToggleSwitch Header="Backup automático no Gist" OnContent="Ativado" OffContent="Desativado" IsOn="{Binding AutomaticCloudBackupEnabled, Mode=TwoWay}" Margin="52,0,0,12" AutomationProperties.AutomationId="AutomaticCloudBackupToggle" />
              <controls:WrapPanel Margin="52,0,0,0" x:Name="AccountActionsPanel">
                <Button x:Name="BackupButton" AutomationProperties.AutomationId="BackupButton" IsEnabled="{Binding CanSaveBackup}" Style="{StaticResource StoreActionButtonStyle}" Margin="0,0,8,8" Command="{Binding SaveBackupCommand}">
                  <StackPanel Orientation="Horizontal">
                    <ic:FluentIcon Icon="Cloud" IconVariant="Color" IconSize="Size16" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="Fazer backup" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </controls:WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StoreCardSurfaceStyle}" x:Name="CloudFilesCard" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.Name="Arquivos JSON na nuvem">
            <StackPanel Spacing="10">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Backups no GitHub" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="Expanda um backup para ver seus aplicativos. Selecione um arquivo para importar ou excluir." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Atualizar" Command="{Binding RefreshCloudFilesCommand}" IsEnabled="{Binding CanRefreshCloudFiles}" Style="{StaticResource StoreActionButtonStyle}" AutomationProperties.AutomationId="RefreshCloudFilesButton" />
              </Grid>
              <ListView x:Name="CloudFilesList" ItemsSource="{Binding CloudFiles}" SelectedItem="{Binding SelectedCloudFile, Mode=TwoWay}" MaxHeight="420" SelectionMode="Single" AutomationProperties.AutomationId="CloudFilesList">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Expander HorizontalAlignment="Stretch">
                      <Expander.Header>
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Details}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding FileName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Expander.Header>
                      <StackPanel Spacing="8" Padding="8,4,8,8">
                        <TextBlock Text="{Binding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Collections}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Spacing="4" Margin="0,4,0,8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AppCount}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding Apps}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <StackPanel Margin="12,2,0,4">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Details}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Expander>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <controls:WrapPanel>
                <Button Content="Importar selecionado" Command="{Binding RestoreSelectedCloudFileCommand}" IsEnabled="{Binding CanRestoreSelectedCloudFile}" Style="{StaticResource StoreActionButtonStyle}" Margin="0,0,8,8" AutomationProperties.AutomationId="ImportSelectedCloudFileButton" />
                <Button Content="Excluir selecionado" Command="{Binding DeleteSelectedCloudFileCommand}" IsEnabled="{Binding CanDeleteSelectedCloudFile}" Style="{StaticResource StoreActionButtonStyle}" Margin="0,0,8,8" AutomationProperties.AutomationId="DeleteSelectedCloudFileButton" />
                <Button Content="Excluir todos os Gists do app" Command="{Binding DeleteAllAppGistsCommand}" IsEnabled="{Binding CanRefreshCloudFiles}" Style="{StaticResource StoreActionButtonStyle}" Margin="0,0,8,8" AutomationProperties.AutomationId="DeleteAllAppGistsButton" />
              </controls:WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Style="{StaticResource PageStatusBarStyle}">
        <controls:StatusInfoBar x:Name="AccountStatusText" StatusMessage="{Binding StatusText}" />
      </Border>
    </Grid>
  </Border>
</Page>
