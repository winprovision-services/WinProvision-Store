{
  "schemaVersion": 2,
  "layout": {
    "rowHeight": 48,
    "rowSpacing": 8,
    "rowHorizontalPadding": 8,
    "rowVerticalPadding": 8,
    "iconColumnWidth": 40,
    "iconSize": 32,
    "rowIconHeight": 24,
    "flexibleColumnSpacing": 12,
    "titleMaxWidthFraction": 0.4,
    "titleMaxWidth": 260,
    "titleMinWidth": 96,
    "descriptionMinWidth": 150,
    "descriptionHeight": 32,
    "actionButtonWidth": 110,
    "moreButtonWidth": 36,
    "actionButtonHeight": 32
  },
  "theme": {
    "rowCornerRadius": 4,
    "messageCornerRadius": 4,
    "progressCornerRadius": 4,
    "neutralBackgroundAlpha": 0.07,
    "attentionBackgroundAlpha": 0.1,
    "messageBackgroundAlpha": 0.18
  },
  "metrics": {
    "progressTrackHeight": 12,
    "progressHeight": 2.5,
    "messagePaddingHorizontal": 8,
    "messagePaddingTop": 7,
    "messagePaddingBottom": 4,
    "titleFontSize": 14,
    "messageFontSize": 14,
    "messageFontFamily": "Segoe UI Variable Text, Segoe UI",
    "actionFontSize": 14
  },
  "behavior": {
    "autoClose": {
      "delaySeconds": 5,
      "pauseOnPointer": true,
      "pauseOnFocus": true,
      "pauseOnPopup": true
    },
    "height": {
      "default": 240,
      "min": 120,
      "max": 480,
      "maxFractionOfContent": 0.45
    },
    "defaultExpanded": true,
    "ordering": { "mode": "pendingFirst" }
  },
  "states": {
    "queued": { "iconId": "apps", "colorToken": "OperationNeutralBackgroundBrush", "messageColorToken": "OperationDescriptionBackgroundBrush", "trackColorToken": "OperationProgressTrackTransparentBrush", "fillColorToken": "AppOperationDefaultBrush", "messageFont": "messageDefault", "messageFontWeight": "normal", "progress": { "mode": "indeterminate", "visible": true } },
    "running": { "iconId": "apps", "colorToken": "OperationAttentionBackgroundBrush", "messageColorToken": "OperationDescriptionBackgroundBrush", "trackColorToken": "OperationProgressTrackTransparentBrush", "fillColorToken": "AppOperationDefaultBrush", "messageFont": "messageDefault", "messageFontWeight": "normal", "progress": { "mode": "indeterminate", "visible": true } },
    "completed": { "iconId": "apps", "colorToken": "AppOperationSuccessSurfaceBrush", "messageColorToken": "OperationDescriptionBackgroundBrush", "trackColorToken": "OperationProgressTrackTransparentBrush", "fillColorToken": "AppOperationSuccessBrush", "messageFont": "messageDefault", "messageFontWeight": "normal", "progress": { "mode": "complete", "visible": true } },
    "failed": { "iconId": "apps", "colorToken": "AppOperationFailureSurfaceBrush", "messageColorToken": "OperationDescriptionBackgroundBrush", "trackColorToken": "OperationProgressTrackTransparentBrush", "fillColorToken": "AppOperationFailureBrush", "messageFont": "messageDefault", "messageFontWeight": "normal", "progress": { "mode": "none", "visible": false } },
    "canceled": { "iconId": "apps", "colorToken": "AppOperationCanceledSurfaceBrush", "messageColorToken": "OperationDescriptionBackgroundBrush", "trackColorToken": "OperationProgressTrackTransparentBrush", "fillColorToken": "AppOperationCanceledBrush", "messageFont": "messageDefault", "messageFontWeight": "normal", "progress": { "mode": "none", "visible": false } },
    "unconfirmed": { "iconId": "apps", "colorToken": "OperationNeutralBackgroundBrush", "messageColorToken": "OperationDescriptionBackgroundBrush", "trackColorToken": "OperationProgressTrackTransparentBrush", "fillColorToken": "AppOperationDefaultBrush", "messageFont": "messageDefault", "messageFontWeight": "normal", "progress": { "mode": "none", "visible": false } }
  },
  "managerIcons": { "winget": "managerWinget", "chocolatey": "managerChocolatey", "office": "managerOffice", "default": "apps" },
