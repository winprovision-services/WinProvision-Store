<UserControl
    x:Class="WinProvision.Store.Controls.ManagerLogViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="ViewerRoot" RowDefinitions="Auto,*,Auto" RowSpacing="4" Margin="8" SizeChanged="ViewerRoot_SizeChanged">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,*,Auto" VerticalAlignment="Center">
      <Button x:Name="CopyButton" Grid.Column="0" Content="Copiar para a área de transferência" Click="Copy_Click" CornerRadius="6,0,0,6" AutomationProperties.Name="Copiar para a área de transferência"/>
      <Button x:Name="ExportButton" Grid.Column="1" Content="Exportar para um arquivo" Click="Export_Click" CornerRadius="0,6,6,0" AutomationProperties.Name="Exportar para um arquivo"/>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="LogLevelLabel" Text="Nível de log:" FontSize="14" VerticalAlignment="Center"/>
        <ComboBox x:Name="SourceSelector" Width="320" HorizontalAlignment="Center" SelectionChanged="Source_SelectionChanged"
                  AutomationProperties.LabeledBy="{Binding ElementName=LogLevelLabel}"/>
      </StackPanel>
      <Button x:Name="ReloadButton" Grid.Column="5" Margin="0,0,12,0" Content="Recarregar log" Click="Reload_Click" AutomationProperties.Name="Recarregar log"/>
    </Grid>
    <Grid Grid.Row="1">
      <Border CornerRadius="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <RichEditBox x:Name="LogDocument" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Consolas" FontSize="12" Padding="8" BorderThickness="0"
                     Background="Transparent" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Enabled"/>
      </Border>
      <ProgressRing x:Name="LoadingRing" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="8,2,8,0" FontSize="11"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="" TextTrimming="CharacterEllipsis"/>
  </Grid>
</UserControl>
