<UserControl x:Class="WinProvision.Store.Controls.OperationsQueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WinProvision.Store.Controls"
             xmlns:conv="using:WinProvision.Store.Services"
             x:Name="Root"
             FontFamily="{StaticResource StoreFontFamily}"
             FontSize="14"
             MaxHeight="340"
             HorizontalAlignment="Stretch"
             KeyDown="Root_KeyDown">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:WingetMethodBrushConverter x:Key="WingetMethodBrushConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
    <Grid x:Name="ShadowHost" IsHitTestVisible="False">
        <Rectangle x:Name="ShadowCaster" Fill="White" RadiusX="8" RadiusY="8" Opacity="0"/>
    </Grid>
    <Border x:Name="QueueSurface" Background="{ThemeResource QueueSurfaceBrush}"
            BorderBrush="{ThemeResource QueueCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Height="44"
                  Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                
                <ToggleButton x:Name="ExpanderToggle" AutomationProperties.AutomationId="ExpanderToggle"
                              Grid.Column="0"
                              Width="32"
                              Height="32"
                              Padding="0"
                              IsChecked="{Binding IsQueueExpanded, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              ToolTipService.ToolTip="Expandir ou recolher operações"
                              AutomationProperties.Name="Expandir ou recolher operações">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent"
                                    CornerRadius="{StaticResource CompactCornerRadius}"
                                    x:Name="ToggleBorder">
                                <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ToggleBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"/><VisualState x:Name="Disabled"/></VisualStateGroup></VisualStateManager.VisualStateGroups>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon x:Name="ChevronIcon"
                                                   Glyph="{Binding ExpanderGlyph}" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                   FontSize="12"
                                                   Opacity="0.75" />
                                    
                                    <Rectangle x:Name="FailedBadge"
                                               Width="6"
                                               Height="6"
                                               Fill="{ThemeResource AppOperationFailureBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Margin="0,-2,-2,0"
                                               Visibility="{Binding ShowFailureBadge, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                            
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <TextBlock Grid.Column="1"
                           Text="{Binding HeaderText}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="8,0,8,0" />

                
                <Button x:Name="BulkMenuButton" AutomationProperties.AutomationId="BulkMenuButton"
                           Grid.Column="2"
                           Style="{StaticResource StoreActionButtonStyle}"
                           Width="34"
                           Height="34"
                           Padding="0"
                           Margin="0,0,4,0"
                           Background="Transparent"
                           BorderThickness="0"
                           ToolTipService.ToolTip="Mais ações da fila"
                           AutomationProperties.Name="Mais ações da fila"
                           Click="BulkMenuButton_Click">
                    <FontIcon Glyph="&#xE712;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
                </Button>

                <Button Grid.Column="3"
                           Style="{StaticResource StoreActionButtonStyle}"
                           Width="34"
                           Height="34"
                           Padding="0"
                           Background="Transparent"
                           BorderThickness="0"
                           ToolTipService.ToolTip="Fechar painel de operações"
                           AutomationProperties.Name="Fechar painel de operações"
                           Click="ClosePanelButton_Click">
                    <SymbolIcon Symbol="Cancel" Width="16" Height="16" />
                </Button>
            </Grid>

            <Border Grid.Row="0"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            
            <ScrollViewer Grid.Row="1"
                          MaxHeight="280"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsChecked, ElementName=ExpanderToggle, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Items}" x:Name="OperationsList" Margin="10,8,10,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12,10"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource QueueCardBorderBrush}"
                                    Background="{ThemeResource QueueCardBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    
                                    <Border Grid.Column="0"
                                            Width="32"
                                            Height="28"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="{StaticResource CompactCornerRadius}"
                                            Background="Transparent">
                                        <Grid>
                                            
                                            <FontIcon Glyph="&#xE7B8;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                           FontSize="22"
                                                           Foreground="{Binding Method, Converter={StaticResource WingetMethodBrushConverter}}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=OperationImage, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                            
                                            <Image x:Name="OperationImage"
                                                   Stretch="Uniform"
                                                   conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                                   Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=OperationImage, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>

                                    
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0">

                                        
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13.5"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        
                                        <Button Margin="0,2,0,0"
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="Clique para ver os detalhes da saída no terminal"
                                                Click="LiveLineButton_Click"
                                                Tag="{Binding}">
                                            <TextBlock Text="{Binding LiveLine}"
                                                       FontSize="11"
                                                       Opacity="0.75"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Button>

                                        
                                        <ProgressBar x:Name="OperationProgress"
                                                     Style="{StaticResource QueueProgressBarStyle}"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Foreground="{Binding Method, Converter={StaticResource WingetMethodBrushConverter}}"
                                                     Height="3"
                                                     Margin="0,4,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding Progress, Mode=OneWay}"
                                                     Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                                        
                                        <controls:OperationStatusBadge x:Name="StatusBadge" Margin="0,4,0,0" HorizontalAlignment="Left"
                                        State="{Binding State}" Text="{Binding UserFacingStatusText}"
                                        Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    
                                    <Border Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Height="28"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource QueueSubtleBorderBrush}"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            
                                            <Button Content="{Binding ButtonText}"
                                                       Command="{Binding ActionCommand}"
                                                       CornerRadius="0"
                                                       Height="28"
                                                       Padding="12,0"
                                                       FontSize="12"
                                                       Background="Transparent"
                                                       BorderThickness="0"
                                                       VerticalAlignment="Stretch"
                                                       VerticalContentAlignment="Center"
                                                       ToolTipService.ToolTip="Ação da operação" />

                                            
                                            <Rectangle Width="1"
                                                       VerticalAlignment="Stretch"
                                                       Fill="{ThemeResource QueueSubtleBorderBrush}" />

                                            
                                            <Button Width="28"
                                                       Height="28"
                                                       CornerRadius="0"
                                                       Padding="0"
                                                       Background="Transparent"
                                                       BorderThickness="0"
                                                       VerticalAlignment="Stretch"
                                                       VerticalContentAlignment="Center"
                                                       HorizontalContentAlignment="Center"
                                                       ToolTipService.ToolTip="Mais opções desta operação"
                                                       Click="ItemMoreButton_Click"
                                                       Tag="{Binding}">
                                                <FontIcon Glyph="&#xE712;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            
            <Grid x:Name="OutputModalHost"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Background="#A0000000"
                  Visibility="Collapsed">
                <Border Margin="12"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource QueueCardBorderBrush}"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
                        
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <SymbolIcon Symbol="Document" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock x:Name="OutputModalTitle" Text="{Binding OutputTitle, Mode=OneWay}"

                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                       Style="{StaticResource StoreActionButtonStyle}"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Padding="6"
                                       ToolTipService.ToolTip="Fechar saída da operação"
                                       AutomationProperties.Name="Fechar saída da operação"
                                       Click="CloseOutputModal_Click">
                                <SymbolIcon Symbol="Cancel" Width="14" Height="14" />
                            </Button>
                        </Grid>

                        
                        <Border Grid.Row="1"
                                CornerRadius="{StaticResource CompactCornerRadius}"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource QueueSubtleBorderBrush}">
                            <TextBox x:Name="OutputModalTextBox" AutomationProperties.AutomationId="OutputModalTextBox" Text="{Binding OutputText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="12"
                                     Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                </TextBox.Resources>
                            </TextBox>
                        </Border>

                        
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button 
                                           Style="{StaticResource StoreActionButtonStyle}"
                                           Margin="0,0,8,0"
                                           Click="CopyOutputLog_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Copy" Width="16" Height="16" /><TextBlock Text="Copiar log" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Content="Fechar"
                                           Style="{StaticResource StoreActionButtonStyle}"
                                           Background="{ThemeResource AccentFillColorDefaultBrush}"
                                           BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                           Click="CloseOutputModal_Click">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.9"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource TextOnAccentFillColorPrimary}"/>
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource TextOnAccentFillColorPrimary}"/>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</UserControl>
