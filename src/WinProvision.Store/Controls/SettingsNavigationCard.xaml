<UserControl
    x:Class="WinProvision.Store.Controls.SettingsNavigationCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI">
  <Button x:Name="NavigationButton"
          Style="{StaticResource SettingsNavigationCardButtonStyle}"
          Click="NavigationButton_Click"
          AutomationProperties.Name="{Binding Title, ElementName=Root}"
          AutomationProperties.HelpText="{Binding Description, ElementName=Root}">
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="14" TextWrapping="Wrap" />
        <TextBlock x:Name="DescriptionTextBlock" Text="{Binding Description, ElementName=Root}" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                   Visibility="{Binding HasDescription, ElementName=Root, Converter={StaticResource BoolVisibility}}" />
      </StackPanel>
      <ic:FluentIcon Grid.Column="1" Icon="ChevronRight" IconVariant="Regular" IconSize="Size16"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                     AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </Button>
</UserControl>
