                                                                <TextBlock Text="Depois de instalar" Style="{StaticResource AppDetailsCaptionStyle}" />
                                                                <TextBox AutomationProperties.Name="Script depois da instalação" Text="{Binding PostInstallScript, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap" MaxLength="32768" MinHeight="{StaticResource AppDetailsSize72}" MaxHeight="120" IsSpellCheckEnabled="False" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" />
