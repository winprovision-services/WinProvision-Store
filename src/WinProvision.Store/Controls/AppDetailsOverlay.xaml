<UserControl xmlns:vm="using:WinProvision.Store.ViewModels" xmlns:ic="using:FluentIcons.WinUI" x:Class="WinProvision.Store.Controls.AppDetailsOverlay" x:DataType="vm:AppDetailsViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:WinProvision.Store.Controls"
             xmlns:conv="using:WinProvision.Store.Services"
             IsTabStop="True"
             KeyDown="Overlay_KeyDown"
             Style="{StaticResource AppDetailsOverlayStyle}"
             TabFocusNavigation="Cycle">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Scrim"
          Background="{ThemeResource AppDetailsScrimBrush}"
          Opacity="1"
          Tapped="Scrim_Tapped">
        <Grid x:Name="DetailsShadowHost" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Rectangle x:Name="DetailsShadowShape" Fill="White" RadiusX="24" RadiusY="24" Opacity="0"/>
        </Grid>

        <Border x:Name="Card" controls:RoundedClip.IsEnabled="True"
                Background="{ThemeResource DetailsBackgroundBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="{StaticResource AppDetailsStroke1}"
                CornerRadius="{StaticResource AppOverlayCornerRadius}"
                Margin="{StaticResource AppDetailsSpacing24}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                Opacity="1"
                Tapped="Card_Tapped">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTransform" Y="0" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{StaticResource AppDetailsLoadingRowHeight}" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="{StaticResource AppDetailsSpacing24_16_16_12}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource AppDetailsBodyStrongStyle}" x:Name="OverlayTitleText"
                               Grid.Column="0"
                               Text="Detalhes do pacote"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                               x:Name="CloseButton" AutomationProperties.AutomationId="CloseButton"
                               Width="{StaticResource AppDetailsSize32}"
                               Height="{StaticResource AppDetailsSize32}"
                               Padding="{StaticResource AppDetailsSpacing0}"
                               AutomationProperties.Name="Fechar (Esc)"
                               ToolTipService.ToolTip="Fechar (Esc)"
                               Click="CloseButton_Click" Background="Transparent" BorderThickness="0">
                        <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size16" Style="{StaticResource AppDetailsSmallIconStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>

                <ProgressBar Grid.Row="1"
                             x:Name="LoadingProgressBar" Visibility="{Binding IsLoadingProgressBarVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                             IsIndeterminate="True"
                             Height="{StaticResource AppDetailsSize4}"
                             />

                <ScrollViewer x:Name="AppDetailsContent"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="{StaticResource AppDetailsSpacing24_8_24_24}">
                    <Grid x:Name="AppDetailsColumns">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource AppDetailsColumnGap}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <Grid Margin="{StaticResource AppDetailsSpacing0_0_0_16}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="{StaticResource AppDetailsSize68}"
                                        Height="{StaticResource AppDetailsSize68}"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="{StaticResource AppDetailsStroke0}"
                                        Margin="{StaticResource AppDetailsSpacing0_0_16_0}">
                                    <Grid>
                                        <ic:FluentIcon Icon="Apps" IconVariant="Regular" IconSize="Size16" Style="{StaticResource AppDetailsFallbackIconStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=AppIcon, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <Image x:Name="AppIcon" conv:AsyncImage.SourceUrl="{Binding IconUrl}" conv:AsyncImage.DecodePixelWidth="112"
                                               Width="{StaticResource AppDetailsSize56}"
                                               Height="{StaticResource AppDetailsSize56}"
                                               Stretch="Uniform"
                                               Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=AppIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource AppDetailsTitleStyle}" x:Name="AppNameText" Text="{Binding AppNameText}"
                                               LineHeight="{StaticResource AppDetailsSize40}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource AppDetailsBodyStyle}" x:Name="PackageSourceText" Text="{Binding PackageSourceText}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Margin="{StaticResource AppDetailsSpacing0_4_0_0}" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl x:Name="TagsList" Visibility="{Binding IsTagsListVisible, Converter={StaticResource BoolToVisibilityConverter}}" ItemsSource="{Binding Tags}" Margin="{StaticResource AppDetailsSpacing0_0_0_16}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource SystemAccentColorPrimaryBrush}"
                                                CornerRadius="{StaticResource AppControlCornerRadius}"
                                                Padding="{StaticResource AppDetailsSpacing12_4}"
                                                Margin="{StaticResource AppDetailsSpacing0_0_8_8}"
                                                VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource AppDetailsCaptionStyle}" Text="{Binding}"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource AppDetailsBodyStyle}" x:Name="DescriptionText" Text="{Binding DescriptionText}"
                                       TextWrapping="Wrap"
                                       LineHeight="{StaticResource AppDetailsSize20}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="{StaticResource AppDetailsSpacing0_0_0_20}" />

                            <Border x:Name="UpdateVersionPanel" Visibility="{Binding IsUpdateVersionPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"

                                    Background="{ThemeResource DetailsSurfaceBrush}"
                                    BorderBrush="{ThemeResource DetailsBorderBrush}"
                                    BorderThickness="{StaticResource AppDetailsStroke1}"
                                    CornerRadius="{StaticResource AppOverlayCornerRadius}"
                                    Padding="{StaticResource AppDetailsSpacing16_12}"
                                    Margin="{StaticResource AppDetailsSpacing0_0_0_16}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource AppDetailsCaptionStyle}" Text="Versão instalada"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Style="{StaticResource AppDetailsBodyStrongStyle}" x:Name="CurrentUpdateVersionText" Text="{Binding CurrentUpdateVersionText}"
                                                   Margin="{StaticResource AppDetailsSpacing0_4_0_0}" />
                                    </StackPanel>
                                    <ic:FluentIcon Icon="ChevronRight" IconVariant="Regular" IconSize="Size16" Style="{StaticResource AppDetailsSmallIconStyle}" Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Margin="{StaticResource AppDetailsSpacing12_0}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource AppDetailsCaptionStyle}" Text="Nova versão"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Style="{StaticResource AppDetailsBodyStrongStyle}" x:Name="AvailableUpdateVersionText" Text="{Binding AvailableUpdateVersionText}"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                   Margin="{StaticResource AppDetailsSpacing0_4_0_0}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Margin="{StaticResource AppDetailsSpacing0_0_0_20}">

                                <controls:WrapPanel Margin="{StaticResource AppDetailsSpacing0_0_0_4}">
                                    <TextBlock Text="Página Inicial:" Style="{StaticResource AppDetailsRowLabelStyle}" />
                                    <HyperlinkButton x:Name="HomepageLink" AutomationProperties.AutomationId="HomepageLink" Tag="{Binding HomepageLinkTag}" Visibility="{Binding IsHomepageLinkVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Style="{StaticResource AppDetailsInlineLinkStyle}"
                                                        Click="OpenLink_Click">
                                        <TextBlock x:Name="HomepageLinkText" Text="{Binding HomepageLinkText}"
                                                   Foreground="{ThemeResource DetailsLinkBrush}"
                                                   TextDecorations="Underline"
                                                   TextWrapping="Wrap" />
                                    </HyperlinkButton>
                                    <TextBlock Style="{StaticResource AppDetailsBodyStyle}" x:Name="HomepageNotAvailableText" Visibility="{Binding IsHomepageNotAvailableTextVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Text="Não disponível"
                                               FontStyle="Italic"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               />
                                </controls:WrapPanel>

                                <controls:WrapPanel Margin="{StaticResource AppDetailsSpacing0_0_0_4}">
                                    <TextBlock Text="Desenvolvedor:" Style="{StaticResource AppDetailsRowLabelStyle}" />
                                    <TextBlock x:Name="DeveloperText" Text="{Binding DeveloperText}" Style="{StaticResource AppDetailsRowValueStyle}" />
                                </controls:WrapPanel>

                                <controls:WrapPanel Margin="{StaticResource AppDetailsSpacing0_0_0_4}">
                                    <TextBlock Text="Autor:" Style="{StaticResource AppDetailsRowLabelStyle}" />
                                    <TextBlock x:Name="AuthorText" Text="{Binding AuthorText}" Style="{StaticResource AppDetailsRowValueStyle}" />
                                </controls:WrapPanel>

                                <controls:WrapPanel Margin="{StaticResource AppDetailsSpacing0_0_0_4}">
                                    <TextBlock Text="Licença:" Style="{StaticResource AppDetailsRowLabelStyle}" />
                                    <TextBlock x:Name="LicenseText" Text="{Binding LicenseText}"
                                               Style="{StaticResource AppDetailsRowValueStyle}"
                                               Margin="{StaticResource AppDetailsSpacing0_0_8_0}" />
                                    <HyperlinkButton x:Name="LicenseLink" AutomationProperties.AutomationId="LicenseLink" Tag="{Binding LicenseLinkTag}" Visibility="{Binding IsLicenseLinkVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Style="{StaticResource AppDetailsInlineLinkStyle}"
                                                        Click="OpenLink_Click">
                                        <TextBlock x:Name="LicenseLinkText" Text="{Binding LicenseLinkText}"
                                                   Foreground="{ThemeResource DetailsLinkBrush}"
                                                   TextDecorations="Underline"
                                                   TextWrapping="Wrap" />
                                    </HyperlinkButton>
                                </controls:WrapPanel>

                                <controls:WrapPanel Margin="{StaticResource AppDetailsSpacing0_0_0_4}">
                                    <TextBlock Text="Última atualização:" Style="{StaticResource AppDetailsRowLabelStyle}" />
                                    <TextBlock x:Name="LastUpdatedText" Text="{Binding LastUpdatedText}" Style="{StaticResource AppDetailsRowValueStyle}" />
                                </controls:WrapPanel>

                                <controls:WrapPanel Margin="{StaticResource AppDetailsSpacing0_0_0_4}">
                                    <TextBlock Text="Gerenciador de pacotes:" Style="{StaticResource AppDetailsRowLabelStyle}" />
                                    <TextBlock x:Name="PackageManagerText" Text="{Binding PackageManagerText}" Style="{StaticResource AppDetailsRowValueStyle}" />
                                </controls:WrapPanel>

                            </StackPanel>

                            <StackPanel Margin="{StaticResource AppDetailsSpacing0_0_0_16}">

                                <TextBlock Text="{Binding SelfInstalledVersionText}"
                                           Style="{StaticResource AppDetailsBodyStrongStyle}"
                                           Margin="{StaticResource AppDetailsSpacing0_0_0_4}"
                                           Visibility="{Binding IsSelfPackage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <HyperlinkButton Content="Atualizações do aplicativo" Command="{Binding OpenAppUpdatesCommand}"
                                                 Visibility="{Binding IsSelfPackage, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <Grid HorizontalAlignment="Left">

                                    <Button x:Name="AddSelfToPackagesButton" Content="Adicionar aos Pacotes"
                                            AutomationProperties.AutomationId="AddSelfToPackagesButton"
                                            Style="{StaticResource AppDetailsPrimaryButtonStyle}"
                                            Height="{StaticResource AppDetailsSize36}"
                                            Padding="{StaticResource AppDetailsSpacing24_0}"
                                            CornerRadius="{StaticResource AppControlCornerRadius}"
                                            Visibility="{Binding IsSelfPackage, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Click="AddSelfToPackages_Click" />

                                    <Grid x:Name="InstallSplitGroup" Visibility="{Binding IsInstallSplitGroupVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button Style="{StaticResource AppDetailsPrimaryButtonStyle}" Grid.Column="0"
                                                   x:Name="InstallButton" AutomationProperties.AutomationId="InstallButton" IsEnabled="{Binding InstallButtonIsEnabled}"
                                                   Content="Instalar"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                   Height="{StaticResource AppDetailsSize36}"
                                                   Padding="{StaticResource AppDetailsSpacing24_0}"
                                                   CornerRadius="{StaticResource AppDetailsSplitActionCornerRadius}"
                                                   Command="{Binding InstallCommand}" />

                                        <Button Grid.Column="1"
                                                   x:Name="InstallChevronButton" AutomationProperties.AutomationId="InstallChevronButton" IsEnabled="{Binding InstallChevronButtonIsEnabled}"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                   Height="{StaticResource AppDetailsSize36}"
                                                   Width="{StaticResource AppDetailsSize32}"
                                                   Padding="{StaticResource AppDetailsSpacing0}"
                                                   BorderThickness="{StaticResource AppDetailsStroke1_0_0_0}"
                                                   BorderBrush="{ThemeResource AppDetailsSplitDividerBrush}"
                                                   CornerRadius="{StaticResource AppDetailsSplitMenuCornerRadius}"
                                                   AutomationProperties.Name="Opções adicionais de instalação"
                               ToolTipService.ToolTip="Opções adicionais de instalação"
                                                   Click="InstallChevronButton_Click" Style="{StaticResource AppDetailsPrimaryButtonStyle}">
                                            <ic:FluentIcon Icon="ChevronDown" IconVariant="Regular" IconSize="Size16" Style="{StaticResource AppDetailsSmallIconStyle}" />
                                        </Button>
                                    </Grid>
                                    
                                    <Button Style="{StaticResource AppDetailsPrimaryButtonStyle}" x:Name="UpdateButton" AutomationProperties.AutomationId="UpdateButton" Visibility="{Binding IsUpdateButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}" IsEnabled="{Binding UpdateButtonIsEnabled}"
                                               Content="Atualizar"
                                               Height="{StaticResource AppDetailsSize36}"
                                               Padding="{StaticResource AppDetailsSpacing24_0}"
                                               CornerRadius="{StaticResource AppControlCornerRadius}"

                                               Command="{Binding UpdateCommand}" />

                                    <Grid x:Name="UninstallSplitGroup" Visibility="{Binding IsUninstallSplitGroupVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource AppDetailsActionButtonStyle}" Grid.Column="0"
                                                   x:Name="UninstallButton" AutomationProperties.AutomationId="UninstallButton" IsEnabled="{Binding UninstallButtonIsEnabled}"
                                                   Height="{StaticResource AppDetailsSize36}"
                                                   Padding="{StaticResource AppDetailsSpacing24_0}"
                                                   CornerRadius="{StaticResource AppDetailsSplitActionCornerRadius}"
                                                   Command="{Binding UninstallCommand}"
                                                   ToolTipService.ToolTip="Desinstalar aplicativo">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ic:FluentIcon Icon="Delete" IconVariant="Regular" IconSize="Size16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <TextBlock Text="Desinstalar" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1"
                                                   x:Name="UninstallChevronButton" AutomationProperties.AutomationId="UninstallChevronButton"
                                                   Height="{StaticResource AppDetailsSize36}"
                                                   Width="{StaticResource AppDetailsSize32}"
                                                   Padding="{StaticResource AppDetailsSpacing0}"
                                                   Margin="-1,0,0,0"
                                                   Style="{StaticResource AppDetailsActionButtonStyle}"
                                                   CornerRadius="{StaticResource AppDetailsSplitMenuCornerRadius}"
                                                   AutomationProperties.Name="Mais opções"
                               ToolTipService.ToolTip="Mais opções"
                                                   Click="UninstallChevronButton_Click">
                                            <ic:FluentIcon Icon="ChevronDown" IconVariant="Regular" IconSize="Size16" Style="{StaticResource AppDetailsSmallIconStyle}" />
                                        </Button>
                                    </Grid>
                                </Grid>

                                <controls:StatusInfoBar x:Name="StatusText" StatusMessage="{Binding StatusText}"
                                                         Margin="{StaticResource AppDetailsSpacing0_8_0_0}" />

                            </StackPanel>

                            <Border Visibility="{Binding ShowManagementOptions, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="{StaticResource AppDetailsStroke1}"
                                    CornerRadius="{StaticResource AppOverlayCornerRadius}"
                                    Margin="{StaticResource AppDetailsSpacing0_0_0_12}">
                                <StackPanel>
                                    
                                    <Grid Margin="{StaticResource AppDetailsSpacing12_8}"
                                          x:Name="OptionsHeader"
                                          
                                          AutomationProperties.Name="Expandir ou recolher opções de instalação"
                                          Tapped="OptionsHeader_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ic:FluentIcon Icon="Settings" IconVariant="Color" IconSize="Size16" Style="{StaticResource AppDetailsSmallIconStyle}" Grid.Column="0"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Margin="{StaticResource AppDetailsSpacing0_0_12_0}"
                                                       VerticalAlignment="Center" />

                                        <TextBlock Style="{StaticResource AppDetailsBodyStrongStyle}" Grid.Column="1"
                                                   Text="Opções de instalação"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <Button Style="{StaticResource AppDetailsPrimaryButtonStyle}" Grid.Column="2"
                                                   x:Name="SaveOptionsButton" AutomationProperties.AutomationId="SaveOptionsButton"
                                                   Content="Salvar opções"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                   CornerRadius="{StaticResource AppControlCornerRadius}"
                                                   Height="{StaticResource AppDetailsSize28}"
                                                   Padding="{StaticResource AppDetailsSpacing16_0}"
                                                   Margin="{StaticResource AppDetailsSpacing0_0_8_0}"
                                                   Click="SaveOptionsButton_Click" />

                                        <Button Grid.Column="3" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Expandir ou recolher opções de instalação" Click="OptionsToggle_Click"><ic:FluentIcon Icon="ChevronDown" IconVariant="Regular" IconSize="Size16" Style="{StaticResource AppDetailsSmallIconStyle}" x:Name="OptionsChevronIcon"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center" /></Button>
                                    </Grid>

                                    <StackPanel x:Name="OptionsBodyPanel" Visibility="{Binding IsOptionsBodyPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"

                                                Margin="{StaticResource AppDetailsSpacing16_0_16_16}">
                                        <Rectangle Height="{StaticResource AppDetailsSize4}"
                                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                   Margin="{StaticResource AppDetailsSpacing0_0_0_12}" />

                                        <CheckBox Style="{StaticResource AppDetailsCheckBoxStyle}" x:Name="InstallAllUsersCheckBox" AutomationProperties.AutomationId="InstallAllUsersCheckBox" IsEnabled="{Binding InstallAllUsersCheckBoxIsEnabled}" IsChecked="{Binding InstallAllUsersCheckBoxIsChecked, Mode=TwoWay}"
                                                  Content="Instalar para todos os usuários"
                                                  Margin="{StaticResource AppDetailsSpacing0_0_0_8}"
                                                  Checked="InstallOptions_Changed"
                                                  Unchecked="InstallOptions_Changed" />

                                        <CheckBox Style="{StaticResource AppDetailsCheckBoxStyle}" x:Name="InteractiveInstallCheckBox" AutomationProperties.AutomationId="InteractiveInstallCheckBox" IsEnabled="{Binding InteractiveInstallCheckBoxIsEnabled}" IsChecked="{Binding InteractiveInstallCheckBoxIsChecked, Mode=TwoWay}"
                                                  Content="Permitir instalação interativa"
                                                  Margin="{StaticResource AppDetailsSpacing0_0_0_12}"
                                                  Checked="InstallOptions_Changed"
                                                  Unchecked="InstallOptions_Changed" />

                                        <StackPanel Visibility="{Binding IsWinGetVersionOptionsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Margin="{StaticResource AppDetailsSpacing0_0_0_12}">
                                            <TextBlock Style="{StaticResource AppDetailsCaptionStyle}" Text="Versão do WinGet" Margin="{StaticResource AppDetailsSpacing0_0_0_4}" />
                                            <controls:WrapPanel VerticalAlignment="Center">
                                                <ComboBox x:Name="InstallVersionComboBox" AutomationProperties.AutomationId="InstallVersionComboBox"
                                                          ItemsSource="{Binding InstallVersions}" SelectedItem="{Binding SelectedInstallVersion, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanLoadVersions}"
                                                          MinWidth="{StaticResource AppDetailsSize152}" Height="{StaticResource AppDetailsSize32}"
                                                          SelectionChanged="InstallVersionComboBox_SelectionChanged" />
                                            </controls:WrapPanel>
                                        </StackPanel>

                                        <CheckBox Style="{StaticResource AppDetailsCheckBoxStyle}" x:Name="IgnoreSecurityHashCheckBox"
                                                  AutomationProperties.AutomationId="IgnoreSecurityHashCheckBox"
                                                  Visibility="{Binding IsWinGetVersionOptionsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  IsChecked="{Binding IgnoreSecurityHashCheckBoxIsChecked, Mode=TwoWay}"
                                                  Content="Ignorar verificação de hash nesta operação (menos seguro)"
                                                  Margin="{StaticResource AppDetailsSpacing0_0_0_8}"
                                                  Checked="InstallOptions_Changed" Unchecked="InstallOptions_Changed" />

                                        <controls:WrapPanel x:Name="InstallArchitecturePanel" Visibility="{Binding IsInstallArchitecturePanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   VerticalAlignment="Center"
                                                   Margin="{StaticResource AppDetailsSpacing0_0_0_12}">
                                            <TextBlock Style="{StaticResource AppDetailsCaptionStyle}" Text="Arquitetura:"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="{StaticResource AppDetailsSpacing0_0_8_0}" />
                                            <ComboBox x:Name="InstallArchitectureComboBox" AutomationProperties.AutomationId="InstallArchitectureComboBox" SelectedItem="{Binding SelectedArchitecture, Mode=TwoWay}" ItemsSource="{Binding Architectures}"
                                                      MinWidth="{StaticResource AppDetailsSize152}"
                                                      Height="{StaticResource AppDetailsSize32}"
                                                      SelectionChanged="InstallArchitectureComboBox_SelectionChanged" />
                                        </controls:WrapPanel>

                                        <CheckBox Style="{StaticResource AppDetailsCheckBoxStyle}" x:Name="PersistPackageOptionsCheckBox" AutomationProperties.AutomationId="PersistPackageOptionsCheckBox" IsEnabled="{Binding PersistPackageOptionsCheckBoxIsEnabled}" IsChecked="{Binding PersistPackageOptionsCheckBoxIsChecked, Mode=TwoWay}"
                                                  Content="Reutilizar estas opções nas próximas instalações e atualizações"

                                                  Margin="{StaticResource AppDetailsSpacing0_0_0_4}" />
                                        <TextBlock Style="{StaticResource AppDetailsCaptionStyle}" x:Name="PersistPackageOptionsHintText" Text="{Binding PersistPackageOptionsHintText}"

                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="{StaticResource AppDetailsSpacing20_0_0_8}" />

                                        <controls:WrapPanel VerticalAlignment="Center">
                                            <Button Style="{StaticResource AppDetailsActionButtonStyle}" x:Name="SelectLocationButton" AutomationProperties.AutomationId="SelectLocationButton"
                                                       Content="Escolher pasta..."
                                                       CornerRadius="{StaticResource AppControlCornerRadius}"
                                                       Padding="{StaticResource AppDetailsSpacing12_4}"
                                                       Click="SelectLocationButton_Click"
                                                       Margin="{StaticResource AppDetailsSpacing0_0_8_0}" />
                                            <TextBlock Style="{StaticResource AppDetailsCaptionStyle}" x:Name="SelectedLocationText" Text="{Binding SelectedLocationText}"

                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="{StaticResource AppDetailsSize220}" />
                                        </controls:WrapPanel>

                                        <StackPanel Visibility="{Binding IsInstallHooksOptionsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource AppDetailsBodyStrongStyle}" Text="Scripts desta operação"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="{StaticResource AppDetailsSpacing0_12_0_4}" />
                                        <TextBlock Style="{StaticResource AppDetailsCaptionStyle}"
                                                   Text="Os scripts são salvos apenas neste dispositivo e nunca entram em perfis exportados. Ao marcar a opção, executam na instalação individual seguinte, no contexto atual do Windows e sem elevação automática. Não executam em atualizações ou lotes."
                                                   TextWrapping="Wrap"
                                                   Margin="{StaticResource AppDetailsSpacing0_0_0_8}" />
                                        <TextBlock Style="{StaticResource AppDetailsCaptionStyle}" Text="Antes da instalação (PowerShell)" />
                                        <TextBox AutomationProperties.Name="Script antes da instalação" Text="{Binding PreInstallScript, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap" MaxLength="32768" MinHeight="{StaticResource AppDetailsSize72}" MaxHeight="160" IsSpellCheckEnabled="False" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        <TextBlock Style="{StaticResource AppDetailsCaptionStyle}" Text="Depois da instalação (PowerShell)" Margin="{StaticResource AppDetailsSpacing0_8_0_4}" />
                                        <TextBox AutomationProperties.Name="Script depois da instalação" Text="{Binding PostInstallScript, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap" MaxLength="32768" MinHeight="{StaticResource AppDetailsSize72}" MaxHeight="160" IsSpellCheckEnabled="False" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        <CheckBox Style="{StaticResource AppDetailsCheckBoxStyle}" AutomationProperties.AutomationId="RunInstallHooksCheckBox" IsChecked="{Binding RunInstallHooks, Mode=TwoWay}"
                                                  Content="Executar os scripts na próxima instalação deste pacote"
                                                  Margin="{StaticResource AppDetailsSpacing0_8_0_4}" />
                                        <TextBlock Style="{StaticResource AppDetailsCaptionStyle}" Text="Argumentos adicionais do instalador (WinGet)" Margin="{StaticResource AppDetailsSpacing0_8_0_4}" />
                                        <TextBox AutomationProperties.Name="Argumentos adicionais do instalador" Text="{Binding CustomArguments, Mode=TwoWay}" MaxLength="4096" IsSpellCheckEnabled="False" />
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource AppDetailsBodyStrongStyle}" Text="Prévia do comando WinGet no PowerShell"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="{StaticResource AppDetailsSpacing0_12_0_4}" />
                                        <TextBox Style="{StaticResource AppDetailsCodeBoxStyle}" x:Name="InstallCommandPreviewTextBox" AutomationProperties.AutomationId="InstallCommandPreviewTextBox" Text="{Binding InstallCommandPreviewTextBox}"
                                                    IsReadOnly="True"
                                                    AcceptsReturn="True"
                                                    TextWrapping="Wrap"
                                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                    MinHeight="{StaticResource AppDetailsSize48}"
                                                    MaxHeight="{StaticResource AppDetailsSize72}"
                                                    Margin="{StaticResource AppDetailsSpacing0_0_0_8}" />
                                        <Button Style="{StaticResource AppDetailsActionButtonStyle}" x:Name="CopyInstallCommandButton" AutomationProperties.AutomationId="CopyInstallCommandButton" IsEnabled="{Binding CopyInstallCommandButtonIsEnabled}"
                                                   Content="Copiar comando"
                                                   CornerRadius="{StaticResource AppControlCornerRadius}"
                                                   Padding="{StaticResource AppDetailsSpacing12_4}"
                                                   HorizontalAlignment="Left"
                                                   Click="CopyInstallCommandButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <StackPanel x:Name="AppDetailsRightColumn" Grid.Column="2">
                            
                            <Border x:Name="ScreenshotsPanel" controls:RoundedClip.IsEnabled="True"
                                    Height="{StaticResource AppDetailsSize220}"
                                    Margin="{StaticResource AppDetailsSpacing0_0_0_16}"
                                    CornerRadius="{StaticResource AppOverlayCornerRadius}"
                                    Background="{ThemeResource DetailsSurfaceBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="{StaticResource AppDetailsStroke1}">
                                <Grid>
                                    <TextBlock x:Name="ScreenshotsEmptyText"
                                               Text="As capturas de tela não puderam ser carregadas."
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource AppDetailsSpacing24}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="Collapsed" />
                                    <ProgressBar x:Name="ScreenshotLoadingBar"
                                                 Width="{StaticResource AppDetailsSize56}"
                                                 Height="{StaticResource AppDetailsSize4}"
                                                 IsIndeterminate="True"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Visibility="Collapsed" />
                                    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <FlipView x:Name="Gallery" MaxWidth="400" Height="190" ItemsSource="{Binding Screenshots}"
                                                  SelectionChanged="Gallery_SelectionChanged"
                                                  IsEnabled="True">
                                            <FlipView.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Button Padding="0" BorderThickness="0" Background="Transparent"
                                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                            AutomationProperties.Name="Abrir captura de tela ampliada"
                                                            Click="ScreenshotPreviewButton_Click">
                                                        <Image Stretch="Uniform" conv:AsyncImage.SourceUrl="{Binding}"
                                                               conv:AsyncImage.DecodePixelWidth="720" />
                                                    </Button>
                                                </DataTemplate>
                                            </FlipView.ItemTemplate>
                                        </FlipView>
                                        <PipsPager x:Name="FlipViewPipsPager" HorizontalAlignment="Center"
                                                   Margin="0,12,0,0"
                                                   SelectedPageIndex="{Binding SelectedIndex, ElementName=Gallery, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <StackPanel>

                                <controls:WrapPanel Margin="{StaticResource AppDetailsSpacing0_0_0_4}">
                                    <TextBlock Text="ID do Pacote:" Style="{StaticResource AppDetailsRowLabelStyle}" />
                                    <TextBlock x:Name="PackageIdText" Text="{Binding PackageIdText}" Style="{StaticResource AppDetailsRowValueStyle}" />
                                </controls:WrapPanel>

                                <controls:WrapPanel Margin="{StaticResource AppDetailsSpacing0_0_0_4}">
                                    <TextBlock Text="Manifesto:" Style="{StaticResource AppDetailsRowLabelStyle}" />
                                    <TextBlock Text="Não encontrado" Style="{StaticResource AppDetailsRowValueStyle}"
                                               Visibility="{Binding IsManifestNotFoundVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <HyperlinkButton x:Name="ManifestLink" AutomationProperties.AutomationId="ManifestLink" Visibility="{Binding IsManifestLinkVisible, Converter={StaticResource BoolToVisibilityConverter}}" Tag="{Binding ManifestLinkTag}"
                                                        Style="{StaticResource AppDetailsInlineLinkStyle}"
                                                        Click="OpenLink_Click">
                                        <TextBlock x:Name="ManifestLinkText" Text="{Binding ManifestLinkText}"
                                                   Foreground="{ThemeResource DetailsLinkBrush}"
                                                   TextDecorations="Underline"
                                                   TextWrapping="Wrap" />
                                    </HyperlinkButton>
                                </controls:WrapPanel>

                                <controls:WrapPanel Margin="{StaticResource AppDetailsSpacing0_0_0_16}">
                                    <TextBlock Text="Versão:" Style="{StaticResource AppDetailsRowLabelStyle}" />
                                    <TextBlock x:Name="PackageVersionText" Text="{Binding PackageVersionText}" Style="{StaticResource AppDetailsRowValueStyle}" />
                                </controls:WrapPanel>

                                <controls:WrapPanel Margin="{StaticResource AppDetailsSpacing0_0_0_4}">
                                    <TextBlock Text="Tipo de Instalador:" Style="{StaticResource AppDetailsRowLabelStyle}" />
                                    <TextBlock x:Name="InstallerTypeText" Text="{Binding InstallerTypeText}" Style="{StaticResource AppDetailsRowValueStyle}" />
                                </controls:WrapPanel>

                                <controls:WrapPanel Margin="{StaticResource AppDetailsSpacing0_0_0_4}">
                                    <TextBlock Text="URL do Instalador :" Style="{StaticResource AppDetailsRowLabelStyle}" />
                                    <HyperlinkButton x:Name="InstallerUrlLink" AutomationProperties.AutomationId="InstallerUrlLink" Tag="{Binding InstallerUrlLinkTag}" Visibility="{Binding IsInstallerUrlLinkVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Style="{StaticResource AppDetailsInlineLinkStyle}"
                                                        Click="OpenLink_Click">
                                        <TextBlock x:Name="InstallerUrlLinkText" Text="{Binding InstallerUrlLinkText}"
                                                   Foreground="{ThemeResource DetailsLinkBrush}"
                                                   TextDecorations="Underline"
                                                   TextWrapping="Wrap" />
                                    </HyperlinkButton>
                                </controls:WrapPanel>

                                <controls:WrapPanel Margin="{StaticResource AppDetailsSpacing0_0_0_4}">
                                    <TextBlock Text="SHA256 do Instalador:"
                                               Style="{StaticResource AppDetailsRowLabelStyle}"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="CopyInstallerSha256Button" AutomationProperties.AutomationId="CopyInstallerSha256Button"
                                            IsEnabled="{Binding IsSha256CopyEnabled}" Click="CopyInstallerSha256Button_Click"
                                            Padding="6,2" MinWidth="0" MinHeight="0" Margin="8,0,0,0"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTipService.ToolTip="Copiar SHA-256">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <ic:FluentIcon Icon="Copy" IconVariant="Regular" IconSize="Size16"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="Copiar" Style="{StaticResource AppDetailsCaptionStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </controls:WrapPanel>
                                <TextBlock Style="{StaticResource AppDetailsCodeTextStyle}" x:Name="Sha256Text" Text="{Binding Sha256Text}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="{StaticResource AppDetailsSpacing0_0_0_4}" />

                                <controls:WrapPanel Margin="{StaticResource AppDetailsSpacing0_0_0_16}">
                                    <HyperlinkButton x:Name="DownloadInstallerLink" AutomationProperties.AutomationId="DownloadInstallerLink" Visibility="{Binding IsDownloadInstallerLinkVisible, Converter={StaticResource BoolToVisibilityConverter}}" Tag="{Binding DownloadInstallerLinkTag}"
                                                        Style="{StaticResource AppDetailsInlineLinkStyle}"
                                                        Click="OpenLink_Click"
                                                        Margin="{StaticResource AppDetailsSpacing0_0_8_0}">
                                        <TextBlock Text="Baixar instalador"
                                                   Foreground="{ThemeResource DetailsLinkBrush}"
                                                   TextDecorations="Underline" />
                                    </HyperlinkButton>
                                    <TextBlock Style="{StaticResource AppDetailsCaptionStyle}" x:Name="InstallerSizeText" Text="{Binding InstallerSizeText}"

                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                </controls:WrapPanel>

                                <TextBlock Text="Dependências:"
                                           Style="{StaticResource AppDetailsRowLabelStyle}"
                                           Margin="{StaticResource AppDetailsSpacing0_0_0_4}" />
                                <TextBlock Style="{StaticResource AppDetailsBodyStyle}" x:Name="DependenciesText" Text="{Binding DependenciesText}"

                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="{StaticResource AppDetailsSpacing0_0_0_16}" />

                                <TextBlock Text="Notas de lançamento:"
                                           Style="{StaticResource AppDetailsRowLabelStyle}"
                                           Margin="{StaticResource AppDetailsSpacing0_0_0_4}" />
                                <TextBlock Style="{StaticResource AppDetailsBodyStyle}" x:Name="ReleaseNotesText" Text="{Binding ReleaseNotesText}"

                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="{StaticResource AppDetailsSpacing0_0_0_4}" />

                                <controls:WrapPanel Margin="{StaticResource AppDetailsSpacing0_0_0_4}">
                                    <TextBlock Text="URL das notas de lançamento:" Style="{StaticResource AppDetailsRowLabelStyle}" />
                                    <HyperlinkButton x:Name="ReleaseNotesUrlLink" AutomationProperties.AutomationId="ReleaseNotesUrlLink" Tag="{Binding ReleaseNotesUrlLinkTag}" Visibility="{Binding IsReleaseNotesUrlLinkVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Style="{StaticResource AppDetailsInlineLinkStyle}"

                                                        Click="OpenLink_Click">
                                        <TextBlock x:Name="ReleaseNotesUrlLinkText" Text="{Binding ReleaseNotesUrlLinkText}"
                                                   Foreground="{ThemeResource DetailsLinkBrush}"
                                                   TextDecorations="Underline"
                                                   TextWrapping="Wrap" />
                                    </HyperlinkButton>
                                    <TextBlock Style="{StaticResource AppDetailsBodyStyle}" x:Name="ReleaseNotesUrlNotAvailableText" Visibility="{Binding IsReleaseNotesUrlNotAvailableTextVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Text="Não disponível"
                                               FontStyle="Italic"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </controls:WrapPanel>

                            </StackPanel>

                        </StackPanel>

                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="WallpaperDetailsContent"
                              Grid.Row="2"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="{StaticResource AppDetailsSpacing24_8_24_24}">
                    <Grid x:Name="WallpaperDetailsColumns">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource AppDetailsColumnGap}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="WallpaperOptionsHost" Grid.Column="0" />
                        <StackPanel x:Name="WallpaperDetailsRightColumn" Grid.Column="2">
                            <Border Height="{StaticResource AppDetailsSize220}"
                                    Margin="{StaticResource AppDetailsSpacing0_0_0_16}"
                                    CornerRadius="{StaticResource AppOverlayCornerRadius}"
                                    Background="{ThemeResource DetailsSurfaceBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="{StaticResource AppDetailsStroke1}">
                                <ContentControl x:Name="WallpaperPreviewHost" />
                            </Border>
                            <ContentControl x:Name="WallpaperGalleryHost" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

            </Grid>
        </Border>

        <Grid x:Name="ScreenshotLightbox"
              TabFocusNavigation="Cycle"
              Canvas.ZIndex="10"
              Background="{ThemeResource AppDetailsLightboxScrimBrush}"
              Visibility="Collapsed"
              Tapped="ScreenshotLightbox_Tapped">
            <Border Margin="{StaticResource AppDetailsSpacing56}"
                    MaxWidth="{StaticResource AppDetailsSize1500}"
                    MaxHeight="{StaticResource AppDetailsSize1000}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DetailsBackgroundBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="{StaticResource AppDetailsStroke1}"
                    CornerRadius="{StaticResource AppOverlayCornerRadius}"
                    Padding="{StaticResource AppDetailsSpacing12}"
                    Tapped="Card_Tapped">
                <Image x:Name="ScreenshotLightboxImage"
                       Stretch="Uniform" />
            </Border>
            <Button x:Name="CloseScreenshotLightboxButton" AutomationProperties.AutomationId="CloseScreenshotLightboxButton"
                       Width="{StaticResource AppDetailsSize60}"
                       Height="{StaticResource AppDetailsSize60}"
                       MinWidth="{StaticResource AppDetailsSize60}"
                       MinHeight="{StaticResource AppDetailsSize60}"
                       Padding="{StaticResource AppDetailsSpacing12}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="{StaticResource AppDetailsSpacing20}"
                       AutomationProperties.Name="Fechar captura ampliada"
                       ToolTipService.ToolTip="Fechar imagem"
                       Click="CloseScreenshotLightboxButton_Click">
                <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size16" Style="{StaticResource AppDetailsIconStyle}" />
            </Button>
            <Button Width="{StaticResource AppDetailsSize44}"
                       Height="{StaticResource AppDetailsSize44}"
                       Padding="{StaticResource AppDetailsSpacing0}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="{StaticResource AppDetailsSpacing12_0}"
                       AutomationProperties.Name="Captura anterior"
                               ToolTipService.ToolTip="Captura anterior"
                       Click="PreviousScreenshotButton_Click">
                <ic:FluentIcon Icon="ChevronLeft" IconVariant="Regular" IconSize="Size16" Style="{StaticResource AppDetailsIconStyle}" />
            </Button>
            <Button Width="{StaticResource AppDetailsSize44}"
                       Height="{StaticResource AppDetailsSize44}"
                       Padding="{StaticResource AppDetailsSpacing0}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="{StaticResource AppDetailsSpacing12_0}"
                       AutomationProperties.Name="Próxima captura"
                               ToolTipService.ToolTip="Próxima captura"
                       Click="NextScreenshotButton_Click">
                <ic:FluentIcon Icon="ChevronRight" IconVariant="Regular" IconSize="Size16" Style="{StaticResource AppDetailsIconStyle}" />
            </Button>
        </Grid>
    </Grid>
</UserControl>


