<UserControl
    x:Class="WinProvision.Store.Controls.NoticeBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:WinProvision.Store.Services">
  <UserControl.Resources>
    <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </UserControl.Resources>
  <Border Padding="14" Margin="0,0,0,10" CornerRadius="8"
          Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
          BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1"
          AutomationProperties.LiveSetting="Polite">
    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <FontIcon Glyph="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Top" />
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Secondary}" Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVisibilityConverter}}"
                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <Button Content="Abrir" Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibilityConverter}}"
                Click="ActionButton_Click" HorizontalAlignment="Left" />
      </StackPanel>
      <Button Grid.Column="2" Content="×" Padding="8,2" MinWidth="32" MinHeight="32"
              Visibility="{Binding IsDismissible, Converter={StaticResource BoolToVisibilityConverter}}"
              Command="{Binding DismissCommand}" AutomationProperties.Name="Dispensar aviso"
              VerticalAlignment="Top" />
    </Grid>
  </Border>
</UserControl>
