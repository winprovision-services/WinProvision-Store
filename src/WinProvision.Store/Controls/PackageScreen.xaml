<UserControl
    x:Class="WinProvision.Store.Controls.PackageScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinProvision.Store.Controls"
    xmlns:vm="using:WinProvision.Store.ViewModels"
    xmlns:ic="using:FluentIcons.WinUI"
    x:Name="Root"
    FontFamily="{StaticResource StoreFontFamily}"
    FontSize="13">
    <UserControl.Resources>
        <Style x:Key="PackageScreenListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PackageScreenGridItemStyle" TargetType="GridViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewItem"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="PackageScreenListTemplate" x:DataType="vm:PackageScreenRow">
            <controls:PackageScreenRowView Mode="list" />
        </DataTemplate>
        <DataTemplate x:Key="PackageScreenCardTemplate" x:DataType="vm:PackageScreenRow">
            <controls:PackageScreenRowView Mode="grid" />
        </DataTemplate>
        <DataTemplate x:Key="PackageScreenDetailTemplate" x:DataType="vm:PackageScreenRow">
            <controls:PackageScreenRowView Mode="details" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="{StaticResource PageContentMaxWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border x:Name="TitleIconContainer" Style="{StaticResource PageHeaderIconTileStyle}"><ic:FluentIcon x:Name="TitleIcon" IconVariant="Regular" IconSize="Size24" /></Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource FluentPageTitleStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource FluentPageSubtitleStyle}" Text="{Binding Provider.Subtitle, ElementName=Root}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PageToolbarContainerStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <ToggleButton x:Name="FiltersButton" Style="{StaticResource PageToolbarToggleButtonStyle}" Click="FiltersButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6"><ic:FluentIcon Icon="Filter" IconVariant="Regular" IconSize="Size16" /><TextBlock x:Name="FiltersText" Text="Filtros" /></StackPanel>
                    </ToggleButton>
                    <SplitButton x:Name="PrimaryActionButton" Height="34" MinHeight="34" Padding="10,0" Style="{StaticResource UpdatesPrimarySplitButtonStyle}" AutomationProperties.Name="Ação principal" Click="PrimaryAction_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6"><ic:FluentIcon x:Name="PrimaryActionIcon" IconVariant="Regular" IconSize="Size16" /><TextBlock x:Name="PrimaryActionText" /></StackPanel>
                        <SplitButton.Flyout><MenuFlyout x:Name="PrimaryFlyout" /></SplitButton.Flyout>
                    </SplitButton>
                    <Button x:Name="ReloadButton" Height="34" Padding="10,0" Command="{Binding Provider.RefreshCommand, ElementName=Root}">
                        <StackPanel Orientation="Horizontal" Spacing="6"><ic:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" IconSize="Size16" /><TextBlock x:Name="ReloadText" Text="Recarregar" /></StackPanel>
                    </Button>
                    <Button x:Name="MoreButton" Height="34" Padding="10,0" AutomationProperties.Name="Mais ações">
                        <StackPanel Orientation="Horizontal" Spacing="6"><ic:FluentIcon Icon="MoreHorizontal" IconVariant="Regular" IconSize="Size16" /><TextBlock x:Name="MoreText" Text="Mais" /></StackPanel>
                        <Button.Flyout><MenuFlyout x:Name="OverflowFlyout" /></Button.Flyout>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" x:Name="StatusCard" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,8" CornerRadius="{StaticResource StoreCardCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" AutomationProperties.Name="Estado da instalação">
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusCardText" TextWrapping="Wrap" Style="{StaticResource FluentPageSubtitleStyle}" VerticalAlignment="Center" />
                <Button x:Name="StatusRefreshButton" Grid.Column="1" Visibility="Collapsed" Click="StatusRefresh_Click" Style="{StaticResource PageToolbarButtonStyle}" AutomationProperties.Name="Verificar novamente">
                    <StackPanel Orientation="Horizontal" Spacing="6"><ic:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" IconSize="Size16" /><TextBlock x:Name="StatusRefreshText" Text="Verificar novamente" /></StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="3" x:Name="BodyGrid" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="260" /><ColumnDefinition x:Name="SplitterColumn" Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="Sidebar" Grid.Column="0" Padding="10" CornerRadius="{StaticResource StoreCardCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <StackPanel x:Name="SidebarSections" Spacing="8" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Grid Grid.Column="2" RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid x:Name="TableHeader" Grid.Row="0" Height="34" Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><CheckBox x:Name="MasterSelection" Grid.Column="0" Width="22" Height="24" MinWidth="22" Padding="0" Click="MasterSelection_Click" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Selecionar todos os pacotes" /><Grid x:Name="HeaderColumns" Grid.Column="1" /></Grid>
                <Grid Grid.Row="1">
                    <ListView ItemContainerStyle="{StaticResource PackageScreenListItemStyle}" x:Name="ListView" ItemTemplate="{StaticResource PackageScreenListTemplate}" SelectionMode="None" Padding="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <GridView ItemContainerStyle="{StaticResource PackageScreenGridItemStyle}" x:Name="GridView" ItemTemplate="{StaticResource PackageScreenCardTemplate}" SelectionMode="None" IsItemClickEnabled="False" Padding="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                    </GridView>
                    <ListView ItemContainerStyle="{StaticResource PackageScreenListItemStyle}" x:Name="DetailsView" ItemTemplate="{StaticResource PackageScreenDetailTemplate}" SelectionMode="None" Padding="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Visibility="Collapsed" />
                    <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed"><ProgressRing IsActive="True" /><TextBlock x:Name="LoadingMessage" Text="Carregando pacotes..." TextWrapping="Wrap" MaxWidth="420" /><ProgressBar x:Name="LoadingProgress" Width="280" IsIndeterminate="True" /></StackPanel>
                    <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed"><TextBlock x:Name="ErrorTitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="480" /><TextBlock x:Name="ErrorText" TextWrapping="Wrap" MaxWidth="480" /><Button Content="Tentar novamente" Command="{Binding Provider.RefreshCommand, ElementName=Root}" /></StackPanel>
                    <Border x:Name="EmptyState" Style="{StaticResource PageEmptyStateCardStyle}" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><TextBlock x:Name="EmptyTitle" Style="{StaticResource PageEmptyStateTitleStyle}" /><TextBlock x:Name="EmptyMessage" Style="{StaticResource PageEmptyStateMessageStyle}" TextWrapping="Wrap" MaxWidth="420" /></StackPanel></Border>
                </Grid>
                <ContentControl x:Name="LandingHost" Grid.RowSpan="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            </Grid>
        </Grid>

                <Border Grid.Row="4" x:Name="Footer" Style="{StaticResource PageStatusBarStyle}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="ⓘ" /><TextBlock x:Name="SelectionSummary" FontWeight="SemiBold" /><TextBlock x:Name="StatusSeparator" Text="·" Visibility="Collapsed" /><TextBlock x:Name="StatusText" Style="{StaticResource PageStatusTextStyle}" TextTrimming="CharacterEllipsis" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0"><TextBlock x:Name="SortLabel" Text="Classificar por:" VerticalAlignment="Center" /><ComboBox x:Name="SortSelector" Height="32" Width="144" SelectionChanged="SortSelector_SelectionChanged" /></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <ToggleButton x:Name="ListModeButton" Tag="list" Click="ViewMode_Click" Style="{StaticResource PageViewModeToggleStyle}" AutomationProperties.Name="Visualização em lista"><ic:FluentIcon Icon="TextBulletList" IconVariant="Regular" IconSize="Size20" Width="18" Height="18" /></ToggleButton>
                    <ToggleButton x:Name="DetailsModeButton" Tag="details" Click="ViewMode_Click" Style="{StaticResource PageViewModeToggleStyle}" AutomationProperties.Name="Visualização detalhada"><ic:FluentIcon Icon="AppsList" IconVariant="Regular" IconSize="Size20" Width="18" Height="18" /></ToggleButton>
                    <ToggleButton x:Name="GridModeButton" Tag="grid" Click="ViewMode_Click" Style="{StaticResource PageViewModeToggleStyle}" AutomationProperties.Name="Visualização em grade"><ic:FluentIcon Icon="Grid" IconVariant="Regular" IconSize="Size20" Width="18" Height="18" /></ToggleButton>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
