<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <CornerRadius x:Key="CompactCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="StoreCardCornerRadius">12</CornerRadius>
    <Thickness x:Key="Spacing20">20</Thickness>
    <Style x:Key="FluentCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FluentPanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource StoreCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource Spacing20}" />
    </Style>
    <Style x:Key="FluentCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <FontFamily x:Key="StoreFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <x:Double x:Key="StoreSubtitleSize">14</x:Double>
    <Style x:Key="FluentPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource StoreFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource StoreSubtitleSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <FontFamily x:Key="StoreDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <x:Double x:Key="StorePageTitleSize">28</x:Double>
    <Style x:Key="FluentPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource StoreDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource StorePageTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Thickness x:Key="PageContentMargin">24,20,24,20</Thickness>
    <x:Double x:Key="PageContentMaxWidth">1600</x:Double>
    <Style x:Key="StoreCardSurfaceStyle" TargetType="Border" BasedOn="{StaticResource FluentCardStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource StoreCardCornerRadius}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="PageEmptyStateCardStyle" TargetType="Border" BasedOn="{StaticResource StoreCardSurfaceStyle}">
        <Setter Property="Padding" Value="28" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderSubtleBrush}" />
    </Style>
    <Style x:Key="PageEmptyStateIconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="PageEmptyStateMessageStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="440" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PageEmptyStateTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource FluentCardTitleStyle}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="PageHeaderIconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Thickness x:Key="PageHeaderMargin">0,0,0,20</Thickness>
    <Style x:Key="PageHeaderSymbolIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource PageHeaderIconBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Thickness x:Key="PageSectionGap">0,0,0,16</Thickness>
    <Style x:Key="PageStatusBarStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style x:Key="PageStatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="PageViewModeToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Thickness x:Key="Spacing8">8</Thickness>
    <Style x:Key="StoreActionButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource StoreFontFamily}" />
    </Style>
    <Style x:Key="StoreCardSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource StoreFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="StoreCategoryFilterStyle" TargetType="RadioButton">
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderSubtleBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="FilterSurface" CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                <VisualStateManager.VisualStateGroups>
                    <!-- Interaction states must not overwrite the fill owned by CheckStates. -->
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="FilterSurface.Opacity" Value="0.92"/></VisualState.Setters></VisualState>
                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="FilterSurface.Opacity" Value="0.85"/></VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="FilterSurface.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="CheckStates"><VisualState x:Name="Unchecked"/><VisualState x:Name="Checked"><VisualState.Setters><Setter Target="FilterSurface.Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/><Setter Target="FilterSurface.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/><Setter Target="ChipLabel.Foreground" Value="White"/><Setter Target="ChipIcon.Foreground" Value="White"/></VisualState.Setters></VisualState><VisualState x:Name="Indeterminate"/></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <StackPanel Orientation="Horizontal"><FontIcon x:Name="ChipIcon" Glyph="{Binding Icon}" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Margin="0,0,8,0" Foreground="{TemplateBinding Foreground}"/><TextBlock x:Name="ChipLabel" Text="{Binding Label}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/></StackPanel>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="StoreSearchBoxStyle" TargetType="AutoSuggestBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <LinearGradientBrush x:Key="StorefrontHeroScrimBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#E6000000" Offset="0" />
        <GradientStop Color="#A6000000" Offset="0.4" />
        <GradientStop Color="#18000000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StorefrontImageScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#18000000" Offset="0.35" />
        <GradientStop Color="#D9000000" Offset="1" />
    </LinearGradientBrush>
    <x:Double x:Key="StorefrontRowCardHeight">112</x:Double>
</ResourceDictionary>
