<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:WinProvision.Store.Controls">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="OfficeTileSelectedBackgroundBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.23" />
            <SolidColorBrush x:Key="OfficeStatusInstalledBrush" Color="#FF107C41" />
            <SolidColorBrush x:Key="OfficeStatusExcludedBrush" Color="#FF8A5A00" />
            <SolidColorBrush x:Key="OfficeStatusNeutralBrush" Color="#FF5B5B5B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="OfficeTileSelectedBackgroundBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.23" />
            <SolidColorBrush x:Key="OfficeStatusInstalledBrush" Color="#FF55D58A" />
            <SolidColorBrush x:Key="OfficeStatusExcludedBrush" Color="#FFFFC044" />
            <SolidColorBrush x:Key="OfficeStatusNeutralBrush" Color="#FFB8B8B8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="OfficeTileSelectedBackgroundBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.23" />
            <SolidColorBrush x:Key="OfficeStatusInstalledBrush" Color="#FF107C41" />
            <SolidColorBrush x:Key="OfficeStatusExcludedBrush" Color="#FF8A5A00" />
            <SolidColorBrush x:Key="OfficeStatusNeutralBrush" Color="#FF5B5B5B" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <SolidColorBrush x:Key="OfficeStatusInstalledBrush" Color="{ThemeResource SystemFillColorSuccess}" />
    <SolidColorBrush x:Key="OfficeStatusExcludedBrush" Color="{ThemeResource SystemFillColorCaution}" />
    <SolidColorBrush x:Key="OfficeStatusNeutralBrush" Color="{ThemeResource TextFillColorSecondary}" />
    <Style x:Key="OfficePrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PagePrimaryActionButtonStyle}" />
    <Style x:Key="OfficeAppSelectionSurfaceStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="controls:InstalledSelection.Kind" Value="Card" />
        <Setter Property="controls:InstalledSelection.Surface" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="controls:InstalledSelection.Stroke" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="controls:InstalledSelection.Hover" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="controls:InstalledSelection.SelectedSurface" Value="{ThemeResource OfficeTileSelectedBackgroundBrush}" />
        <Setter Property="controls:InstalledSelection.SelectedStroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style x:Key="OfficeAppTileSurfaceStyle" TargetType="Border" BasedOn="{StaticResource OfficeAppSelectionSurfaceStyle}">
        <Setter Property="Width" Value="144" />
        <Setter Property="Height" Value="72" />
    </Style>
    <Style x:Key="OfficeAppListSurfaceStyle" TargetType="Border" BasedOn="{StaticResource OfficeAppSelectionSurfaceStyle}">
        <Setter Property="controls:InstalledSelection.Kind" Value="Row" />
        <Setter Property="Height" Value="64" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="OfficeAppIconSurfaceStyle" TargetType="Border" BasedOn="{StaticResource OfficeAppSelectionSurfaceStyle}">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="112" />
        <Setter Property="controls:InstalledSelection.Kind" Value="Icons" />
        <Setter Property="controls:InstalledSelection.Surface" Value="Transparent" />
        <Setter Property="controls:InstalledSelection.Stroke" Value="Transparent" />
    </Style>
</ResourceDictionary>
