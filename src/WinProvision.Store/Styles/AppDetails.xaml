<Style x:Key="AppDetailsBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StoreFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource DetailsBodySize}" />
    </Style>
    
<Style x:Key="AppDetailsCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource AppDetailsBodyStyle}">
        <Setter Property="FontSize" Value="12" />
    </Style>
    
<Style x:Key="AppDetailsBodyStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource AppDetailsBodyStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    
<Style x:Key="AppDetailsTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppDetailsBodyStrongStyle}">
        <Setter Property="FontSize" Value="28" />
    </Style>
    
<Style x:Key="AppDetailsCodeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppDetailsCaptionStyle}">
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Segoe UI" />
    </Style>
    
<Style x:Key="AppDetailsActionButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource DetailsBodySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    
<Style x:Key="AppDetailsCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="FontSize" Value="{StaticResource DetailsBodySize}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    
<Style x:Key="AppDetailsCodeBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    
<Style x:Key="AppDetailsIconStyle" TargetType="ic:FluentIcon">
        <Setter Property="FontSize" Value="20" />
    </Style>
    
<Style x:Key="AppDetailsSmallIconStyle" TargetType="ic:FluentIcon" BasedOn="{StaticResource AppDetailsIconStyle}">
        <Setter Property="FontSize" Value="16" />
    </Style>
    
<Style x:Key="AppDetailsFallbackIconStyle" TargetType="ic:FluentIcon" BasedOn="{StaticResource AppDetailsIconStyle}">
        <Setter Property="FontSize" Value="36" />
    </Style>

    
<Style x:Key="AppDetailsRowLabelStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource DetailsBodySize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    
<Style x:Key="AppDetailsRowValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DetailsBodySize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    
<Style x:Key="AppDetailsInlineLinkStyle" TargetType="HyperlinkButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource DetailsBodySize}" />
        <Setter Property="Foreground" Value="{ThemeResource DetailsLinkBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>


    
<Style x:Key="AppDetailsOverlayStyle" TargetType="UserControl">
        <Setter Property="FontFamily" Value="{StaticResource StoreFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource DetailsBodySize}" />
    </Style>
        
<Style x:Key="AppDetailsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppDetailsActionButtonStyle}">
 <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/><Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="PrimarySurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal"/>
            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="PrimarySurface.Background" Value="{ThemeResource AccentFillColorSecondaryBrush}"/></VisualState.Setters></VisualState>
            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="PrimarySurface.Background" Value="{ThemeResource AccentFillColorTertiaryBrush}"/></VisualState.Setters></VisualState>
            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="PrimarySurface.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"/>
    </Border>
 </ControlTemplate></Setter.Value></Setter>
</Style>
</ResourceDictionary>
