                            <Grid>
                                <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center" />
                                <FontIcon Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" HorizontalAlignment="Right" />
                            </Grid>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding Content}" Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolVisibility}}" />
