                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ModeSurface.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="ModeSurface.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Setter Target="ModeSurface.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Setter Target="ModeIcon.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
