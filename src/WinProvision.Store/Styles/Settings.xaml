<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:settings="using:CommunityToolkit.WinUI.Controls">
  <Thickness x:Key="DeveloperSettingsGroupPadding">8</Thickness>
  <Thickness x:Key="DeveloperSettingsGroupMargin">0,0,0,12</Thickness>
  <Thickness x:Key="DeveloperSettingsRowMargin">0</Thickness>
  <Thickness x:Key="DeveloperSettingsSeparatorMargin">12,0</Thickness>
  <CornerRadius x:Key="DeveloperSettingsGroupCornerRadius">12</CornerRadius>
  <GridLength x:Key="LanInstallerVersionColumnWidth">96</GridLength>
  <GridLength x:Key="LanInstallerTypeColumnWidth">72</GridLength>
  <GridLength x:Key="LanInstallerHashColumnWidth">72</GridLength>
  <GridLength x:Key="LanInstallerSignatureColumnWidth">136</GridLength>
  <GridLength x:Key="LanInstallerStatusColumnWidth">144</GridLength>
  <x:Double x:Key="SettingsInlineControlMinimumHeight">36</x:Double>
  <Thickness x:Key="SettingsInlineTextBoxPadding">10,4</Thickness>
  <Thickness x:Key="SettingsInlineButtonPadding">12,4</Thickness>

  <Style x:Key="SettingsInlineTextBoxStyle" TargetType="TextBox">
    <Setter Property="MinHeight" Value="{StaticResource SettingsInlineControlMinimumHeight}" />
    <Setter Property="Padding" Value="{StaticResource SettingsInlineTextBoxPadding}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SettingsInlineComboBoxStyle" TargetType="ComboBox">
    <Setter Property="MinHeight" Value="{StaticResource SettingsInlineControlMinimumHeight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SettingsInlineButtonStyle" TargetType="Button" BasedOn="{StaticResource StoreActionButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource SettingsInlineControlMinimumHeight}" />
    <Setter Property="Padding" Value="{StaticResource SettingsInlineButtonPadding}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="DeveloperSettingsSectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="Margin" Value="4,12,4,8" />
  </Style>

  <Style x:Key="DeveloperSettingsGroupStyle" TargetType="Border">
    <Setter Property="Padding" Value="{StaticResource DeveloperSettingsGroupPadding}" />
    <Setter Property="Margin" Value="{StaticResource DeveloperSettingsGroupMargin}" />
    <Setter Property="CornerRadius" Value="{StaticResource DeveloperSettingsGroupCornerRadius}" />
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="DeveloperSettingsCardStyle" TargetType="settings:SettingsCard">
    <Setter Property="Margin" Value="{StaticResource DeveloperSettingsRowMargin}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="DeveloperSettingsExpanderStyle" TargetType="settings:SettingsExpander">
    <Setter Property="Margin" Value="{StaticResource DeveloperSettingsRowMargin}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="DeveloperSettingsActionButtonStyle" TargetType="Button" BasedOn="{StaticResource StoreActionButtonStyle}">
    <Setter Property="MinWidth" Value="92" />
    <Setter Property="MinHeight" Value="{StaticResource SettingsInlineControlMinimumHeight}" />
    <Setter Property="Padding" Value="{StaticResource SettingsInlineButtonPadding}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SettingsNavigationCardButtonStyle" TargetType="Button" BasedOn="{StaticResource StoreActionButtonStyle}">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style x:Key="DeveloperSettingsDescriptionStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="DeveloperSettingsWarningStyle" TargetType="TextBlock" BasedOn="{StaticResource DeveloperSettingsDescriptionStyle}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
  </Style>

  <Style x:Key="LanInstallerMetadataStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="LanInstallerRowBorderStyle" TargetType="Border">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</ResourceDictionary>
